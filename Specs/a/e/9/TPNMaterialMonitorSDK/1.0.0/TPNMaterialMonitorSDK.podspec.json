{
  "name": "TPNMaterialMonitorSDK",
  "version": "1.0.0",
  "summary": "TPN Material Monitor SDK for ad creative frame capture and upload",
  "description": "MaterialMonitorSDK captures ad container frames, computes perceptual hashes,\nand uploads creative metadata to the TopOn material monitor service.",
  "homepage": "https://github.com/toponad/topon_ios_sdk",
  "authors": {
    "TopOn": "ios@toponad.com"
  },
  "license": {
    "type": "MIT"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "static_framework": true,
  "requires_arc": true,
  "module_name": "MaterialMonitorSDK",
  "source": {
    "http": "https://topon-sdk-release.oss-accelerate.aliyuncs.com/Material_monitor/topon/1.0.0/MaterialMonitorSDK-1.0.0.zip",
    "type": "zip"
  },
  "vendored_frameworks": "MaterialMonitorSDK-1.0.0/MaterialMonitorSDK.xcframework",
  "frameworks": [
    "UIKit",
    "Foundation",
    "AVFoundation",
    "WebKit",
    "Network",
    "CoreTelephony"
  ],
  "libraries": "c++",

{
  "name": "MaxMentaAdapter",
  "version": "1.0.34",
  "summary": "Menta Global custom adapter for the AppLovin MAX SDK.",
  "description": "Supports banner/MREC, interstitial, rewarded, app open, native express, and native self-render ads.",
  "homepage": "https://www.advlion.com",
  "license": {
    "type": "Custom",
    "text": "Copyright Menta. All rights reserved."
  },
  "authors": {
    "Menta": "mentasdk.vip@gmail.com"
  },
  "platforms": {
    "ios": "11.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "source": {
    "git": "https://github.com/mentasdk/AppLovin-MAX-SDK-iOS.git",
    "tag": "1.0.34"
  },
  "source_files": "{MaxMentaAdapter,Menta/MaxMentaAdapter}/**/*.{h,m}",
  "public_header_files": "{MaxMentaAdapter,Menta/MaxMentaAdapter}/*.h",
  "dependencies": {
    "AppLovinSDK": [
      ">= 13.0.0"
    ],
    "MentaBaseGlobal": [
      "1.0.34"

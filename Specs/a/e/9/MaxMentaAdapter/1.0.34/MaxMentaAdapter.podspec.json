    "MentaMediationGlobal": [
      "1.0.34"
    ],
    "MentaVlionGlobal": [
      "1.0.34"
    ],
    "MentaVlionGlobalAdapter": [
      "1.0.34"
    ]
  },
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  }
}

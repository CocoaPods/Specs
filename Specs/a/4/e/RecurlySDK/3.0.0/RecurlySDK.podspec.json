{
  "name": "RecurlySDK",
  "version": "3.0.0",
  "summary": "Integrate recurrent payments in your iOS app in a matter of minutes.",
  "homepage": "https://github.com/recurly/recurly-client-ios",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Recurly, Inc.": "support@recurly.com"
  },
  "platforms": {
    "ios": "14.0"
  },
  "swift_versions": [
    "5.7"
  ],
  "source": {
    "git": "https://github.com/recurly/recurly-client-ios.git",
    "tag": "v3.0.0"
  },
  "source_files": "RecurlySDK-iOS/**/*.{h,m,swift}",
  "resources": "RecurlySDK-iOS/Resources/**/*.{ttf,xcassets}",
  "resource_bundles": {
    "RecurlySDK_Privacy": [
      "RecurlySDK-iOS/PrivacyInfo.xcprivacy"
    ]
  },
  "frameworks": [
    "UIKit",
    "Foundation",
    "Security",
    "CoreGraphics",
    "QuartzCore",
    "PassKit"
  ],
  "requires_arc": true,
  "xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "pod_target_xcconfig": {
    "SWIFT_STRICT_CONCURRENCY": "targeted"
  },
  "swift_version": "5.7"
}

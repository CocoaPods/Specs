  "summary": "[DEPRECATED] Use Swift Package Manager (https://github.com/google-ai-edge/mediapipe). MediaPipe Task Library - Common",
  "description": "DEPRECATED: MediaPipe Tasks CocoaPods are deprecated. Please migrate to Swift Package Manager via https://github.com/google-ai-edge/mediapipe. The common libraries of the MediaPipe Task Library. See the privacy notice at https://goo.gle/mediapipe-privacy.",
  "deprecated": true,
  "deprecated_in_favor_of": "Swift Package Manager via https://github.com/google-ai-edge/mediapipe",
  "platforms": {
    "ios": "15.0"
  },
  "module_name": "MediaPipeTasksCommon",
  "static_framework": true,
  "user_target_xcconfig": {
    "OTHER_LDFLAGS[sdk=iphonesimulator*]": "$(inherited) -force_load \"${PODS_ROOT}/MediaPipeTasksCommon/frameworks/graph_libraries/libMediaPipeTasksCommon_simulator_graph.a\"",
    "OTHER_LDFLAGS[sdk=iphoneos*]": "$(inherited) -force_load \"$(PODS_ROOT)/MediaPipeTasksCommon/frameworks/graph_libraries/libMediaPipeTasksCommon_device_graph.a\""
  },
  "frameworks": [
    "AudioToolbox",
    "Accelerate",
    "CoreMedia",
    "AssetsLibrary",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "QuartzCore",
    "AVFoundation",
    "CoreVideo"
  ],
  "preserve_paths": "frameworks/graph_libraries/*.a",
  "libraries": "c++",
  "vendored_frameworks": "frameworks/MediaPipeTasksCommon.xcframework"

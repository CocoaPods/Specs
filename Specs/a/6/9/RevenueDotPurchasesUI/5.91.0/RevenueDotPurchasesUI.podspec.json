{
  "name": "RevenueDotPurchasesUI",
  "module_name": "RevenueCatUI",
  "version": "5.91.0",
  "summary": "UI library for RevenueCat paywalls. RevenueDot fork of RevenueCat's MIT SDK.",
  "description": "Save yourself the hassle of implementing a subscriptions backend. This is RevenueDot's drop-in fork of RevenueCat's MIT SDK; it talks to RevenueDot, the open-source subscription server (https://revenuedot.app). Not affiliated with RevenueCat.",
  "homepage": "https://revenuedot.app",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "RevenueDot": "https://github.com/revenuedot",
    "RevenueCat, Inc. (original MIT SDK)": "https://github.com/RevenueCat"
  },
  "source": {
    "git": "https://github.com/revenuedot/purchases-ios.git",
    "tag": "5.91.0-revenuedot"
  },
  "documentation_url": "https://revenuedot.app/docs",
  "frameworks": "SwiftUI",
  "swift_versions": "5.8",
  "platforms": {
    "ios": "13.0",
    "watchos": "6.2",
    "tvos": "13.0",
    "osx": "10.15",
    "visionos": "1.0"
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "source_files": "RevenueCatUI/**/*.swift",
  "dependencies": {
    "RevenueDotPurchases": [
      "5.91.0"
    ]
  },
  "resource_bundles": {
    "RevenueCat_RevenueCatUI": [
      "RevenueCatUI/Resources/*.lproj/*.strings",
      "RevenueCatUI/Resources/icons.xcassets",
      "RevenueCatUI/Resources/Media.xcassets"
    ]
  },
  "swift_version": "5.8"
}

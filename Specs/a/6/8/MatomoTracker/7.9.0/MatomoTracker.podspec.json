{
  "name": "MatomoTracker",
  "version": "7.9.0",
  "summary": "A Matomo Tracker written in Swift for iOS, tvOS, macOS and visionOS apps.",
  "homepage": "https://github.com/matomo-org/matomo-sdk-ios/",
  "license": {
    "type": "MIT",
    "file": "LICENSE.md"
  },
  "authors": {
    "Mattias Levin": "mattias.levin@gmail.com",
    "Cornelius Horstmann": "site-github@brototyp.de"
  },
  "source": {
    "git": "https://github.com/matomo-org/matomo-sdk-ios.git",
    "tag": "v7.9.0"
  },
  "platforms": {
    "ios": "15.0",
    "tvos": "15.0",
    "osx": "12.0",
    "visionos": "1.0"
  },
  "requires_arc": true,
  "default_subspecs": "Core",
  "swift_versions": "5.0",
  "ios": {
    "frameworks": "UIKit"
  },
  "tvos": {
    "frameworks": "UIKit"
  },
  "visionos": {
    "frameworks": "UIKit"
  },
  "resource_bundles": {
    "MatomoTracker_Privacy": [
      "MatomoTracker/PrivacyInfo.xcprivacy"
    ]
  },
  "subspecs": [
    {
      "name": "Core",
      "source_files": "MatomoTracker/*.swift"
    }
  ],
  "swift_version": "5.0"
}

{
  "name": "HXGMAdapter",
  "version": "1.0.1",
  "summary": "HXSDK 适配器, 用于在Gromore聚合SDK请求广告",
  "homepage": "https://gitee.com/octmon/hxgm-adapter-ios.git",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "OctMon": "octmon@qq.com"
  },
  "source": {
    "git": "https://gitee.com/octmon/hxgm-adapter-ios.git",
    "tag": "1.0.1"
  },
  "platforms": {
    "ios": "11.0"
  },
  "static_framework": true,
  "ios": {
    "source_files": "HXGMAdapter/Classes/**/*.{h,m}",
    "public_header_files": "HXGMAdapter/Classes/**/*.h"
  },
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "OTHER_LINK_FLAG": "$(inherited) -ObjC"
  },
  "dependencies": {
    "Ads-CN": [
      "~>7.5.0.7"
    ],
    "HXSDK": [
      "~> 5.2.2"
    ]
  }
}

{
  "name": "ios-device-lib",
  "version": "3.3.2",
  "summary": "Secure Tokenized Payments by Global Payments Systems.",
  "description": "Secure Tokenized Payments for iOS by Global Payments Systems.",
  "homepage": "https://github.com/globalpayments/ios-device-lib",
  "license": "EULA",
  "authors": {
    "Heartland Developer Portal": "EntApp_DevPortal@e-hps.com"
  },
  "source": {
    "git": "https://github.com/globalpayments/ios-device-lib.git",
    "tag": "3.3.2"
  },
  "platforms": {
    "ios": "12.0"
  },
  "requires_arc": true,
  "source_files": [
    "ios-device-lib/Classes/**/*.{h,m,mm,swift}",
    "ios-device-lib/ThirdParty/**/*.{h,m,mm,swift}",
    "ios-device-lib/Libraries/*.h"
  ],
  "resource_bundles": {
    "ios-device-lib": [
      "ios-device-lib/Assets/*.png",
      "ios-device-lib/Assets/*.xib",
      "ios-device-lib/Assets/Assets.xcassets",
      "ios-device-lib/Classes/**/*.xcassets"
    ]
  },
  "frameworks": [
    "UIKit",
    "SystemConfiguration"
  ],
  "vendored_frameworks": [
    "ios-device-lib/Libraries/GlobalPaymentsApi.xcframework",
    "ios-device-lib/Libraries/BBPOS.xcframework",
    "ios-device-lib/Libraries/BBDeviceOTA-1.6.8.xcframework",
    "ios-device-lib/Libraries/TemLibrary.xcframework",
    "ios-device-lib/Libraries/LandiSDK_MFI.xcframework",
    "ios-device-lib/Libraries/RUA_MFI.xcframework"
  ],
  "swift_versions": "5.0",
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "swift_version": "5.0"
}

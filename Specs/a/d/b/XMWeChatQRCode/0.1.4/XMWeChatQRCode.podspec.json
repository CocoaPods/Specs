{
  "name": "XMWeChatQRCode",
  "version": "0.1.4",
  "summary": "OpenCV WeChat QR-code decoder for iOS.",
  "description": "A UIImage-based iOS wrapper around the OpenCV WeChat QR-code module. The pod\nincludes the required WeChat QR-code models and does not include photo-picker UI.",
  "homepage": "https://github.com/devcxm/opencv-wechat-qrcode-mobile",
  "license": {
    "type": "Apache-2.0"
  },
  "authors": {
    "XM": "https://github.com/devcxm"
  },
  "source": {
    "http": "https://github.com/devcxm/opencv-wechat-qrcode-mobile/releases/download/0.1.4/XMWeChatQRCode-0.1.4.zip"
  },
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": "5.0",
  "source_files": "ios/XMWeChatQRCode/Sources/**/*.{h,m,mm,swift}",
  "public_header_files": "ios/XMWeChatQRCode/Sources/ObjC/XMWeChatQRCodeBridge.h",
  "vendored_frameworks": "ios/XMWeChatQRCode/Frameworks/OpenCV.xcframework",
  "resource_bundles": {
    "XMWeChatQRCodeResources": "ios/XMWeChatQRCode/Resources/WeChatQRCodeModels/*"
  },
  "frameworks": [
    "UIKit",
    "CoreGraphics"
  ],
  "libraries": [
    "c++",
    "iconv"
  ],
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "NO",
    "DEFINES_MODULE": "YES"
  },
  "swift_version": "5.0"
}

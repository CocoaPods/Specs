{
  "name": "OpenKuiklyA2UIIOSRender",
  "version": "1.0.0",
  "summary": "A2UI iOS Render Module",
  "description": "A2UI iOS platform render implementation.\nBridges A2UI message stream to Kuikly's native render pipeline\nusing KuiklyRenderLayerHandler with proper threading model.",
  "homepage": "https://github.com/Tencent-TDS/KuiklyUI-A2UI",
  "license": {
    "type": "KuiklyUI",
    "file": "LICENSE"
  },
  "authors": "Kuikly Team",
  "platforms": {
    "ios": "12.0"
  },
  "source": {
    "git": "https://github.com/Tencent-TDS/KuiklyUI-A2UI.git",
    "tag": "1.0.0"
  },
  "user_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "requires_arc": true,
  "source_files": "a2ui-render-ios/Sources/**/*.{h,m,mm,swift}",
  "public_header_files": "a2ui-render-ios/Sources/**/*.h",
  "dependencies": {
    "OpenKuiklyIOSRender": [
      "2.30.0"
    ]
  },
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "ios": {
    "frameworks": [
      "UIKit",
      "QuartzCore",
      "CoreGraphics",
      "Foundation"
    ]
  },
  "swift_versions": [
    "5.0"
  ],
  "swift_version": "5.0"
}

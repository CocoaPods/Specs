{
  "name": "PBWire",
  "version": "0.1.15",
  "summary": "Dynamic protobuf over the pbwire C ABI, schema at runtime",
  "description": "A FileDescriptorSet becomes the schema at runtime; messages go to/from wire bytes with no generated code, through an ARC wrapper over the pbwire C core.",
  "homepage": "https://github.com/jinganix/pbwire",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": {
    "jinganix": "jinganix@gmail.com"
  },
  "source": {
    "git": "https://github.com/jinganix/pbwire.git",
    "tag": "v0.1.15"
  },
  "platforms": {
    "osx": "12.0",
    "ios": "15.0"
  },
  "requires_arc": true,
  "source_files": [
    "bindings/objc/*.{h,m}",
    "src/*.{c,h}",
    "include/pbwire.h"
  ],
  "public_header_files": [
    "bindings/objc/*.h",
    "include/pbwire.h"
  ],
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/include"
  }
}

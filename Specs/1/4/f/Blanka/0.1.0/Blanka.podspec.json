{
  "name": "Blanka",
  "version": "0.1.0",
  "summary": "A commercial-grade empty-state kit for iOS lists with Lottie support.",
  "description": "Blanka renders empty states (no data, no network, error, loading, no search\nresult, no permission) for UIKit lists and pages. Manual mount or DZN-style\nauto-attach, a global theme, and pluggable animations. Lottie is opt-in.",
  "homepage": "https://github.com/LUCK-YXH/Empty",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "LUCK-YXH": "yuxuhui@heyhru.com"
  },
  "source": {
    "git": "https://github.com/LUCK-YXH/Empty.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/Core/**/*.swift",
      "frameworks": "UIKit"
    },
    {
      "name": "Lottie",
      "source_files": "Sources/Lottie/**/*.swift",
      "dependencies": {
        "Blanka/Core": [

        ],
        "lottie-ios": [
          "~> 4.4"
        ]
      }
    }
  ],
  "swift_version": "5.0"
}

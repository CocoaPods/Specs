{
  "name": "CZPicker",
  "version": "1.0.0",
  "summary": "Beautiful selection sheets for SwiftUI and UIKit. Zero dependencies.",
  "homepage": "https://github.com/chenzeyu/CZPicker",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "chenzeyu": "zeyufly@gmail.com"
  },
  "source": {
    "git": "https://github.com/chenzeyu/CZPicker.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "requires_arc": true,
  "swift_versions": [
    "5.0"
  ],
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Pod/Classes/*.{h,m}",
      "public_header_files": "Pod/Classes/*.h",
      "frameworks": "UIKit"
    },
    {
      "name": "SwiftUI",
      "platforms": {
        "ios": "16.0"
      },
      "source_files": "Sources/CZPickerUI/*.swift",
      "frameworks": [
        "SwiftUI",
        "UIKit"
      ]
    }
  ],
  "swift_version": "5.0"
}

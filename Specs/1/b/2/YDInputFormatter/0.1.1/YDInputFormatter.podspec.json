{
  "name": "YDInputFormatter",
  "version": "0.1.1",
  "summary": "UITextField input formatter with grouping and caret restoration.",
  "description": "YDInputFormatter is an Objective-C input formatting component for UITextField.\nIt supports grouped formatting, custom separators, max length limiting,\ncaret restoration, paste handling, and marked text compatibility.",
  "homepage": "https://github.com/youshiyuandian/YDInputFormatter",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Lizuxi": "ios_lizuxi@163.com"
  },
  "source": {
    "git": "https://github.com/youshiyuandian/YDInputFormatter.git",
    "tag": "0.1.1"
  },
  "platforms": {
    "ios": "13.0"
  },
  "requires_arc": true,
  "frameworks": "UIKit",
  "module_name": "YDInputFormatter",
  "header_mappings_dir": "YDInputFormatter/Formatter",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "source_files": "YDInputFormatter/Formatter/**/*.{h,m}",
  "public_header_files": [
    "YDInputFormatter/Formatter/Core/YDInputFormatter.h",
    "YDInputFormatter/Formatter/Core/YDInputFormatterConfig.h",
    "YDInputFormatter/Formatter/Core/YDInputFormatterResult.h",
    "YDInputFormatter/Formatter/UIKit/UITextField+YDInputFormatter.h"
  ],
  "private_header_files": "YDInputFormatter/Formatter/Core/YDInputFormatterEngine.h"
}

{
  "name": "AppsOnAir-AppPush",
  "version": "1.0.1-beta",
  "summary": "AppsOnAir Push Notifications SDK for iOS",
  "description": "Lightweight iOS push notification SDK using APNs directly. No Firebase dependency.\nIncludes a Notification Service Extension base class for rich media attachments\nand a Notification Content Extension base view controller for custom UI.",
  "homepage": "https://documentation.appsonair.com/MobileQuickstart/AppPushService/ios-sdk-setup",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "devtools-logicwind": "devtools@logicwind.com"
  },
  "source": {
    "git": "https://github.com/apps-on-air/appsonair-ios-push-notification.git",
    "tag": "1.0.1-beta"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Shared",
      "source_files": "Sources/AppsOnAirPushShared/**/*.swift",
      "frameworks": "Foundation"
    },
    {
      "name": "Core",
      "source_files": "Sources/AppsOnAirPush/**/*.swift",
      "frameworks": [
        "UIKit",
        "UserNotifications",
        "Security",
        "BackgroundTasks"
      ],
      "dependencies": {
        "AppsOnAir-Core": [
          ">= 1.2.3"
        ],
        "AppsOnAir-AppPush/Shared": [

        ]
      }
    },
    {
      "name": "ServiceExtension",
      "source_files": "Sources/AppsOnAirPushServiceExt/**/*.swift",
      "frameworks": [
        "Foundation",
        "UserNotifications"
      ],
      "dependencies": {
        "AppsOnAir-AppPush/Shared": [

        ]
      }
    },
    {
      "name": "ContentExtension",
      "source_files": "Sources/AppsOnAirPushContentExt/**/*.swift",
      "frameworks": [
        "UIKit",
        "UserNotifications",
        "UserNotificationsUI"
      ]
    }
  ],
  "swift_version": "5.9"
}

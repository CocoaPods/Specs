{
  "name": "Identified",
  "version": "0.1.1",
  "summary": "Native identity verification flow for the Identified API (iOS 16+).",
  "description": "Consent, name, ID details, ID front and back, three-pose selfie, review and status, with\nUIKit and SwiftUI entry points. Camera, Vision and Core Image capture are bundled.",
  "homepage": "https://identified.cc",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": "Identified",
  "source": {
    "git": "https://github.com/fening/identified-ios-sdk.git",
    "tag": "0.1.1"
  },
  "documentation_url": "https://github.com/fening/identified-ios-sdk#readme",
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": "6.0",
  "source_files": "Sources/Identified/**/*.swift",
  "resource_bundles": {
    "IdentifiedResources": [
      "Sources/Identified/Resources/*.png",
      "Sources/Identified/Resources/Fonts/*.{ttf,txt}",
      "Sources/Identified/Resources/*.lproj"
    ]
  },
  "frameworks": [
    "AVFoundation",
    "CoreImage",
    "CoreLocation",
    "CoreText",
    "ImageIO",
    "PhotosUI",
    "SwiftUI",
    "UIKit",
    "UniformTypeIdentifiers",
    "Vision"
  ],
  "dependencies": {
    "IdentifiedCore": [
      "0.1.1"
    ]
  },
  "pod_target_xcconfig": {
    "OTHER_SWIFT_FLAGS": "$(inherited) -package-name identified"
  },
  "swift_version": "6.0"
}

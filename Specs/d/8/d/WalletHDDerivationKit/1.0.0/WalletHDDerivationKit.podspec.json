{
  "name": "WalletHDDerivationKit",
  "version": "1.0.0",
  "summary": "Offline multi-chain HD wallet derivation for Swift.",
  "description": "Native BIP-32, BIP-44/49/84/86, SLIP-0010, SLIP-0132, extended-key,\nBitcoin, EVM, TRON, Solana, Litecoin, Dogecoin, Dash, DigiByte, BCH,\nand Zcash transparent address derivation. No runtime network calls.",
  "homepage": "https://devdasx.github.io/wallet-hd-derivation-kit/swift/",
  "source": {
    "git": "https://github.com/devdasx/wallet-hd-derivation-kit.git",
    "tag": "v1.0.0"
  },
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "ROYO STUDIOS": "royostudios13@gmail.com"
  },
  "social_media_url": "https://github.com/devdasx",
  "swift_versions": "6.0",
  "static_framework": true,
  "platforms": {
    "ios": "15.0",
    "osx": "12.0"
  },
  "source_files": "Sources/WalletHDDerivationKit/**/*.swift",
  "dependencies": {
    "CryptoSwift": [
      "1.10.0"
    ],
    "secp256k1Wrapper": [
      "0.0.5"
    ],
    "BIP39MnemonicKit": [
      "2.0.1"
    ]
  },
  "testspecs": [

{
  "name": "JAdbid",
  "version": "1.0.0",
  "summary": "基于TradPlus的iOS JAdbid标准聚合广告SDK",
  "homepage": "https://github.com/jiguangads/jadbid-ios-sdk",
  "authors": "Jiguang",
  "license": {
    "type": "Proprietary",
    "file": "NOTICE"
  },
  "source": {
    "git": "https://github.com/jiguangads/jadbid-ios-sdk.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "static_framework": true,
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "vendored_frameworks": "Artifacts/JAdbidCore.xcframework",
      "pod_target_xcconfig": {
        "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "x86_64"
      },
      "resources": "Resources/*.bundle",
      "preserve_paths": "Licenses/*",
      "frameworks": [
        "UIKit",
        "WebKit",
        "StoreKit",
        "CoreTelephony",
        "SystemConfiguration",
        "AVFoundation",
        "AdSupport",
        "CoreMotion",
        "CoreLocation",
        "Security",
        "CoreMedia",
        "SafariServices",
        "AudioToolbox",
        "MobileCoreServices",
        "AppTrackingTransparency",
        "JavaScriptCore",
        "CoreGraphics",
        "QuartzCore",
        "MediaPlayer",
        "AVKit",
        "Accelerate",
        "MessageUI",
        "CoreImage",
        "CoreVideo",
        "ImageIO",
        "VideoToolbox",
        "CFNetwork",
        "Network",
        "Metal",
        "MetalKit",
        "Photos"
      ],
      "libraries": [
        "c++",
        "z",
        "sqlite3",
        "xml2",
        "resolv"
      ],
      "user_target_xcconfig": {
        "OTHER_LDFLAGS": "$(inherited) -ObjC",
        "ARCHS[sdk=iphonesimulator*]": "arm64"
      }
    },
    {
      "name": "AdMob",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "Google-Mobile-Ads-SDK": [
          "= 13.7.0"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidAdMobAdapter.xcframework"
    },
    {
      "name": "Bigo",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "BigoADS": [
          "= 5.3.0"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidBigoAdapter.xcframework"
    },
    {
      "name": "Facebook",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "FBAudienceNetwork": [
          "= 6.22.0"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidFacebookAdapter.xcframework"
    },
    {
      "name": "Fyber",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "Fyber_Marketplace_SDK": [
          "= 8.4.7"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidFyberAdapter.xcframework"
    },
    {
      "name": "InMobi",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "InMobiSDK": [
          "= 11.4.1"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidInMobiAdapter.xcframework"
    },
    {
      "name": "IronSource",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "IronSourceSDK": [
          "= 9.5.0.0"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidIronSourceAdapter.xcframework"
    },
    {
      "name": "Mintegral",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "MintegralAdSDK": [
          "= 8.1.5"
        ],
        "MintegralAdSDK/All": [
          "= 8.1.5"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidMintegralAdapter.xcframework"
    },
    {
      "name": "Pangle",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "Ads-Global": [
          "= 8.2.0.9"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidPangleAdapter.xcframework"
    },
    {
      "name": "Unity",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "UnityAds": [
          "= 4.19.0"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidUnityAdapter.xcframework"
    },
    {
      "name": "Vungle",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "VungleAds": [
          "= 7.7.6"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidVungleAdapter.xcframework"
    },
    {
      "name": "Yandex",
      "dependencies": {
        "JAdbid/Core": [
          "1.0.0"
        ],
        "YandexMobileAds": [
          "= 8.3.0"
        ]
      },
      "vendored_frameworks": "Artifacts/JAdbidYandexAdapter.xcframework"
    }
  ]
}

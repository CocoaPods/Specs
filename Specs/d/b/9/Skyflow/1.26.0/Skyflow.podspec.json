{
  "name": "Skyflow",
  "version": "1.26.0",
  "summary": "skyflow-iOS",
  "description": "Skyflow iOS SDK",
  "homepage": "https://github.com/skyflowapi/skyflow-iOS.git",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Skyflow": "service-ops@skyflow.com"
  },
  "swift_versions": "5.9",
  "platforms": {
    "ios": "13.0"
  },
  "source": {

{
  "name": "SirdataCMP",
  "version": "2.0.0",
  "summary": "SirData CMP consent management SDK for iOS",
  "description": "SirData CMP is a consent management platform SDK that provides IAB TCF v2,\nGPP, and CCPA/USP compliance for iOS applications. Built with Kotlin\nMultiplatform and native Swift UI components.",
  "homepage": "https://github.com/SirDataFR/sirdata-cmp-ios-spm",
  "license": {
    "type": "Sirdata CMP Mobile SDK Proprietary Licence v1.1",
    "file": "LICENSE"
  },
  "authors": {
    "SirData": "dev@sirdata.com"
  },
  "source": {
    "http": "https://github.com/SirDataFR/sirdata-cmp-ios-spm/releases/download/2.0.0/SirDataCMP-2.0.0-cocoapods.zip"
  },
  "swift_versions": [
    "5.9"
  ],
  "platforms": {
    "ios": "15.0"
  },
  "vendored_frameworks": "SirDataCMP.xcframework",
  "module_name": "SirDataCMPUI",
  "source_files": "Sources/SirDataCMPUI/**/*.swift",
  "preserve_paths": [
    "NOTICE-ios",
    "THIRD-PARTY-LICENSES/**/*"
  ],
  "requires_arc": true,
  "pod_target_xcconfig": {
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "swift_version": "5.9"
}

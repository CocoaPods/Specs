{
  "name": "CQDemoKit-Swift",
  "version": "0.0.3",
  "summary": "CQDemoKit Swift 版 - 为CQDemoKit补充使用swift语言实现的其他功能(不包含纯OC的 CQDemoKit，其会导致此库推送失败)",
  "homepage": "https://github.com/dvlproad/001-UIKit-CQDemo-iOS",
  "description": "CQDemoKit Swift 版，可按需独立引入：\n• CQDemoKit-Swift/as：SwiftUI 与 UIKit 互转\n• CQDemoKit-Swift/BaseVC：BaseVC\n\n每个子库可独立引入，详见各子库描述。",
  "license": "MIT",
  "authors": {
    "dvlproad": ""
  },
  "platforms": {
    "ios": "9.0"
  },
  "source": {
    "git": "https://github.com/dvlproad/001-UIKit-CQDemo-iOS.git",
    "tag": "CQDemoKit-Swift_0.0.3_1"
  },
  "swift_versions": "5.0",
  "frameworks": "UIKit",
  "requires_arc": true,
  "subspecs": [
    {
      "name": "as",
      "source_files": "CQDemoKit-Swift/as/**/*.{swift}"
    },
    {
      "name": "BaseVC",
      "source_files": "CQDemoKit-Swift/BaseVC_Struct/**/*.{swift}"
    }
  ],
  "swift_version": "5.0"
}

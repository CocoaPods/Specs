{
  "name": "Deeplinkly",
  "module_name": "Deeplinkly",
  "version": "1.2.0",
  "summary": "Deep linking, deferred deep linking, and attribution for iOS.",
  "description": "Deeplinkly resolves deep links, restores deferred destinations, records\nfirst-touch attribution, and reports privacy-tiered device context on iOS.",
  "homepage": "https://deeplinkly.com",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Deeplinkly": "hello@deeplinkly.com"
  },
  "source": {
    "git": "https://github.com/Deeplinkly/ios_deeplinkly.git",
    "tag": "1.2.0"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.0",
  "source_files": "Sources/Deeplinkly/**/*.swift",
  "weak_frameworks": [
    "AdSupport",
    "AppTrackingTransparency"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "resource_bundles": {
    "DeeplinklyPrivacy": [
      "Sources/Deeplinkly/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "swift_version": "5.0"
}

{
  "name": "IJKPlayerKit",
  "version": "1.0.8",
  "summary": "基于IJKPlayer编译封装的直播播放器(也可作为视屏播放器)",
  "description": "基于IJKPlayer编译封装的直播播放器(也可作为视屏播放器)，支持 file、http、https、udp、rtmp、rtmps、rtp、rtsp、bluray、smb、ftp 等协议，支持播放图片，支持设置视频背景颜色（默认黑色），支持录制视频，iOS保存到相册可播放，支持设置视频显示比例等\n\n集成注意事项：\n使用cocoapods官方源\nsource 'https://github.com/CocoaPods/Specs.git'\npod 'IJKPlayerKit'",
  "authors": {
    "官人": "aiguanren@icloud.com"
  },
  "homepage": "https://github.com/aiguanren/WYBasisKit-swift",
  "license": {
    "type": "MIT",
    "file": "IJKPlayerKit/License.md"
  },
  "resource_bundles": {
    "IJKPlayerKit": [
      "IJKPlayerKit/PrivacyInfo.xcprivacy"
    ]
  },
  "platforms": {
    "ios": "13.0",
    "tvos": "12.0",
    "osx": "10.14"
  },
  "source": {
    "http": "https://github.com/aiguanren/IJKPlayerKit/releases/download/1.0.8/IJKPlayerKit.zip"
  },
  "swift_versions": [
    "5"
  ],
  "requires_arc": true,
  "vendored_frameworks": "IJKPlayerKit/IJKPlayerKit.xcframework",
  "libraries": [
    "c++",
    "z",
    "bz2",
    "iconv",
    "xml2",
    "lzma"
  ],
  "frameworks": [
    "AVFoundation",
    "AudioToolbox",
    "CoreMedia",
    "CoreVideo",
    "VideoToolbox",
    "Metal"
  ],
  "ios": {
    "frameworks": [
      "UIKit",
      "OpenGLES"
    ]
  },
  "tvos": {
    "frameworks": [
      "UIKit",
      "OpenGLES"
    ]
  },
  "osx": {
    "frameworks": [
      "Cocoa",
      "AudioUnit",
      "OpenGL",
      "GLKit",
      "CoreImage"
    ]
  },
  "swift_version": "5"
}

{
  "name": "SCMediaCompressor",
  "version": "1.0.0",
  "summary": "Configurable image, video and Live Photo compression for iOS.",
  "description": "One Objective-C core for image fidelity, H264/HEVC SDR video with size protection, and Live Photo pairing. Swift callable, configurable pixel bounds, asynchronous progress and cancellation.",
  "homepage": "https://github.com/mortal-shaco/SCMediaCompressor",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Shaco": "https://github.com/mortal-shaco"
  },
  "source": {
    "git": "https://github.com/mortal-shaco/SCMediaCompressor.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "requires_arc": true,
  "source_files": "Sources/SCMediaCompressor/*.{h,m}",
  "private_header_files": [
    "Sources/SCMediaCompressor/SCInternal.h",
    "Sources/SCMediaCompressor/SCLogger.h",
    "Sources/SCMediaCompressor/SCImageHDR.h",
    "Sources/SCMediaCompressor/SCSizePolicy.h"
  ],
  "frameworks": [
    "Foundation",
    "UIKit",
    "AVFoundation",
    "CoreMedia",
    "CoreVideo",
    "CoreGraphics",
    "CoreImage",
    "ImageIO",
    "UniformTypeIdentifiers"
  ],
  "module_name": "SCMediaCompressor",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "GCC_OPTIMIZATION_LEVEL": "2",
    "CLANG_ENABLE_MODULES": "YES"
  },
  "preserve_paths": [
    "THIRD_PARTY_NOTICES.md",
    "Examples/**/*",
    "README.md",
    "README.en.md"
  ]
}

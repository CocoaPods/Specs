{
  "name": "NottiSDK",
  "version": "0.1.0",
  "summary": "Native iOS SDK for Zeep Notti push notifications.",
  "description": "Device registration, user identity, tags and engagement events (received, opened,\nclicked) for Zeep Notti. Rich media in a Notification Service Extension is the\nseparate pod NottiSDKExtension.",
  "homepage": "https://github.com/zeeplabs/zeep-notti-ios-sdk",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Zeep Tecnologia": "opensource@zeeplabs.com.br"
  },
  "source": {
    "git": "https://github.com/zeeplabs/zeep-notti-ios-sdk.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5"
  ],
  "cocoapods_version": ">= 1.12",
  "pod_target_xcconfig": {
    "OTHER_SWIFT_FLAGS": "$(inherited) -package-name NottiSDK"
  },
  "source_files": [
    "Sources/NottiShared/**/*.swift",
    "Sources/NottiSDK/**/*.swift",
    "Sources/NottiSDKBootstrap/**/*.{h,m}"
  ],
  "public_header_files": "Sources/NottiSDKBootstrap/include/*.h",
  "resource_bundles": {
    "NottiSDK_Privacy": [
      "Sources/NottiSDK/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "swift_version": "5"
}

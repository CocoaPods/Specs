{
  "name": "ArtemisUISDK",
  "version": "1.0.4",
  "summary": "Native iOS UI SDK for Artemis agent chat",
  "description": "Artemis UI SDK provides a native SwiftUI chat experience with connection\nstatus, streaming messages, typing feedback, Markdown, and rich content.\nTransport is supplied by ArtemisSocketSDK.",
  "homepage": "https://github.com/Koredotcom/artemis-ios-sdk",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Pagidimarri Kartheek": "Kartheek.Pagidimarri@kore.com"
  },
  "source": {
    "git": "https://github.com/Koredotcom/artemis-ios-sdk.git",
    "tag": "1.0.4"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "module_name": "ArtemisUISDK",
  "source_files": [
    "Sources/ArtemisUISDK/**/*.swift",
    "Sources/ArtemisSocketSDK/**/*.swift"
  ],
  "resource_bundles": {
    "ArtemisUISDK_Privacy": [
      "Sources/ArtemisSocketSDK/PrivacyInfo.xcprivacy"
    ]
  },
  "frameworks": [
    "Foundation",
    "SwiftUI",
    "Combine",
    "UIKit",
    "CryptoKit",
    "AVKit",
    "AVFoundation",
    "WebKit"
  ],
  "dependencies": {
    "Yams": [
      "~> 5.0"
    ]
  },
  "swift_version": "5.9"
}

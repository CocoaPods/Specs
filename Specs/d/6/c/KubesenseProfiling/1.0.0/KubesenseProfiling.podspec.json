{
  "name": "KubesenseProfiling",
  "version": "1.0.0",
  "summary": "Official Kubesense Profiling module of the Swift SDK.",
  "homepage": "https://www.kubesense.ai",
  "license": {
    "type": "Apache",
    "file": "LICENSE"
  },
  "authors": {
    "Kubesense": "info@kubesense.ai"
  },
  "swift_versions": "6.0",
  "platforms": {
    "ios": "15.0"
  },
  "source": {
    "git": "https://github.com/kubesense-ai/kubesense-ios-sdk.git",
    "tag": "1.0.0"
  },
  "source_files": [
    "KubesenseProfiling/Sources/**/*.swift",
    "KubesenseProfiling/Mach/**/*.{h,c,cpp}"
  ],
  "private_header_files": [
    "KubesenseProfiling/Mach/**/*.h"
  ],
  "preserve_paths": "KubesenseProfiling/Mach/include/module.modulemap",
  "dependencies": {
    "KubesenseInternal": [
      "1.0.0"
    ]
  },
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
    "SWIFT_INCLUDE_PATHS": "$(PODS_TARGET_SRCROOT)/KubesenseProfiling/Mach/include"
  },
  "swift_version": "6.0"
}

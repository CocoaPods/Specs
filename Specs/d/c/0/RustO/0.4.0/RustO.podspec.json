{
  "name": "RustO",
  "version": "0.4.0",
  "summary": "RustO! - Pure Rust OCR library for iOS",
  "description": "RustO! is a high-performance OCR (Optical Character Recognition) library\nwritten in pure Rust, powered by Indra OCR and PaddleOCR models with\npure-Rust MNN (rusto-nn) inference. This pod provides Swift bindings for iOS.",
  "homepage": "https://github.com/byrizki/rusto-rs",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "RustO Contributors": "support@rusto.dev"
  },
  "source": {
    "http": "https://github.com/byrizki/rusto-rs/releases/download/v0.4.0/RustO.xcframework.zip"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.0",
  "source_files": [
    "src/**/*.{swift,h}",
    "src/generated/**/*.{swift,h}"
  ],
  "public_header_files": "src/**/*.h",
  "vendored_frameworks": "RustO.xcframework",
  "frameworks": "Foundation",
  "pod_target_xcconfig": {
    "ENABLE_BITCODE": "NO"
  },
  "swift_version": "5.0"
}

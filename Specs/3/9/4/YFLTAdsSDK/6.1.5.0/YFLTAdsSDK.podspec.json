{
  "name": "YFLTAdsSDK",
  "version": "6.1.5.0",
  "summary": "亿帆轻量级 iOS 广告 SDK（XCFramework 二进制接入）",
  "description": "通过原版 YFAdsSDK.xcframework 提供开屏、插屏、顶推、融合 Banner 与激励视频广告。\nCocoaPods 安装名称为 YFLTAdsSDK，Framework、模块和公开 API 名称保持 YFAdsSDK。",
  "homepage": "https://github.com/com-yifan/ios-yf-sdk-lite",
  "authors": {
    "yifan": "576661787@qq.com"
  },
  "license": {
    "type": "GPL-2.0",
    "file": "LICENSE"
  },
  "source": {
    "git": "https://github.com/com-yifan/ios-yf-sdk-lite.git",
    "tag": "6.1.5.0"
  },
  "platforms": {
    "ios": "11.0"
  },
  "static_framework": true,
  "module_name": "YFAdsSDK",
  "vendored_frameworks": "release/YFAdsSDK/YFAdsSDK.xcframework",
  "frameworks": [
    "Foundation",
    "UIKit",
    "AdSupport",
    "AVFoundation",
    "AVKit",
    "AudioToolbox",
    "CoreGraphics",
    "CoreImage",
    "CoreMedia",
    "CoreLocation",
    "CoreMotion",
    "CoreTelephony",
    "QuartzCore",
    "Security",
    "StoreKit",
    "SystemConfiguration",
    "WebKit",
    "Accelerate",
    "MediaPlayer",
    "MobileCoreServices",
    "CoreData",
    "SafariServices",
    "QuickLook",
    "MessageUI"
  ],
  "weak_frameworks": "AppTrackingTransparency",
  "libraries": [
    "sqlite3",
    "z",
    "c++",
    "resolv"
  ]
}

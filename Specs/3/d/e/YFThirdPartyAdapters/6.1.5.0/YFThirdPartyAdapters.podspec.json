    },
    {
      "name": "JC",
      "vendored_frameworks": "JC/YFAdsJCAdapter.xcframework"
    },
    {
      "name": "KF",
      "vendored_frameworks": "KF/YFAdsKFAdapter.xcframework"
    },
    {
      "name": "KY",
      "vendored_frameworks": "KY/YFAdsKYAdapter.xcframework"
    },
    {
      "name": "NAL",
      "vendored_frameworks": "NAL/YFAdsNALAdapter.xcframework"
    },
    {
      "name": "NC",
      "vendored_frameworks": "NC/YFAdsNCAdapter.xcframework"
    },
    {
      "name": "UW",
      "vendored_frameworks": "UW/YFAdsUWAdapter.xcframework"
    },
    {
      "name": "XU",
      "vendored_frameworks": "XU/YFAdsXUAdapter.xcframework"

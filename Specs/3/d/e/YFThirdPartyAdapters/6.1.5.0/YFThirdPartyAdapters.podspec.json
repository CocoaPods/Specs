{
  "name": "YFThirdPartyAdapters",
  "version": "6.1.5.0",
  "summary": "YF third-party advertising network adapters",
  "description": "A collection of YF third-party advertising network adapters. Install the\nroot pod for all adapters, or select an individual adapter subspec.",
  "homepage": "https://github.com/com-yifan/ios-yf-otheradns-adapter",
  "license": {
    "type": "Proprietary",
    "text": "Proprietary"
  },
  "authors": {
    "Yifan": "dev@com-yifan.com"
  },
  "source": {
    "git": "https://github.com/com-yifan/ios-yf-otheradns-adapter.git",
    "tag": "6.1.5.0"
  },
  "platforms": {
    "ios": "11.0"
  },
  "static_framework": true,
  "default_subspecs": [
    "GE",
    "IE",
    "IN",
    "JC",
    "KF",
    "KY",
    "NAL",
    "NC",
    "UW",
    "XU",
    "ZD"
  ],

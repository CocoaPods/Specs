{
  "name": "TFYSwiftCalendarkit",
  "module_name": "TFYSwiftCalendarkit",
  "version": "2.0.0",
  "summary": "一个类型安全、纯 Swift 实现的 iOS 日历组件。",
  "description": "面向生产环境的月视图与周视图日历组件，支持自定义单元格、事件标记、范围选择、连续滚动、无障碍访问，以及 UIKit 和 SwiftUI。",
  "homepage": "https://github.com/13662049573/TFYSwiftCalendarkit",
  "documentation_url": "https://github.com/13662049573/TFYSwiftCalendarkit#readme",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Tianfeng You": "420144542@qq.com"
  },
  "source": {
    "git": "https://github.com/13662049573/TFYSwiftCalendarkit.git",
    "tag": "2.0.0"
  },
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": "6.0",
  "requires_arc": true,
  "source_files": "Sources/TFYSwiftCalendarkit/**/*.swift",
  "resource_bundles": {
    "TFYSwiftCalendarkit_Resources": [
      "Sources/TFYSwiftCalendarkit/PrivacyInfo.xcprivacy",
      "Sources/TFYSwiftCalendarkit/Resources/**/*"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit",
    "SwiftUI"
  ],
  "testspecs": [
    {
      "name": "Tests",
      "test_type": "unit",
      "source_files": "Tests/TFYSwiftCalendarkitTests/**/*.swift"
    }
  ],
  "swift_version": "6.0"
}

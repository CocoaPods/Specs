{
  "name": "TopOnzMaticooAdapter",
  "version": "2.2.0.2",
  "summary": "zMaticoo iOS SDK TopOn (AnyThinkiOS / TPNiOS) Adapter.",
  "description": "This is zMaticoo iOS SDK TopOn Adapter.\nSupports AnyThinkiOS and TPNiOS via mutually exclusive subspecs.\nLatest / Legacy code paths are also mutually exclusive (same adapter class names).",
  "homepage": "https://www.zmaticoo.com",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "15967863@qq.com": "lovely-kitty@live.cn"
  },
  "source": {
    "git": "https://github.com/zMaticoo/zMaticooiOSTopOnAdapter.git",
    "tag": "2.2.0.2"
  },
  "platforms": {
    "ios": "12.0"
  },
  "static_framework": true,
  "default_subspecs": "Latest",
  "subspecs": [
    {
      "name": "Latest",
      "source_files": "Classes/**/*.{h,m}",
      "dependencies": {
        "zMaticoo": [

        ],
        "AnyThinkiOS": [

        ]
      }
    },
    {
      "name": "Legacy",
      "source_files": "ClassesLegacy/**/*.{h,m}",
      "dependencies": {
        "zMaticoo": [

        ],
        "AnyThinkiOS": [
          "<= 6.4.92"
        ]
      }
    },
    {
      "name": "LatestTPN",
      "source_files": "Classes/**/*.{h,m}",
      "dependencies": {
        "zMaticoo": [

        ],
        "TPNiOS": [

        ]
      }
    },
    {
      "name": "LegacyTPN",
      "source_files": "ClassesLegacy/**/*.{h,m}",
      "dependencies": {
        "zMaticoo": [

        ],
        "TPNiOS": [
          "<= 6.4.92"
        ]
      }
    }
  ]
}

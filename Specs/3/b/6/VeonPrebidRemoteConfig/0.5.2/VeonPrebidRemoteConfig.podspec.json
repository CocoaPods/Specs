{
  "name": "VeonPrebidRemoteConfig",
  "version": "0.5.2",
  "summary": "Shared remote config plumbing for Veon Prebid iOS SDK feature modules.",
  "module_name": "VeonPrebidRemoteConfig",
  "description": "Adds a configURL parameter to Prebid.initializeSDK and stores the raw response for feature modules (ad mediation priority, future logging level, etc.) to decode independently, without those modules depending on each other.",
  "homepage": "https://www.veon.com",
  "license": {
    "type": "Apache License, Version 2.0"
  },
  "authors": {
    "Veon AdTech": "veonadtech.com"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "source": {
    "git": "https://github.com/veonadtech/prebid-ios-sdk.git",
    "tag": "0.5.2"
  },
  "xcconfig": {
    "LIBRARY_SEARCH_PATHS": "$(inherited)",
    "OTHER_CFLAGS": "$(inherited)",
    "OTHER_LDFLAGS": "$(inherited)",
    "HEADER_SEARCH_PATHS": "$(inherited)",
    "FRAMEWORK_SEARCH_PATHS": "$(inherited)"
  },
  "source_files": "EventHandlers/PrebidRemoteConfig/Sources/**/*.{h,m,swift}",
  "static_framework": true,
  "dependencies": {
    "VeonPrebidMobile": [
      ">= 0.5.0"
    ]
  },
  "pod_target_xcconfig": {
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES",
    "DEFINES_MODULE": "YES",
    "OTHER_SWIFT_FLAGS": "$(inherited) -no-verify-emitted-module-interface"
  },
  "swift_version": "5.0"
}

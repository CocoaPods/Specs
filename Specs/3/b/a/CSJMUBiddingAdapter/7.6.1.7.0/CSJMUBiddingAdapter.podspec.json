{
  "name": "CSJMUBiddingAdapter",
  "version": "7.6.1.7.0",
  "summary": "GroMore Custom ADN Adapter for UBiddingAdSDK",
  "homepage": "https://www.ubixai.com",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "zhugq": "guoqiang.zhu@ubixai.com"
  },
  "source": {
    "git": "https://gitee.com/ubixai/ubidding-ios-adapter-gromore.git",
    "tag": "7.6.1.7.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "static_framework": true,
  "swift_versions": [
    "5.0"
  ],
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "default_subspecs": [
    "Core",
    "Splash",
    "Interstitial",
    "RewardedVideo",
    "Banner",
    "Native"
  ],
  "subspecs": [
    {
      "name": "Core",
      "ios": {
        "source_files": "CSJMUBiddingAdapter/Core/**/*.{h,m}",
        "public_header_files": "CSJMUBiddingAdapter/Core/**/*.h"
      },
      "dependencies": {
        "Ads-CN": [
          "7.6.1.7"
        ],
        "Ads-CN/CSJMediation": [
          "7.6.1.7"
        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ],
        "UBiddingUBiXAdapter": [
          "2.12.0.0"
        ]
      },
      "pod_target_xcconfig": {
        "FRAMEWORK_SEARCH_PATHS": "$(inherited) $(PODS_ROOT)/UBiddingAdSDK/**",
        "HEADER_SEARCH_PATHS": "$(inherited) $(PODS_ROOT)/UBiddingAdSDK/**"
      }
    },
    {
      "name": "Splash",
      "ios": {
        "source_files": "CSJMUBiddingAdapter/Splash/**/*.{h,m}",
        "public_header_files": "CSJMUBiddingAdapter/Splash/**/*.h"
      },
      "dependencies": {
        "CSJMUBiddingAdapter/Core": [

        ]
      }
    },
    {
      "name": "Interstitial",
      "ios": {
        "source_files": "CSJMUBiddingAdapter/Interstitial/**/*.{h,m}",
        "public_header_files": "CSJMUBiddingAdapter/Interstitial/**/*.h"
      },
      "dependencies": {
        "CSJMUBiddingAdapter/Core": [

        ]
      }
    },
    {
      "name": "RewardedVideo",
      "ios": {
        "source_files": "CSJMUBiddingAdapter/RewardedVideo/**/*.{h,m}",
        "public_header_files": "CSJMUBiddingAdapter/RewardedVideo/**/*.h"
      },
      "dependencies": {
        "CSJMUBiddingAdapter/Core": [

        ]
      }
    },
    {
      "name": "Banner",
      "ios": {
        "source_files": "CSJMUBiddingAdapter/Banner/**/*.{h,m}",
        "public_header_files": "CSJMUBiddingAdapter/Banner/**/*.h"
      },
      "dependencies": {
        "CSJMUBiddingAdapter/Core": [

        ]
      }
    },
    {
      "name": "Native",
      "ios": {
        "source_files": "CSJMUBiddingAdapter/Native/**/*.{h,m}",
        "public_header_files": "CSJMUBiddingAdapter/Native/**/*.h"
      },
      "dependencies": {
        "CSJMUBiddingAdapter/Core": [

        ]
      }
    }
  ],
  "swift_version": "5.0"
}

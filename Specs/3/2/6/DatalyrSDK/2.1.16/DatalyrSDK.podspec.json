{
  "name": "DatalyrSDK",
  "version": "2.1.16",
  "summary": "Server-side attribution tracking SDK for iOS",
  "description": "Datalyr SDK for iOS with server-side tracking API support.\nFeatures include attribution tracking, SKAdNetwork integration,\nApple Search Ads attribution, offline event queuing, and automatic\nsession management.",
  "homepage": "https://datalyr.com",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Datalyr": "sdk@datalyr.com"
  },
  "source": {
    "git": "https://github.com/datalyr/swift.git",
    "tag": "2.1.16"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "source_files": "Sources/DatalyrSDK/**/*.swift",
  "resource_bundles": {
    "DatalyrSDK": [
      "Sources/DatalyrSDK/PrivacyInfo.xcprivacy"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit",
    "StoreKit"
  ],
  "weak_frameworks": [

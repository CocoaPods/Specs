{
  "name": "VeonPrebidMultiAdLoader",
  "version": "0.5.0",
  "summary": "Priority-based ad mediation race engine for Veon Prebid iOS SDK (Prebid-only core).",
  "module_name": "VeonPrebidMultiAdLoader",
  "description": "Core race engine + Prebid banner/interstitial source + VeonAdSourceRegistry, the extension point optional VeonPrebidMultiAdLoaderGAM / VeonPrebidMultiAdLoaderYandex pods register into. Depends on neither GAM nor Yandex.",
  "homepage": "https://www.veon.com",
  "license": {
    "type": "Apache License, Version 2.0"
  },
  "authors": {
    "Veon AdTech": "veonadtech.com"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "source": {
    "git": "https://github.com/veonadtech/prebid-ios-sdk.git",
    "tag": "0.5.0"
  },
  "xcconfig": {
    "LIBRARY_SEARCH_PATHS": "$(inherited)",
    "OTHER_CFLAGS": "$(inherited)",
    "OTHER_LDFLAGS": "$(inherited)",
    "HEADER_SEARCH_PATHS": "$(inherited)",
    "FRAMEWORK_SEARCH_PATHS": "$(inherited)"
  },
  "source_files": "EventHandlers/PrebidMultiAdLoader/Sources/**/*.{h,m,swift}",
  "static_framework": true,
  "dependencies": {
    "VeonPrebidMobile": [
      ">= 0.5.0"
    ],
    "VeonPrebidRemoteConfig": [
      ">= 0.5.0"
    ]
  },
  "pod_target_xcconfig": {
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES",
    "DEFINES_MODULE": "YES",
    "OTHER_SWIFT_FLAGS": "$(inherited) -no-verify-emitted-module-interface"
  },
  "swift_version": "5.0"
}

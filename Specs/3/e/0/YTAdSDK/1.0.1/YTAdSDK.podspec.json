{
  "name": "YTAdSDK",
  "version": "1.0.1",
  "summary": "iOS开源工具SDK，封装网络、广告、埋点、基础组件",
  "description": "一款轻量级iOS开源SDK，包含开屏广告、信息流模版广告、埋点、网络等功能，支持OC与Swift项目.",
  "homepage": "https://github.com/SuperYF/YTAdSDK",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "SuperYF": "1205008558@qq.com"
  },
  "source": {
    "git": "https://github.com/SuperYF/YTAdSDK.git",
    "tag": "1.0.1"
  },
  "platforms": {
    "ios": "11.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "frameworks": [
    "UIKit",
    "Foundation"
  ],
  "dependencies": {
    "AnyThinkiOS": [
      "~> 6.5.43"
    ]
  },
  "vendored_frameworks": "Frameworks/YTAdSDK.xcframework",
  "resource_bundles": {
    "YTAdSDKRes": [
      "Resources/**/*.xcassets",
      "Resources/**/*.xib",
      "Resources/**/*.png",
      "Resources/**/*.jpg"
    ]
  },
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "IPHONEOS_DEPLOYMENT_TARGET[sdk=iphonesimulator*]": "12.0"
  },
  "swift_version": "5.0"
}

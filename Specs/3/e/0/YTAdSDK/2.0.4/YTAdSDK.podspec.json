{
  "name": "YTAdSDK",
  "version": "2.0.4",
  "summary": "iOS开源工具SDK，封装网络、广告、埋点、基础组件",
  "description": "一款轻量级iOS开源SDK，包含开屏广告、信息流模版广告、埋点、网络等功能，支持OC与Swift项目.",
  "homepage": "https://github.com/SuperYF/YTAdSDK",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "SuperYF": "1205008558@qq.com"
  },
  "source": {
    "git": "https://github.com/SuperYF/YTAdSDK.git",
    "tag": "2.0.4"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "frameworks": [
    "AVFoundation",
    "QuartzCore",
    "CoreGraphics",
    "CoreTelephony",
    "AdSupport",
    "AppTrackingTransparency",
    "WebKit",
    "SystemConfiguration",
    "UIKit",
    "CoreMedia"
  ],
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64",
    "IPHONEOS_DEPLOYMENT_TARGET[sdk=iphonesimulator*]": "13.0"
  },
  "vendored_frameworks": "Frameworks/YTAdSDK.xcframework",
  "resource_bundles": {
    "YTAdSDKRes": [
      "Resources/**/*.xcassets",
      "Resources/**/*.xib",
      "Resources/**/*.png",
      "Resources/**/*.jpg"
    ]
  },
  "swift_version": "5.0"
}

{
  "name": "finos-ekyc-sdk",
  "version": "2.0.4",
  "summary": "FinOS eKYC native iOS SDK (NFC, OCR, Liveness, FaceService, C06, QRCode)",
  "homepage": "https://github.com/finosvn/finos.ekyc.sdk#readme",
  "license": "MIT",
  "authors": {
    "finos_sdk": "finos.asia@icloud.com"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.7",
  "source": {
    "http": "https://github.com/finosvn/finos.ekyc.sdk/releases/download/v2.0.4/FrameworksDevice.zip"
  },
  "vendored_frameworks": [
    "FrameworksDevice/FinosCore.xcframework",
    "FrameworksDevice/Ekyc.xcframework",
    "FrameworksDevice/SmsOtp.xcframework",
    "FrameworksDevice/ESign.xcframework",
    "FrameworksDevice/OpenSSL.xcframework",
    "FrameworksDevice/SwiftyRSA.xcframework",
    "FrameworksDevice/SDKCA.xcframework",
    "FrameworksDevice/shared.xcframework"
  ],
  "resources": "FrameworksDevice/*.bundle",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386 x86_64",
    "STRIP_INSTALLED_PRODUCT": "YES",
    "COPY_PHASE_STRIP": "YES",
    "DEPLOYMENT_POSTPROCESSING": "YES"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386 x86_64"
  },
  "swift_version": "5.7"
}

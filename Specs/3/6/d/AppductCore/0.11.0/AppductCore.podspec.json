  "platforms": {
    "ios": "15.1",
    "tvos": "15.1"
  },
  "swift_versions": "6.0",
  "source": {
    "git": "https://github.com/callstackincubator/appduct.git",
    "tag": "v0.11.0"
  },
  "static_framework": true,
  "source_files": "packages/native/ios/Sources/AppductCore/Real/**/*.swift",

{
  "name": "CallWaveKit",
  "version": "0.3.0",
  "summary": "Instance-owned incoming SIP calling for iOS with CallKit.",
  "description": "CallWaveKit owns a PJSUA runtime, SIP registration, incoming audio calls,\nCallKit coordination, PushKit wake-up handling, two-way audio, RTP mute,\nDTMF and network-change recovery.",
  "homepage": "https://github.com/PetrShtuka/CallWaveKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Petr Shtuka": "pitmailcom@gmail.com"
  },
  "source": {
    "git": "https://github.com/PetrShtuka/CallWaveKit.git",
    "tag": "0.3.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "requires_arc": true,
  "swift_versions": [
    "5.9"
  ],
  "source_files": [
    "CallWaveKit/**/*.{h,m}",
    "CallWaveKitAsync/**/*.swift"
  ],
  "public_header_files": "CallWaveKit/include/*.h",
  "module_name": "CallWaveKit",
  "resource_bundles": {
    "CallWaveKit": [
      "CallWaveKit/PrivacyInfo.xcprivacy"
    ]
  },
  "vendored_frameworks": "Vendor/PJSIP.xcframework",
  "frameworks": [
    "AVFoundation",
    "AudioToolbox",
    "CallKit",
    "CFNetwork",
    "CoreAudio",
    "CoreFoundation",
    "Network",
    "PushKit",
    "UIKit"
  ],
  "libraries": [
    "m",
    "pthread"
  ],
  "pod_target_xcconfig": {
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) PJ_AUTOCONF=1",
    "USER_HEADER_SEARCH_PATHS": "$(PODS_TARGET_SRCROOT)/CallWaveKit $(PODS_TARGET_SRCROOT)/CallWaveKit/include"
  },
  "swift_version": "5.9"
}

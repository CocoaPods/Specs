{
  "name": "InfobipCallKit",
  "version": "1.0.0",
  "summary": "Drop-in WebRTC calling UI wrapping the Infobip RTC iOS SDK.",
  "description": "InfobipCallKit packages a complete UIKit calling experience — incoming/outgoing call screens,\nringtone/ringback, in-call controls (mute, speaker, audio route), post-call feedback — on top\nof the Infobip RTC SDK. The host app supplies a WebRTC token via registerSubscriber and the\nframework presents and drives all call UI on its own overlay window. The public API mirrors the\nAndroid InfobipCallClient interface.",
  "homepage": "https://github.com/congnqsmartosc/InforbipCallKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "congnq": "congnq@smartosc.com"
  },
  "source": {
    "git": "https://github.com/congnqsmartosc/InforbipCallKit.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.0",
  "static_framework": false,
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/InfobipCallKit/**/*.swift",
      "exclude_files": "Sources/InfobipCallKit/Rx/**/*",
      "resource_bundles": {
        "InfobipCallKit": [
          "Sources/InfobipCallKit/**/*.xib",
          "Resources/**/*.caf"
        ]
      },
      "frameworks": [
        "UIKit",
        "PushKit",
        "AVFoundation",
        "AudioToolbox"
      ],
      "dependencies": {
        "InfobipRTC": [
          "~> 2.6.9"
        ],
        "SnapKit": [
          "~> 5.6"
        ],
        "SDWebImage": [
          "~> 5.21"
        ],
        "XCoordinator": [
          "~> 2.2"
        ]
      }
    },
    {
      "name": "Rx",
      "source_files": "Sources/InfobipCallKit/Rx/**/*.swift",
      "dependencies": {
        "InfobipCallKit/Core": [

        ],
        "RxSwift": [
          "~> 6.1"
        ]
      }
    }
  ],
  "swift_version": "5.0"
}

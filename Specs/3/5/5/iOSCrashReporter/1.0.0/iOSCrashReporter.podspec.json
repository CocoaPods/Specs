{
  "name": "iOSCrashReporter",
  "version": "1.0.0",
  "summary": "Standalone crash capture plugin for native iOS apps.",
  "description": "Capture-only crash reporting: uncaught handler, breadcrumbs, ANR/hang, signal pending files, last-crash buffer, optional host sink. No networking or credentials.",
  "homepage": "https://github.com/arsarsars1/ios-crash-reporter",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Abdul Rehman": "arsarsars1@gmail.com"
  },
  "source": {
    "git": "https://github.com/arsarsars1/ios-crash-reporter.git",
    "tag": "v1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "source_files": "Sources/CrashReporter/**/*.{swift,h,c,m}",
  "public_header_files": "Sources/CrashReporter/Native/CrashSignalCapture.h",
  "frameworks": "UIKit",
  "module_name": "CrashReporter",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "swift_version": "5.9"
}

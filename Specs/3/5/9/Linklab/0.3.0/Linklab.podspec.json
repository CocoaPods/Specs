{
  "name": "Linklab",
  "version": "0.3.0",
  "summary": "Linklab deep linking SDK for iOS",
  "description": "Linklab SDK for iOS resolves Linklab universal links and deferred deep links (pasteboard / IP attribution).",
  "homepage": "https://linklab.cc",
  "license": {
    "type": "Apache Version 2.0",
    "file": "LICENSE"
  },
  "authors": {
    "Linklab": "info@linklab.cc"
  },
  "source": {
    "git": "https://github.com/Linklab-cc/linklab-ios-sdk.git",
    "tag": "0.3.0"
  },
  "platforms": {
    "ios": "14.3"
  },
  "swift_versions": "5.9",
  "source_files": "Sources/Linklab/**/*.swift",
  "resource_bundles": {
    "Linklab": [
      "Sources/Linklab/PrivacyInfo.xcprivacy"
    ]
  },
  "frameworks": "UIKit",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "testspecs": [
    {
      "name": "Tests",
      "test_type": "unit",
      "source_files": "Tests/LinklabTests/**/*.swift",
      "frameworks": "XCTest"
    }
  ],
  "swift_version": "5.9"
}

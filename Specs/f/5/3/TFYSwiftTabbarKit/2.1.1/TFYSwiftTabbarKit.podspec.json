{
  "name": "TFYSwiftTabbarKit",
  "version": "2.1.1",
  "summary": "Swift TabBarController：中间 Plus、角标、扁平栏、Lottie、iOS 26 Liquid Glass。",
  "description": "CYLTabBarController 的 Swift 实现。支持中间 Plus 按钮、数字/红点角标、扁平自定义 TabBar、\nLottie Tab 动画（SPM 自带 Lottie；CocoaPods 不再依赖 lottie-ios，可自行引入 Lottie 并接入桥接文件），\n以及 iOS 26 Liquid Glass。最低 iOS 16、Swift 5。",
  "homepage": "https://github.com/13662049573/TFYSwiftTabBarController",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "田风有": "420144542@qq.com"
  },
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "module_name": "TFYSwiftTabbarKit",
  "source": {
    "git": "https://github.com/13662049573/TFYSwiftTabBarController.git",
    "tag": "2.1.1"
  },
  "source_files": [
    "TFYSwiftTabBarController/TFYSwiftTabbarKit/*.{h,m,swift}",
    "TFYSwiftTabBarController/TFYSwiftTabbarKit/**/*.{h,m,swift}"
  ],
  "public_header_files": "TFYSwiftTabBarController/TFYSwiftTabbarKit/include/*.h",
  "requires_arc": true,
  "frameworks": [
    "UIKit",
    "Foundation",
    "QuartzCore"
  ],
  "pod_target_xcconfig": {
    "SWIFT_VERSION": "5.0",
    "DEFINES_MODULE": "YES",
    "HEADER_SEARCH_PATHS": "$(inherited) $(PODS_TARGET_SRCROOT)/TFYSwiftTabBarController/TFYSwiftTabbarKit/include"
  },
  "swift_version": "5.0"
}

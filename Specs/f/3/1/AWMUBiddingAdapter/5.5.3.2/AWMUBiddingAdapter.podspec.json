{
  "name": "AWMUBiddingAdapter",
  "version": "5.5.3.2",
  "summary": "ToBid-iOS Custom ADN Adapter for UBiddingAdSDK",
  "homepage": "https://www.ubixai.com",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "zhugq": "guoqiang.zhu@ubixai.com"
  },
  "source": {
    "git": "https://gitee.com/ubixai/ubidding-ios-adapter-tobid.git",
    "tag": "5.5.3.2"
  },
  "platforms": {
    "ios": "13.0"
  },
  "static_framework": true,
  "swift_versions": [
    "5.0"
  ],
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  },
  "default_subspecs": [
    "Core",
    "Splash",
    "Interstitial",
    "RewardedVideo",
    "Banner",
    "Native"
  ],
  "subspecs": [
    {
      "name": "Core",
      "ios": {
        "source_files": "AWMUBiddingAdapter/Core/**/*.{h,m,swift}",
        "public_header_files": "AWMUBiddingAdapter/Core/**/*.h"
      },
      "dependencies": {
        "ToBid-iOS": [
          "5.5.3"
        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ],
        "UBiddingUBiXAdapter": [
          "2.12.0.0"
        ]
      },
      "pod_target_xcconfig": {
        "FRAMEWORK_SEARCH_PATHS": "$(inherited) $(PODS_ROOT)/UBiddingAdSDK/**",
        "HEADER_SEARCH_PATHS": "$(inherited) $(PODS_ROOT)/UBiddingAdSDK/**"
      }
    },
    {
      "name": "Splash",
      "ios": {
        "source_files": "AWMUBiddingAdapter/Splash/**/*.{h,m}",
        "public_header_files": "AWMUBiddingAdapter/Splash/**/*.h"
      },
      "dependencies": {
        "AWMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "Interstitial",
      "ios": {
        "source_files": "AWMUBiddingAdapter/Interstitial/**/*.{h,m}",
        "public_header_files": "AWMUBiddingAdapter/Interstitial/**/*.h"
      },
      "dependencies": {
        "AWMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "RewardedVideo",
      "ios": {
        "source_files": "AWMUBiddingAdapter/RewardedVideo/**/*.{h,m}",
        "public_header_files": "AWMUBiddingAdapter/RewardedVideo/**/*.h"
      },
      "dependencies": {
        "AWMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "Banner",
      "ios": {
        "source_files": "AWMUBiddingAdapter/Banner/**/*.{h,m}",
        "public_header_files": "AWMUBiddingAdapter/Banner/**/*.h"
      },
      "dependencies": {
        "AWMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "Native",
      "ios": {
        "source_files": "AWMUBiddingAdapter/Native/**/*.{h,m}",
        "public_header_files": "AWMUBiddingAdapter/Native/**/*.h"
      },
      "dependencies": {
        "AWMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    }
  ],
  "swift_version": "5.0"
}

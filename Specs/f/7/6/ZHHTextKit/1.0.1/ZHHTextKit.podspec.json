{
  "name": "ZHHTextKit",
  "version": "1.0.1",
  "summary": "纯 Swift 富文本组件，供 Feed、评论、私信等场景复用。",
  "description": "ZHHTextKit 提供与业务解耦的富文本解析、展示和输入：话题、提及、链接、电话、\n按行截断与「全文 / 收起」、布局缓存与后台预计算、@ / # 发布 document（text + entities）、\n自定义表情短码，以及正文胶囊标签。颜色和字体通过 ZHHTextStyle 注入。",
  "homepage": "https://github.com/yue5yueliang/ZHHTextKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "桃色三岁": "136769890@qq.com"
  },
  "source": {
    "git": "https://github.com/yue5yueliang/ZHHTextKit.git",
    "tag": "1.0.1"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5.5"
  ],
  "frameworks": [
    "UIKit",
    "CoreText"
  ],
  "resource_bundles": {
    "ZHHTextKit": [
      "ZHHTextKit/PrivacyInfo.xcprivacy"
    ]
  },
  "default_subspecs": "Source",
  "subspecs": [
    {
      "name": "Source",
      "source_files": "ZHHTextKit/Classes/**/*"
    }
  ],
  "swift_version": "5.5"
}

{
  "name": "LitemobBUMAdapter",
  "version": "1.0.2",
  "summary": "LitemobBUMAdapter - LitemobSDK 的穿山甲（BUM）适配器",
  "description": "LMBUMAdapter 是 LitemobSDK 的第三方广告平台适配器，用于将 LitemobSDK 接入到穿山甲（BUM）SDK。",
  "homepage": "https://hub.litemob.com/adsdk/ios-sdk",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Litemob": "sdk@litemob.com"
  },
  "source": {
    "git": "https://hub.litemob.com/adsdk/ios-sdk.git",
    "tag": "BUMAdapter-v1.0.2"
  },
  "platforms": {
    "ios": "11.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "source_files": "LitemobBUMAdapter/**/*.{h,m}",
  "public_header_files": "LitemobBUMAdapter/**/*.h",
  "dependencies": {
    "LitemobAd": [
      "1.3.9"
    ],
    "Ads-CN/BUAdSDK": [
      "~> 7.0"
    ],
    "Ads-CN/CSJMediation-Only": [
      "~> 7.0"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit"
  ],
  "pod_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  }
}

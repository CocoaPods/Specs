{
  "name": "TowerSignalProfiling",
  "version": "4.0.0",
  "summary": "Official TowerSignal Profiling module of the Swift SDK.",
  "homepage": "https://www.towersignal.com",
  "license": {
    "type": "Apache",
    "file": "LICENSE"
  },
  "authors": "TowerSignal, Inc.",
  "swift_versions": "5.9",
  "platforms": {
    "ios": "15.0",
    "tvos": "15.0",
    "visionos": "1.0"
  },
  "source": {
    "git": "https://github.com/sriprakash-atatus/sri-ios-spm.git",
    "tag": "v4.0.0"
  },
  "source_files": [
    "TowerSignalProfiling/Sources/**/*.swift",
    "TowerSignalProfiling/Mach/**/*.{h,c,cpp}"
  ],
  "private_header_files": [
    "TowerSignalProfiling/Mach/**/*.h"
  ],
  "preserve_paths": "TowerSignalProfiling/Mach/include/module.modulemap",
  "dependencies": {
    "TowerSignalInternal": [
      "4.0.0"
    ]
  },
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
    "SWIFT_INCLUDE_PATHS": "$(PODS_TARGET_SRCROOT)/TowerSignalProfiling/Mach/include"
  },
  "swift_version": "5.9"
}

{
  "name": "TableRowKit",
  "version": "0.1.1",
  "summary": "Row and section models for UIKit table views.",
  "description": "An Objective-C UITableView data source and delegate adapter built around ordered row and section models.",
  "homepage": "https://github.com/OrisunWang/TableRowKit",
  "source": {
    "git": "https://github.com/OrisunWang/TableRowKit.git",
    "tag": "v0.1.1"
  },
  "platforms": {
    "ios": "15.0"
  },
  "source_files": "Sources/TableRowKit/**/*.{h,m}",
  "public_header_files": "Sources/TableRowKit/{TableRowKit,TRKNode,TRKTableDataSource,TRKTableSection,TRKTableRow,TRKTableView,TRKTableViewCell}.h",
  "private_header_files": "Sources/TableRowKit/TRKTableViewDelegateProxy.h",
  "frameworks": "UIKit",
  "requires_arc": true,
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": "TableRowKit contributors",
  "testspecs": [
    {
      "name": "Tests",
      "test_type": "unit",
      "source_files": "Tests/**/*.{h,m,swift}",
      "frameworks": "XCTest"
    }
  ]
}

{
  "name": "PKShortVideo",
  "version": "0.9.7",
  "license": "MIT",
  "summary": "A video library like WeChat short video for iOS.",
  "homepage": "https://github.com/pepsikirk/PKShortVideo",
  "authors": {
    "pepsikirk": "pepsikirk@gmail.com"
  },
  "source": {
    "git": "https://github.com/pepsikirk/PKShortVideo.git",
    "tag": "0.9.7"
  },
  "screenshots": "https://raw.githubusercontent.com/pepsikirk/PKShortVideo/master/Screenshots/gif.gif",
  "platforms": {
    "ios": "12.0"
  },
  "resources": "PKShortVideo/PKAsset/*.png",
  "frameworks": [
    "AVFoundation",
    "CoreMedia",
    "CoreVideo",
    "OpenGLES",
    "QuartzCore"
  ],
  "requires_arc": true,
  "pod_target_xcconfig": {
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) GLES_SILENCE_DEPRECATION=1 COREVIDEO_SILENCE_GL_DEPRECATION=1"
  },
  "source_files": [
    "PKShortVideo/**/*.{h,m}",
    "PKShortVideo/*.{h,m}"
  ],
  "exclude_files": "PKShortVideo/include/PKShortVideo.h"
}

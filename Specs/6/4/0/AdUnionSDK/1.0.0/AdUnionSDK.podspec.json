{
  "name": "AdUnionSDK",
  "version": "1.0.0",
  "summary": "A short description of AdUnionSDK.",
  "description": "TODO: Add long description of the pod here.",
  "homepage": "https://gitee.com/bwlx/ad-union-sdk",
  "license": {

    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "10.0"
  },
  "frameworks": [
    "UIKit",
    "WebKit",
    "SystemConfiguration",
    "MobileCoreServices"
  ],
  "requires_arc": true,
  "dependencies": {
    "CXHAdSDK/RC": [
      "~> 1.12"
    ]
  },
  "xcconfig": {
    "ARCHS": "${ARCHS_STANDARD_64_BIT}",
    "VALID_ARCHS": "${ARCHS_STANDARD_64_BIT}",
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  },
  "ios": {
    "vendored_frameworks": [
      "AdUnionSDK/Classes/AdUnionSDK.framework"
    ]
  },
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  }
}

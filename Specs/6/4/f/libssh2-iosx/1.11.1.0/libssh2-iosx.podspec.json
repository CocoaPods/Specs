{
  "name": "libssh2-iosx",
  "version": "1.11.1.0",
  "summary": "libssh2 (SSH2 client library) XCFramework for macOS, iOS, watchOS, tvOS, and visionOS, with Catalyst and simulators.",
  "homepage": "https://github.com/apotocki/libssh2-iosx",
  "license": "BSD-3-Clause License",
  "authors": {
    "Alexander Pototskiy": "alex.a.potocki@gmail.com"
  },
  "social_media_url": "https://www.linkedin.com/in/alexander-pototskiy",
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0",
    "watchos": "11.0",
    "visionos": "1.0"
  },
  "ios": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "osx": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "tvos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "watchos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "visionos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "static_framework": true,
  "requires_arc": false,
  "prepare_command": "sh scripts/build.sh",
  "source": {
    "git": "https://github.com/apotocki/libssh2-iosx.git",
    "tag": "1.11.1.0"
  },
  "default_subspecs": "OpenSSL",
  "subspecs": [
    {
      "name": "Core",
      "header_mappings_dir": "frameworks/Headers",
      "public_header_files": "frameworks/Headers/**/*.{h,H,c}",
      "source_files": "frameworks/Headers/**/*.{h,H,c}",
      "vendored_frameworks": "frameworks/ssh2.xcframework",
      "libraries": "z"
    },
    {
      "name": "OpenSSL",
      "dependencies": {
        "libssh2-iosx/Core": [

        ],
        "openssl-iosx": [
          "~> 3.5"
        ]
      }
    }
  ]
}

{
  "name": "RevenueDotPurchases",
  "module_name": "RevenueCat",
  "version": "5.91.0",
  "summary": "Subscription and in-app-purchase backend service. RevenueDot fork of RevenueCat's MIT SDK.",
  "description": "Save yourself the hassle of implementing a subscriptions backend. This is RevenueDot's drop-in fork of RevenueCat's MIT SDK; it talks to RevenueDot, the open-source subscription server (https://revenuedot.app). Not affiliated with RevenueCat.",
  "homepage": "https://revenuedot.app",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "RevenueDot": "https://github.com/revenuedot",
    "RevenueCat, Inc. (original MIT SDK)": "https://github.com/RevenueCat"
  },
  "source": {
    "git": "https://github.com/revenuedot/purchases-ios.git",
    "tag": "5.91.0-revenuedot"
  },
  "documentation_url": "https://revenuedot.app/docs",
  "frameworks": "StoreKit",
  "swift_versions": "5.8",
  "platforms": {
    "ios": "13.0",
    "watchos": "6.2",
    "tvos": "13.0",
    "osx": "10.15",
    "visionos": "1.0"
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) COCOAPODS",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=xros*]": "$(inherited) COCOAPODS VISION_OS",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=xrsimulator*]": "$(inherited) COCOAPODS VISION_OS"
  },
  "source_files": "Sources/**/*.swift",
  "exclude_files": "Sources/LocalReceiptParsing/ReceiptParser-only-files/**",
  "resource_bundles": {
    "RevenueCat": [
      "Sources/PrivacyInfo.xcprivacy"
    ]
  },
  "swift_version": "5.8"
}

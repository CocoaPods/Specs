{
  "name": "KKFlutterInspectorKit",
  "version": "0.1.0",
  "summary": "An iOS toolkit for inspecting Flutter integration.",
  "description": "KKFlutterInspectorKit provides reusable Objective-C components for\ninspecting and debugging Flutter content embedded in iOS applications.",
  "homepage": "https://github.com/kriskicekk/KKFlutterInspectorKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "kriskicekk": "kriskice9527@gmail.com"
  },
  "source": {
    "git": "https://github.com/kriskicekk/KKFlutterInspectorKit.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "source_files": "KKFlutterInspectorKit/Classes/**/*.{h,m,mm}",
  "public_header_files": [
    "KKFlutterInspectorKit/Classes/KKFlutterInspector.h",
    "KKFlutterInspectorKit/Classes/Internal/Model/KKFIInspectorModels.h"
  ],
  "private_header_files": [
    "KKFlutterInspectorKit/Classes/Internal/Connection/*.h",
    "KKFlutterInspectorKit/Classes/Internal/Hierarchy/*.h",
    "KKFlutterInspectorKit/Classes/Internal/Inspector/*.h",
    "KKFlutterInspectorKit/Classes/Internal/Runtime/*.h",
    "KKFlutterInspectorKit/Classes/Internal/Session/*.h"
  ],
  "frameworks": [
    "Foundation",
    "UIKit"
  ]
}

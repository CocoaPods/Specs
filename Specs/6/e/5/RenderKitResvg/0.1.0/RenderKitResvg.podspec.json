{
  "name": "RenderKitResvg",
  "version": "0.1.0",
  "summary": "A constrained C ABI wrapper around resvg for iOS.",
  "description": "RenderKitResvg packages resvg behind a small, fail-closed C ABI. It renders\nin-memory SVG and optional font data into a caller-owned RGBA buffer without\nloading system fonts, local files, or remote resources.",
  "homepage": "https://github.com/lihao336991/renderkit-resvg",
  "authors": {
    "LiHao": "lihao.zzz@bytedance.com"
  },
  "license": {
    "type": "MIT OR Apache-2.0",
    "file": "LICENSE-MIT"
  },
  "source": {
    "http": "https://github.com/lihao336991/renderkit-resvg/releases/download/v0.1.0/RenderKitResvg-0.1.0.zip",
    "sha256": "8f0651b207c091b0a15bded9827fd4576fa3917ea57189f20b8928d083d41ffc"
  },
  "platforms": {
    "ios": "15.0"
  },
  "cocoapods_version": ">= 1.10",
  "vendored_frameworks": "RenderKitResvg.xcframework",
  "resource_bundles": {
    "RenderKitResvgNotices": [
      "Notices/THIRD-PARTY-NOTICES.txt",
      "Notices/RUST-STDLIB-NOTICES.html"

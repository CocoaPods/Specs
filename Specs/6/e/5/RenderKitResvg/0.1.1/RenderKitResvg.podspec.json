{
  "name": "RenderKitResvg",
  "version": "0.1.1",
  "summary": "A constrained C ABI wrapper around resvg for iOS.",
  "description": "RenderKitResvg packages resvg behind a small, fail-closed C ABI. It renders\nin-memory SVG and optional primary font data into a caller-owned RGBA buffer.\nMissing glyphs can use read-only system fonts selected by Core Text.",
  "homepage": "https://github.com/lihao336991/renderkit-resvg",
  "authors": {
    "LiHao": "lihao.zzz@bytedance.com"
  },
  "license": {
    "type": "MIT OR Apache-2.0",
    "file": "LICENSE-MIT"
  },
  "source": {
    "http": "https://github.com/lihao336991/renderkit-resvg/releases/download/v0.1.1/RenderKitResvg-0.1.1.zip",
    "sha256": "56674b2ac3927a8cbc8b3391eefa78f8b18d89817d8edfc738b14ccc348095d0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "cocoapods_version": ">= 1.10",
  "vendored_frameworks": "RenderKitResvg.xcframework",
  "frameworks": [
    "CoreFoundation",
    "CoreText"
  ],
  "resource_bundles": {
    "RenderKitResvgNotices": [
      "Notices/THIRD-PARTY-NOTICES.txt",
      "Notices/RUST-STDLIB-NOTICES.html"
    ]
  },
  "preserve_paths": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE"
  ]
}

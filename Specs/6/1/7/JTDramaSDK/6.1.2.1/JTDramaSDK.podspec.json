  },
  "source": {
    "http": "https://jt-sdk-ios.oss-cn-beijing.aliyuncs.com/sdk_framework/drama/JTDramaSDK_v6.1.2.1.zip",
    "type": "zip"
  },
  "vendored_frameworks": "JTDramaSDK_v6.1.2.1/JTDramaSDK.xcframework",
  "platforms": {

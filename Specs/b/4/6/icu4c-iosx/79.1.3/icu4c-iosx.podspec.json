{
  "name": "icu4c-iosx",
  "version": "79.1.3",
  "summary": "ICU XCFramework for macOS, iOS, watchOS, tvOS, and visionOS, including Mac Catalyst and simulators.",
  "description": "ICU XCFramework for macOS, iOS, watchOS, tvOS, and visionOS, including Mac Catalyst and simulators. New versions are published to the apotocki/cocoapods-specs spec repo (https://github.com/apotocki/cocoapods-specs), because CocoaPods Trunk becomes read-only on December 2, 2026: add :source => 'https://github.com/apotocki/cocoapods-specs.git' to the pod in your Podfile.",
  "homepage": "https://github.com/apotocki/icu4c-iosx",
  "license": "BSD",
  "authors": {
    "Alexander Pototskiy": "alex.a.potocki@gmail.com"
  },
  "social_media_url": "https://www.linkedin.com/in/alexander-pototskiy",
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0",
    "watchos": "11.0",
    "visionos": "1.0"
  },
  "ios": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "osx": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "tvos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "watchos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "visionos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "static_framework": true,
  "source": {
    "git": "https://github.com/apotocki/icu4c-iosx.git",
    "tag": "79.1.3"
  },
  "source_files": "product/include/**/*.{h}",
  "header_mappings_dir": "product/include",
  "prepare_command": "sh scripts/build.sh",
  "public_header_files": "product/include/**/*.{h}",
  "vendored_frameworks": [
    "product/frameworks/icudata.xcframework",
    "product/frameworks/icui18n.xcframework",
    "product/frameworks/icuio.xcframework",
    "product/frameworks/icuuc.xcframework"
  ],
  "resource_bundles": {
    "icu4c-iosx_privacy": [
      "PrivacyInfo.xcprivacy"
    ]
  }
}

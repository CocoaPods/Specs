{
  "name": "JMMeetSDK",
  "version": "1.0.0",
  "summary": "lib-jitsi-meet 的 Swift 原生集成：JavaScriptCore 运行 lib-jitsi-meet，原生 WebRTC 媒体栈与 SwiftUI/ObjC 双门面。",
  "description": "把 lib-jitsi-meet 跑在 iOS 的 JavaScriptCore 上，媒体走原生 libwebrtc\n（JitsiWebRTC pod）后端。提供 Swift 与 Objective-C 双门面：连接/会议\n全量 API、断线重连、等候室、分组讨论、录制、屏幕共享（ReplayKit）、\n投票/字幕/表情，以及 SwiftUI 会议 UI 与逐人音频电平回调。\nWebRTC 依赖随 pod 自动接入，安装即链接使用。",
  "homepage": "https://github.com/driverZhan/Jitsi-meet-swift",
  "license": {
    "type": "Apache 2.0",
    "file": "Sources/JitsiJSRuntime/Resources/js/98-lib-jitsi-meet.LICENSE.txt"
  },
  "authors": {
    "driverZhan": "senyou2012@163.com"
  },
  "source": {
    "git": "https://github.com/driverZhan/Jitsi-meet-swift.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "vendored_frameworks": [
    "dist/JitsiMeetSDK.xcframework",
    "Frameworks/WebRTC.xcframework"
  ],
  "resources": "dist/JitsiMeetSDK_JitsiMeetSDK.bundle",
  "frameworks": [
    "UIKit",
    "SwiftUI",
    "AVFoundation",
    "CoreMedia",
    "CoreVideo",
    "Accelerate",
    "CoreImage",
    "JavaScriptCore",
    "ReplayKit",
    "Network",
    "UserNotifications",
    "Combine",
    "AudioToolbox",
    "CoreAudio",
    "VideoToolbox",
    "AudioUnit"
  ],
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -L\"$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)\""
  },
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "-ld_classic",
    "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES"
  },
  "deprecated": true
}

{
  "name": "UXCam",
  "version": "3.10.3",
  "summary": "UXCam SDK for iOS applications",
  "description": "Visit https://uxcam.com to get a key.\nThis is version 3.10.3 of the SDK - see CHANGELOG for details",
  "homepage": "https://uxcam.com/",
  "license": {
    "type": "BSD"
  },
  "authors": {
    "UXCam": "admin@uxcam.com"
  },
  "social_media_url": "https://www.twitter.com/uxcam",
  "documentation_url": "https://developer.uxcam.com/docs",
  "platforms": {
    "ios": "12.0"
  },
  "source": {
    "http": "https://github.com/uxcam/uxcam-ios/releases/download/3.10.3/UXCam.xcframework.zip"
  },
  "vendored_frameworks": "UXCam.xcframework",
  "user_target_xcconfig": {
    "LIBRARY_SEARCH_PATHS": "$(inherited) \"$(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME)\" \"$(SDKROOT)/usr/lib/swift\""
  },
  "static_framework": true,
  "libraries": [
    "z",
    "iconv",
    "c++"
  ],
  "frameworks": [
    "AVFoundation",
    "CoreGraphics",
    "CoreMedia",
    "CoreVideo",
    "CoreTelephony",
    "MobileCoreServices",
    "QuartzCore",
    "SystemConfiguration",
    "Security",
    "WebKit"
  ],
  "xcconfig": {
    "FRAMEWORK_SEARCH_PATHS": "$(inherited) \"$(PODS_ROOT)/UXCam\""
  },
  "requires_arc": true
}

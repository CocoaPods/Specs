      "dependencies": {
        "lhsCommonMethod/Core": [

        ]
      }
    },
    {
      "name": "CountdownTimer",
      "source_files": "lhsCommonMethod/CountdownTimer/*.{h,m}"
    },
    {
      "name": "CutDownButton",
      "source_files": "lhsCommonMethod/CutDownButton/*.{h,m}"
    },
    {
      "name": "DocumentPickerManager",
      "source_files": "lhsCommonMethod/DocumentPickerManager/*.{h,m}"
    },
    {
      "name": "Toast",
      "source_files": "lhsCommonMethod/Toast/*.{h,m}"
    },
    {
      "name": "Category",
      "source_files": "lhsCommonMethod/Category/*.{h,m}"

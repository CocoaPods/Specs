    "tag": "0.0.11"
  },
  "platforms": {
    "ios": "13.0"
  },
  "source_files": "lhsCommonMethod/lhsCommonMethod.h",
  "header_mappings_dir": "lhsCommonMethod",
  "frameworks": [
    "UIKit",
    "Foundation",
    "AVFoundation",
    "WebKit",
    "CoreTelephony"
  ],
  "requires_arc": true,

{
  "name": "LitemobSigmobAdapter",
  "version": "1.0.0",
  "summary": "LitemobSigmobAdapter - LitemobSDK 的 ToBid 适配器",
  "description": "LitemobSigmobAdapter 是 LitemobSDK 的第三方广告平台适配器，用于将 LitemobSDK 接入到 ToBid SDK。",
  "homepage": "https://hub.litemob.com/adsdk/ios-sdk",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Litemob": "sdk@litemob.com"
  },
  "source": {
    "git": "https://hub.litemob.com/adsdk/ios-sdk.git",
    "tag": "SigmobAdapter-v1.0.0"
  },
  "platforms": {
    "ios": "11.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "source_files": "LitemobSigmobAdapter/**/*.{h,m}",
  "public_header_files": "LitemobSigmobAdapter/**/*.h",
  "dependencies": {
    "LitemobAd": [
      "~> 1.3.7"
    ],
    "ToBid-iOS-RC": [
      "5.6.0"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit"
  ],
  "pod_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  }
}

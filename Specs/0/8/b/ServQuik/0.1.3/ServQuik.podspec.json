{
  "name": "ServQuik",
  "version": "0.1.3",
  "summary": "Consented live in-app support SDK for iOS.",
  "description": "ServQuik connects an iOS app as a support device using an organization license key.\nAgents on app.servquik.io can request a live view after the shopper consents.\nOnly agents for that license see the device.",
  "homepage": "https://gitlab.com/Serbus/servquik-sdk-ios",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "ServQuik": "support@servquik.io"
  },
  "source": {
    "git": "https://gitlab.com/Serbus/servquik-sdk-ios.git",
    "tag": "0.1.3"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5.7",
    "5.9",
    "5.10"
  ],
  "source_files": [
    "Sources/ServQuik/**/*.swift",
    "Sources/ServQuikSupport/**/*.{h,m}"
  ],
  "public_header_files": "Sources/ServQuikSupport/include/*.h",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "frameworks": [
    "Foundation",
    "UIKit"
  ],
  "swift_version": "5.10"
}

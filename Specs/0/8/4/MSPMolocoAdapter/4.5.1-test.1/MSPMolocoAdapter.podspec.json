{
  "name": "MSPMolocoAdapter",
  "summary": "an adapter for Moloco SDK",
  "description": "an adapter for Moloco SDK",
  "homepage": "https://github.com/ParticleMedia/msp-ios-sdk-public",
  "license": "Copyright",
  "authors": {
    "Mingming Luo": "mingming.luo@newsbreak.com"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.0",
  "requires_arc": true,
  "static_framework": true,
  "pod_target_xcconfig": {
    "SWIFT_INCLUDE_PATHS": "$(inherited) $(PODS_CONFIGURATION_BUILD_DIR)",
    "VALID_ARCHS": "x86_64 armv7 arm64",
    "DEFINES_MODULE": "YES"
  },
  "user_target_xcconfig": {
    "SWIFT_INCLUDE_PATHS": "$(inherited) $(PODS_CONFIGURATION_BUILD_DIR)",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "dependencies": {
    "MolocoSDKiOS": [
      "~> 4.2"
    ],
    "MSPSharedLibraries": [
      "4.5.1-test.1"
    ],
    "MSPiOSCore": [
      "4.5.1-test.1"
    ]
  },
  "version": "4.5.1-test.1",
  "source": {
    "http": "https://github.com/ParticleMedia/msp-ios-sdk-public/releases/download/4.5.1-test.1/MSPMolocoAdapter-4.5.1-test.1.zip",
    "type": "zip",
    "sha256": "d6c0b9b8175d2bb92d4c2e13bebcfd2a3e221cc38ed9a64defe9254ca5a08766"
  },
  "vendored_frameworks": "Binary/MSPMolocoAdapter.xcframework",
  "swift_version": "5.0"
}

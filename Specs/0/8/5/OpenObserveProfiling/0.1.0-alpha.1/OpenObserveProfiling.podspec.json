{
  "name": "OpenObserveProfiling",
  "version": "0.1.0-alpha.1",
  "summary": "Official OpenObserve Profiling module of the Swift SDK.",
  "homepage": "https://www.openobserve.ai",
  "social_media_url": "https://twitter.com/openobserve",
  "license": {
    "type": "Apache",
    "file": "LICENSE"
  },
  "authors": "OpenObserve, Inc.",
  "swift_versions": "5.9",
  "platforms": {
    "ios": "12.0",
    "tvos": "12.0"
  },
  "source": {
    "git": "https://github.com/openobserve/openobserve-sdk-ios.git",
    "tag": "0.1.0-alpha.1"
  },
  "source_files": [
    "OpenObserveProfiling/Sources/**/*.swift",
    "OpenObserveProfiling/Mach/**/*.{h,c,cpp}"
  ],
  "private_header_files": [
    "OpenObserveProfiling/Mach/**/*.h"
  ],
  "preserve_paths": "OpenObserveProfiling/Mach/include/module.modulemap",
  "dependencies": {
    "OpenObserveInternal": [
      "0.1.0-alpha.1"
    ]
  },
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
    "SWIFT_INCLUDE_PATHS": "$(PODS_TARGET_SRCROOT)/OpenObserveProfiling/Mach/include"
  },
  "swift_version": "5.9"
}

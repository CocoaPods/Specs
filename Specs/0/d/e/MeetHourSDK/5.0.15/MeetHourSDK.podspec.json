    "git": "https://github.com/v-empower/meethour-ios-sdk-releases.git",
    "tag": "5.0.15"
  },
  "platforms": {
    "ios": "13.1"
  },
  "swift_versions": "5",
  "frameworks": [
    "JavaScriptCore",
    "AVFoundation",
    "UIKit",
    "Foundation"
  ],
  "default_subspecs": "Native",
  "subspecs": [
    {
      "name": "Native",
      "vendored_frameworks": [
        "Frameworks/MeetHourSDK.xcframework",
        "Frameworks/WebRTC.xcframework",
        "Frameworks/hermesvm.xcframework",

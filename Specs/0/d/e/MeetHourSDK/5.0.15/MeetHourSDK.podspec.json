          "2.2.12"
        ]
      }
    },
    {
      "name": "React",
      "vendored_frameworks": [
        "Frameworks/MeetHourSDK.xcframework",
        "Frameworks/WebRTC.xcframework",
        "Frameworks/hermesvm.xcframework"
      ],
      "dependencies": {
        "Giphy": [
          "2.2.12"
        ]
      }
    }
  ],
  "swift_version": "5"

{
  "name": "MeetHourSDK",
  "version": "5.0.15",
  "summary": "Meet Hour iOS SDK",
  "description": "Meet Hour is HD Quality video conference solution with End to End Encrypted and many other features such as lobby mode, Donor box & Click&Pledge Connect for fundraising, Video call recording, Youtube Live Stream etc. For more details visit www.meethour.io.",
  "homepage": "https://github.com/v-empower/meethour-ios-sdk-releases",
  "license": "Meet Hour, LLC",
  "authors": "Meet Hour, LLC",

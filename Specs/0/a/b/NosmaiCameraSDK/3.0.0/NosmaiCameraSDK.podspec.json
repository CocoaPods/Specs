{
  "name": "NosmaiCameraSDK",
  "version": "3.0.0",
  "summary": "Real-time camera effects, beauty, AR, backgrounds, and recording for iOS.",
  "description": "Nosmai Camera SDK is a proprietary iOS framework for real-time camera\neffects, built-in beauty and makeup, face reshape, background replacement,\nrecording, processed frame output, and local or cloud .nosmai packages.\nA valid Nosmai license key and written authorization are required.",
  "homepage": "https://github.com/nosmai/camera-sdk-ios",
  "license": {
    "type": "Proprietary",
    "text": "See LICENSE file"
  },
  "authors": {
    "Nosmai": "admin@nosmai.com"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.0",
  "source": {
    "http": "https://github.com/nosmai/camera-sdk-ios/releases/download/v3.0.0/nosmai.framework.zip"
  },
  "vendored_frameworks": "nosmai.framework",
  "requires_arc": true,
  "frameworks": [
    "OpenGLES",
    "UIKit",
    "QuartzCore",
    "CoreVideo",
    "CoreGraphics",
    "CoreImage",
    "AVFoundation",
    "CoreMedia",
    "Metal",
    "MetalKit",
    "CoreML",
    "Accelerate",
    "Security"
  ],
  "libraries": [
    "z",
    "c++"
  ],
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64 x86_64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64 x86_64"
  },
  "swift_version": "5.0"
}

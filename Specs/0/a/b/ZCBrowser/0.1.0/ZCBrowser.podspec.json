{
  "name": "ZCBrowser",
  "version": "0.1.0",
  "summary": "召潮浏览器 — 一个开箱即用的 SwiftUI 浏览器组件（WebView 多标签、书签、历史、下载、密码管家、油猴脚本、内容拦截）。",
  "description": "召潮浏览器（ZhaoChao Browser）把完整的移动端浏览器封装成一个 CocoaPods 组件：\n基于 WKWebView 的多标签管理、地址栏与搜索、书签/历史/下载、本地密码管家\n（Keychain + AES-GCM 加密）、油猴用户脚本、内容拦截规则、二维码扫描与\n阅读体验。宿主工程只需一行 present 即可得到一个全功能浏览器界面。",
  "homepage": "https://github.com/0q7e1/ZCBrowser",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "yuzhaohai": "yuzhaohai@126.com"
  },
  "source": {
    "git": "https://github.com/0q7e1/ZCBrowser.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "17.0"
  },
  "swift_versions": "5.0",
  "source_files": "Pod/Classes/**/*.swift",
  "resource_bundles": {
    "ZCBrowser": [
      "Pod/Assets/**/*.lproj"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit",
    "SwiftUI",
    "WebKit",
    "Security",
    "CryptoKit",
    "LocalAuthentication",
    "UniformTypeIdentifiers",
    "QuickLook",
    "VisionKit"
  ],
  "swift_version": "5.0"
}

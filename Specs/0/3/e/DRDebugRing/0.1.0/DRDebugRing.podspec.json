{
  "name": "DRDebugRing",
  "version": "0.1.0",
  "summary": "A scene-aware floating ring for custom iOS debug actions.",
  "description": "A draggable debug ring that presents a host-provided view controller, with touch passthrough, safe-area layout and no third-party dependencies.",
  "homepage": "https://github.com/OrisunWang/DRDebugRing",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "OrisunWang": "https://github.com/OrisunWang"
  },
  "source": {
    "git": "https://github.com/OrisunWang/DRDebugRing.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "source_files": "DebugRing/Classes/*.{h,m}",
  "public_header_files": "DebugRing/Classes/DRDebugRing.h",
  "frameworks": "UIKit",
  "requires_arc": true,
  "pod_target_xcconfig": {
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": "$(inherited) DEBUG_RING=1"
  }
}

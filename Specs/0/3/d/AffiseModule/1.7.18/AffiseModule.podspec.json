{
  "name": "AffiseModule",
  "version": "1.7.18",
  "summary": "Affise Modules",
  "description": "Affise module collection",
  "homepage": "https://github.com/affise/affise-mmp-sdk-ios",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Affise": "support@affise.com"
  },
  "source": {
    "git": "https://github.com/affise/affise-mmp-sdk-ios.git",
    "tag": "1.7.18",
    "submodules": true
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.7",
  "static_framework": true,
  "dependencies": {
    "AffiseAttributionLib": [
      "1.7.18"
    ]
  },
  "subspecs": [
    {
      "name": "AdService",
      "resource_bundles": {
        "AffiseModuleAdServicePrivacy": [
          "AffiseModule/AdService/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/AdService/Classes/**/*.{swift}",
      "frameworks": "AdServices"
    },
    {
      "name": "Advertising",
      "resource_bundles": {
        "AffiseModuleAdvertisingPrivacy": [
          "AffiseModule/Advertising/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Advertising/Classes/**/*.{swift}"
    },
    {
      "name": "AppsFlyer",
      "resource_bundles": {
        "AffiseModuleAppsFlyerPrivacy": [
          "AffiseModule/AppsFlyer/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/AppsFlyer/Classes/**/*.{swift}"
    },
    {
      "name": "Google",
      "resource_bundles": {
        "AffiseModuleGooglePrivacy": [
          "AffiseModule/Google/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Google/Classes/**/*.{swift}",
      "dependencies": {
        "GoogleAdsOnDeviceConversion": [

        ]
      }
    },
    {
      "name": "Hardware",
      "resource_bundles": {
        "AffiseModuleHardwarePrivacy": [
          "AffiseModule/Hardware/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Hardware/Classes/**/*.{swift}"
    },
    {
      "name": "Link",
      "resource_bundles": {
        "AffiseModuleLinkPrivacy": [
          "AffiseModule/Link/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Link/Classes/**/*.{swift}"
    },
    {
      "name": "Persistent",
      "resource_bundles": {
        "AffiseModulePersistentPrivacy": [
          "AffiseModule/Persistent/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Persistent/Classes/**/*.{swift}"
    },
    {
      "name": "Status",
      "resource_bundles": {
        "AffiseModuleStatusPrivacy": [
          "AffiseModule/Status/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Status/Classes/**/*.{swift}"
    },
    {
      "name": "Subscription",
      "resource_bundles": {
        "AffiseModuleSubscriptionPrivacy": [
          "AffiseModule/Subscription/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/Subscription/Classes/**/*.{swift}",
      "frameworks": "StoreKit"
    },
    {
      "name": "TikTok",
      "resource_bundles": {
        "AffiseModuleTikTokPrivacy": [
          "AffiseModule/TikTok/PrivacyInfo.xcprivacy"
        ]
      },
      "source_files": "AffiseModule/TikTok/Classes/**/*.{swift}"
    }
  ],
  "swift_version": "5.7"
}

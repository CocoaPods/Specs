{
  "name": "CloudXGAMPrebid",
  "version": "1.0.0",
  "summary": "CloudX iOS Google Ad Manager prebid integration - Static Framework",
  "description": "A zero-SDK facade integration for the CloudX iOS SDK that lets publishers surface CloudX demand as prebid line items in Google Ad Manager - binary distribution. Supports Banner, MREC, Interstitial, Rewarded, and Native ad formats.",
  "homepage": "https://github.com/cloudx-io/cloudx-ios",
  "license": {
    "type": "Business Source License 1.1"
  },
  "authors": {
    "CloudX": "support@cloudx.io"
  },
  "source": {
    "git": "https://github.com/cloudx-io/cloudx-ios.git",
    "tag": "integration-gam-prebid/1.0.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "vendored_frameworks": "integration-gam-prebid/CloudXGAMPrebid.xcframework",
  "dependencies": {
    "CloudXCore": [
      ">= 3.8.0"
    ],
    "Google-Mobile-Ads-SDK": [
      "~> 13.0"
    ]
  },
  "frameworks": [
    "Foundation"
  ],
  "weak_frameworks": [
    "GoogleMobileAds"
  ],
  "requires_arc": true,
  "static_framework": true,
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "swift_versions": [
    "5.0",
    "5.1",
    "5.2",
    "5.3",
    "5.4",
    "5.5",
    "5.6",
    "5.7",
    "5.8",
    "5.9",
    "6.0",
    "6.1",
    "6.2"
  ],
  "swift_version": "6.2"
}

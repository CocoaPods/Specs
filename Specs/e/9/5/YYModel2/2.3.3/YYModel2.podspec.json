{
  "name": "YYModel2",
  "summary": "High performance JSON model framework for iOS/macOS. Maintained fork of ibireme/YYModel.",
  "version": "2.3.3",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "ibireme": "ibireme@gmail.com",
    "leeeeeeeefulong": "leeeeeeeefulong@github.com"
  },
  "homepage": "https://github.com/leeeeeeeefulong/YYModel",
  "platforms": {
    "ios": "11.0",
    "osx": "10.13"
  },
  "source": {
    "git": "https://github.com/leeeeeeeefulong/YYModel.git",
    "tag": "2.3.3"
  },
  "requires_arc": true,
  "default_subspecs": [
    "ObjC",
    "Swift"
  ],
  "frameworks": [
    "Foundation",
    "CoreFoundation"
  ],
  "swift_versions": [
    "5.0",
    "6.0"
  ],
  "subspecs": [
    {
      "name": "ObjC",
      "source_files": "YYModel/*.{h,m}",
      "public_header_files": "YYModel/*.{h}",
      "resource_bundles": {
        "YYModel2": [
          "PrivacyInfo.xcprivacy"
        ]
      }
    },
    {
      "name": "Swift",
      "source_files": "YYModelSwift/*.swift"
    }
  ],
  "swift_version": "6.0"
}

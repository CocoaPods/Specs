{
  "name": "PushPilot",
  "version": "2.2.0",
  "summary": "Registers an iOS app installation with PushPilot and handles its pushes and taps.",
  "description": "Forwards the APNs device token to PushPilot, records taps on PushPilot pushes and opens their links. No Firebase.",
  "homepage": "https://github.com/pushpilotai/pushpilot-ios",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": {
    "PushPilot": "https://pushpilot.ai"
  },
  "source": {
    "git": "https://github.com/pushpilotai/pushpilot-ios.git",
    "tag": "2.2.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "source_files": "Sources/PushPilot/**/*.swift",
  "resource_bundles": {
    "PushPilot": [
      "Sources/PushPilot/PrivacyInfo.xcprivacy"
    ]
  },
  "dependencies": {
    "PushPilotLive": [
      "2.2.0"
    ]
  },
  "swift_version": "5.9"
}

{
  "name": "AppwinNotifications",
  "version": "1.0.0",
  "summary": "Appwin Notifications SDK - push token, events, in-app messages.",
  "description": "Notifications module of the Appwin SDK. Asks for the push permission,\nregisters the APNs token, routes Appwin pushes, and fetches and presents\nthe pending in-app messages. Depends on AppwinCore for identity and\ntransport.",
  "homepage": "https://appwin.io",
  "license": {
    "type": "Proprietary",
    "text": "Copyright Appwin Studio"
  },
  "authors": {
    "Appwin": "lesignobles.studio@gmail.com"
  },
  "source": {
    "git": "https://github.com/appwin-dev/appwin-ios.git",
    "tag": "1.0.0"
  },
  "source_files": "Sources/AppwinNotifications/**/*.swift",
  "resource_bundles": {
    "AppwinNotifications": [
      "Sources/AppwinNotifications/Resources/**/*"
    ]
  },
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": "6.0",
  "frameworks": "Foundation",
  "dependencies": {
    "AppwinCore": [
      "1.0.0"
    ]
  },
  "pod_target_xcconfig": {
    "OTHER_SWIFT_FLAGS": "$(inherited) -package-name Appwin",
    "DEFINES_MODULE": "YES"
  },
  "swift_version": "6.0"
}

{
  "name": "ZJAFNetworking",
  "version": "1.0.3",
  "summary": "Custom AFNetworking fork",
  "homepage": "https://github.com/dale454071867/AFNetworking_ZJ",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "ZJ": "454071867@qq.com"
  },
  "source": {
    "git": "https://github.com/dale454071867/AFNetworking_ZJ.git",
    "tag": "1.0.3"
  },
  "requires_arc": true,
  "platforms": {
    "ios": "12.0",
    "osx": "10.13"
  },
  "ios": {
    "source_files": [
      "AFNetworking/**/*.{h,m}",
      "UIKit+AFNetworking/**/*.{h,m}"
    ],
    "frameworks": [
      "MobileCoreServices",
      "CoreGraphics"
    ]
  },
  "osx": {
    "source_files": "AFNetworking/**/*.{h,m}"
  },
  "frameworks": [
    "Security",
    "SystemConfiguration"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  }
}

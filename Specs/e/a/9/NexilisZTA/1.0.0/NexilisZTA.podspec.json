{
  "name": "NexilisZTA",
  "version": "1.0.0",
  "summary": "NexilisZTA Framework",
  "description": "Zero Trust Architecture hardening for iOS: RASP (jailbreak, debugger, Frida, injection,\ninline/GOT hooks, code signature), App Attest device attestation with key delivery,\ncertificate pinning with rotation, secure input, privacy shield, and session teardown.",
  "homepage": "https://nexilis.io/",
  "license": "MIT",
  "authors": {
    "Nexilis": "ya2n.wicaksono@gmail.com"
  },
  "platforms": {
    "ios": "15.0"
  },
  "source": {
    "git": "https://github.com/alqindiirsyam-es/NexilisZTA.git",
    "tag": "1.0.0"
  },
  "source_files": "NexilisZTA/Source/**/*",
  "swift_versions": "5.5.1",
  "public_header_files": "NexilisZTA/Source/**/*.h",
  "frameworks": [
    "Foundation",
    "UIKit",
    "DeviceCheck",
    "CryptoKit",
    "Security",
    "CoreLocation",
    "WebKit",
    "OSLog",
    "SystemConfiguration",
    "LocalAuthentication"
  ],
  "pod_target_xcconfig": {
    "ENABLE_BITCODE": "NO",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_CXX_LIBRARY": "libc++"
  },
  "user_target_xcconfig": {
    "ENABLE_BITCODE": "NO"
  },
  "swift_version": "5.5.1"
}

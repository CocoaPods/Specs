{
  "name": "WiseAdSDKGroMore",
  "version": "1.0.0",
  "summary": "GroMore custom adapter for WiseAdSDK",
  "description": "GroMore（穿山甲聚合）自定义适配层，将 WiseAdSDK 广告能力桥接到 GroMore。默认使用二进制（Binary），调试时可在 Podfile 中指定 :subspecs => [\"Source\"]。",
  "homepage": "https://github.com/556445543/WiseAdSDK-iOS",
  "license": {
    "type": "Commercial",
    "text": "Copyright"
  },
  "authors": {
    "WiseMedia": "sdk@wisemedia.com"
  },
  "source": {
    "http": "https://github.com/556445543/WiseAdSDK-iOS/releases/download/1.0.0-gromore/WiseAdSDKGroMore-1.0.0.zip",
    "sha256": "2fdc7d8ef6597578a02f98ce1089b23c53419c9caf95264220962b19cb7d3b09"
  },
  "platforms": {
    "ios": "11.0"
  },
  "requires_arc": true,
  "default_subspecs": "Binary",
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  },
  "subspecs": [
    {
      "name": "Binary",
      "ios": {
        "vendored_frameworks": "WiseAdSDKGroMore.xcframework"
      },
      "dependencies": {
        "WiseAdSDK": [
          "~> 1.1"
        ],
        "Ads-CN/CSJMediation": [

        ]
      }
    },
    {
      "name": "Source",
      "source_files": "WiseAdSDKGroMore/*.{h,m}",
      "dependencies": {
        "WiseAdSDK": [
          "~> 1.1"
        ],
        "Ads-CN/CSJMediation": [

        ]
      }
    }
  ]
}

{
  "name": "BearoundSDKNotificationExtensions",
  "version": "3.14.0",
  "summary": "Notification Service and Content extensions for Bearound rich push on iOS.",
  "description": "Ready-made app extension classes for Bearound rich push: a Notification Service Extension that attaches the image or video of a push, and a Notification Content Extension that draws the image, two-card and carousel layouts. Ships separately from BearoundSDK and does not depend on it.",
  "homepage": "https://github.com/Bearound/bearound-ios-sdk",
  "documentation_url": "https://github.com/Bearound/bearound-ios-sdk/blob/main/README.md#rich-push-images-carousel-video",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Felipe Araujo": "felipe.araujo@opencircle.com.br"
  },
  "platforms": {
    "ios": "13.0"
  },
  "source": {
    "git": "https://github.com/Bearound/bearound-ios-sdk.git",
    "tag": "v3.14.0"
  },
  "module_name": "BearoundSDKNotificationExtensions",
  "pod_target_xcconfig": {
    "APPLICATION_EXTENSION_API_ONLY": "YES"
  },
  "swift_versions": "5.0",
  "source_files": [
    "NotificationService/**/*.{swift}",
    "NotificationContent/**/*.{swift}",
    "NotificationShared/**/*.{swift}",
    "BearoundSDK/RichPush/**/*.{swift}"
  ],
  "frameworks": [
    "Foundation",
    "UIKit",
    "UserNotifications",
    "UserNotificationsUI",
    "ImageIO"
  ],
  "swift_version": "5.0"
}

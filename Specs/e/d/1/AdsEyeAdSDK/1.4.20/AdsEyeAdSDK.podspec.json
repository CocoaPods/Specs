{
  "name": "AdsEyeAdSDK",
  "version": "1.4.20",
  "summary": "AdsEyeAdSDK 包含图文广告、组图广告、横幅广告、视频广告和启动广告",
  "description": "AdsEyeAdSDK 是移动广告解决方案。",
  "homepage": "https://git.qutoutiao.net/CPC/adseyesdk-ios",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "qushiyu": "qushiyu@qutoutiao.net"
  },
  "source": {
    "http": "https://docs.qttunion.com/adseye_sdk_ios/1.4.20/AdsEyeAdSDK-1.4.20-09021407.zip"
  },
  "platforms": {
    "ios": "11.0"
  },
  "requires_arc": true,
  "frameworks": [
    "UIKit",
    "Foundation",
    "Security"
  ],
  "xcconfig": {
    "ENABLE_BITCODE": "NO",
    "OTHER_LDFLAGS": "-ObjC"
  },
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "vendored_frameworks": "AdsEyeAdSDK/AdsEyeAdSDK/**/*.xcframework",
      "resources": "AdsEyeAdSDK/AdsEyeAdSDK/**/*.bundle",
      "frameworks": [
        "UIKit",
        "Foundation",
        "Security"
      ],
      "xcconfig": {
        "ENABLE_BITCODE": "NO",
        "OTHER_LDFLAGS": "-ObjC"
      }
    },
    {
      "name": "TopOn",
      "vendored_frameworks": "AdsEyeAdSDK/AdsEyeTopOnAdapter/**/*.xcframework",
      "dependencies": {
        "AdsEyeAdSDK/Core": [

        ],
        "TPNiOS": [

        ],
        "AppLovinSDK": [

        ]
      }
    },
    {
      "name": "Tradplus",
      "vendored_frameworks": "AdsEyeAdSDK/AdsEyeTPAdapter/**/*.xcframework",
      "dependencies": {
        "AdsEyeAdSDK/Core": [

        ],
        "TradPlusAdSDK": [

        ]
      }
    },
    {
      "name": "AppLovin",
      "vendored_frameworks": "AdsEyeAdSDK/AdsEyeAppLovinAdapter/**/*.xcframework",
      "dependencies": {
        "AdsEyeAdSDK/Core": [

        ],
        "AppLovinSDK": [

        ]
      }
    },
    {
      "name": "Admob",
      "vendored_frameworks": "AdsEyeAdSDK/AdsEyeAdmobAdapter/**/*.xcframework",
      "dependencies": {
        "AdsEyeAdSDK/Core": [

        ],
        "Google-Mobile-Ads-SDK": [

        ]
      }
    },
    {
      "name": "ADXSDK",
      "vendored_frameworks": "AdsEyeAdSDK/AdsEyeADXSDK/**/*.xcframework",
      "resources": "AdsEyeAdSDK/AdsEyeADXSDK/**/*.bundle",
      "dependencies": {
        "AdsEyeAdSDK/Core": [

        ]
      }
    }
  ]
}

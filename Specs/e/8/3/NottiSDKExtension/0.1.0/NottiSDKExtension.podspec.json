{
  "name": "NottiSDKExtension",
  "version": "0.1.0",
  "summary": "Notification Service Extension rich media for Zeep Notti.",
  "description": "Downloads and attaches the image, video or audio of a Zeep Notti push from a\nNotification Service Extension. Extension-safe; never depends on NottiSDK.",
  "homepage": "https://github.com/zeeplabs/zeep-notti-ios-sdk",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Zeep Tecnologia": "opensource@zeeplabs.com.br"
  },
  "source": {
    "git": "https://github.com/zeeplabs/zeep-notti-ios-sdk.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5"
  ],
  "cocoapods_version": ">= 1.12",
  "pod_target_xcconfig": {
    "OTHER_SWIFT_FLAGS": "$(inherited) -package-name NottiSDK"
  },
  "source_files": [
    "Sources/NottiShared/**/*.swift",
    "Sources/NottiSDKExtension/**/*.swift"
  ],
  "resource_bundles": {
    "NottiSDKExtension_Privacy": [
      "Sources/NottiSDKExtension/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "swift_version": "5"
}

{
  "name": "MobileWebBridge",
  "version": "0.1.9",
  "summary": "Swift Web container powered by DSBridge",
  "homepage": "https://github.com/gaoxiao228/MobileWebBridge",
  "license": {
    "type": "MIT",
    "file": "MWB-iOS/LICENSE"
  },
  "authors": "gaoxiao228",
  "source": {
    "git": "https://github.com/gaoxiao228/MobileWebBridge.git",
    "tag": "0.1.9"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "source_files": [
    "MWB-iOS/Sources/**/*.{swift,h,m}",
    "MWB-iOS/Vendor/DSBridge/*.{h,m}"
  ],

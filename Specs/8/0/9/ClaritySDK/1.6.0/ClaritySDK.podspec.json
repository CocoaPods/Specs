{
  "name": "ClaritySDK",
  "version": "1.6.0",
  "summary": "In-app customer support chat for iOS — the Clarity support widget.",
  "description": "Native-feel support chat: a pre-warmed WKWebView presented as a bottom\nsheet or full screen, with user identity, typed custom attributes, product\nevents, an unread badge and APNs push routing. Zero third-party\ndependencies.",
  "homepage": "https://github.com/Anecdote-AI/clarity-ios-sdk",
  "authors": {
    "Clarity": "support@onclarity.com"
  },
  "license": {
    "type": "Proprietary",
    "text": "Copyright Anecdote AI. All rights reserved."
  },
  "source": {
    "git": "https://github.com/Anecdote-AI/clarity-ios-sdk.git",
    "tag": "v1.6.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5.10"
  ],
  "default_subspecs": "Core",
  "pod_target_xcconfig": {
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) CLARITY_COCOAPODS"
  },
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/ClaritySDK/**/*.swift",
      "frameworks": [
        "UIKit",
        "WebKit",
        "UserNotifications",
        "AVFAudio",
        "Network"
      ]
    },
    {
      "name": "Location",
      "dependencies": {
        "ClaritySDK/Core": [

        ]
      },
      "source_files": "Sources/ClarityLocation/**/*.swift",
      "frameworks": "CoreLocation"
    }
  ],
  "swift_version": "5.10"
}

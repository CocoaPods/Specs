{
  "name": "YandexLoginSDK",
  "version": "3.2.0",
  "summary": "A library that helps third-party applications authorize in Yandex Services.",
  "homepage": "https://yandex.ru/dev/id/doc/",
  "license": {
    "type": "Proprietary",
    "text": "2024 © Yandex. All rights reserved."
  },
  "authors": {
    "Yandex LLC": "ios-dev@yandex-team.ru"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.0",
  "source": {
    "git": "https://github.com/yandexmobile/yandex-login-sdk-ios.git",
    "tag": "3.2.0"
  },
  "source_files": [
    "Sources/**/*",
    "Vendor/CertificateTransparency/*.{h,mm,cc}"
  ],
  "public_header_files": "Vendor/CertificateTransparency/CertificateTransparency.h",
  "private_header_files": "Vendor/CertificateTransparency/{auto_*,builtin_*,crypto_*,ct_*,ec_*,internal_*,log_*,multi_*,public_*,rsa_*,safe_*}.h",
  "exclude_files": "Vendor/CertificateTransparency/include/**/*",
  "preserve_paths": [
    "Vendor/CertificateTransparency/LICENSE",
    "Vendor/CertificateTransparency/UPSTREAM.md"
  ],
  "libraries": "c++",
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "CLANG_CXX_LIBRARY": "libc++"
  },
  "frameworks": [
    "UIKit",
    "Security",
    "CryptoKit",
    "WebKit"
  ],
  "compiler_flags": [
    "-Werror",
    "-Wno-shorten-64-to-32",
    "-Wno-documentation-deprecated-sync",
    "-Wall",
    "-Wsign-compare",
    "-Wdocumentation-unknown-command",
    "-Wdocumentation",
    "-Wnewline-eof",
    "-Woverriding-method-mismatch",
    "-Wsuper-class-method-mismatch"
  ],
  "swift_version": "5.0"
}

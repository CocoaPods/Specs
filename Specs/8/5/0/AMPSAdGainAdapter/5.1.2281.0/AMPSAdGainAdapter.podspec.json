{
  "name": "AMPSAdGainAdapter",
  "version": "5.1.2281.0",
  "summary": "AMPS 聚合 SDK AdGain（数字悦动）渠道适配器",
  "description": "AMPS 聚合 SDK 的 AdGain 广告渠道适配器，支持开屏、插屏、\n激励视频、原生模板及自渲染原生广告类型。\n内部依赖 AdGainSDK 4.2.7.3，宿主 App 无需单独引入。\n以二进制 XCFramework 分发，仅暴露 AMPSAdGainAdapter.h 公共头文件。",
  "homepage": "https://gitee.com/adscope_admin/AMPSAdGainAdapter.git",
  "license": {
    "type": "Proprietary"
  },
  "authors": {
    "AdScope": "dev@adscope.com.cn"
  },
  "platforms": {
    "ios": "11.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "source": {
    "git": "https://gitee.com/adscope_admin/AMPSAdGainAdapter.git",
    "tag": "5.1.2281.0"
  },
  "vendored_frameworks": "AMPSAdGainAdapter.xcframework",
  "dependencies": {
    "AdGainSDK": [
      "4.2.7.3"
    ]
  },
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  }
}

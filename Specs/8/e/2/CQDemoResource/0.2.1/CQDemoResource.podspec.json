{
  "name": "CQDemoResource",
  "version": "0.2.1",
  "summary": "Demo",
  "homepage": "https://github.com/dvlproad/001-UIKit-CQDemo-iOS",
  "description": "DemoResource，可按需独立引入：\n• CQDemoResource/Core - Core - 源码，不含资源\n• CQDemoResource/Images - Images - jpg, png, webp, heic\n• CQDemoResource/Images_Big - Images - jpg_big\n• CQDemoResource/GIF - GIF - GIF\n• CQDemoResource/SVG - SVG - SVG 文件\n• CQDemoResource/Videos - Videos - mp4, mov\n\n每个子库可独立引入，详见各子库描述。",
  "license": "MIT",
  "authors": {
    "dvlproad": ""
  },
  "platforms": {
    "ios": "11.0"
  },
  "source": {
    "git": "https://github.com/dvlproad/001-UIKit-CQDemo-iOS.git",
    "tag": "CQDemoResource_0.2.1"
  },
  "frameworks": "UIKit",
  "requires_arc": true,
  "resource_bundles": {
    "CQDemoResource": [
      "CQDemoResource/Resources/*.{xcassets}"
    ]
  },
  "subspecs": [
    {
      "name": "Core",
      "source_files": "CQDemoResource/**/*.{h,m}",
      "dependencies": {
        "CQDemoKit/Demo_Resource": [

        ]
      }
    },
    {
      "name": "Images",
      "dependencies": {
        "CQDemoResource/Core": [

        ]
      },
      "resource_bundles": {
        "CQDemoResource": [
          "CQDemoResource/Resources/jpg/**/*",
          "CQDemoResource/Resources/png/**/*",
          "CQDemoResource/Resources/webp/**/*",
          "CQDemoResource/Resources/heic/**/*"
        ]
      }
    },
    {
      "name": "Images_Big",
      "dependencies": {
        "CQDemoResource/Core": [

        ]
      },
      "resource_bundles": {
        "CQDemoResource": [
          "CQDemoResource/Resources/jpg_big/**/*"
        ]
      }
    },
    {
      "name": "GIF",
      "dependencies": {
        "CQDemoResource/Core": [

        ]
      },
      "resource_bundles": {
        "CQDemoResource": [
          "CQDemoResource/Resources/GIF/**/*"
        ]
      }
    },
    {
      "name": "SVG",
      "dependencies": {
        "CQDemoResource/Core": [

        ]
      },
      "resource_bundles": {
        "CQDemoResource": [
          "CQDemoResource/Resources/SVG/**/*"
        ]
      }
    },
    {
      "name": "Videos",
      "dependencies": {
        "CQDemoResource/Core": [

        ]
      },
      "resource_bundles": {
        "CQDemoResource": [
          "CQDemoResource/Resources/mp4/**/*",
          "CQDemoResource/Resources/mov/**/*"
        ]
      }
    }
  ]
}

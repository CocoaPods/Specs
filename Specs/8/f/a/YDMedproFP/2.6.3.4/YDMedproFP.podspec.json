{
  "name": "YDMedproFP",
  "version": "2.6.3.4",
  "summary": "YDMedproFP 广告 SDK",
  "description": "YDMedproFP 是 MedproFP 广告源 SDK，提供开屏、激励视频、插屏、信息流等广告能力。",
  "homepage": "https://gitee.com/mergex/ydmedprofpsdk.git",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "ahhsxp": "ahhsxp@163.com"
  },
  "source": {
    "git": "https://gitee.com/mergex/ydmedprofpsdk.git",
    "tag": "2.6.3.4"
  },
  "platforms": {
    "ios": "11.0"
  },
  "frameworks": [
    "Foundation",
    "UIKit",
    "MobileCoreServices",
    "CoreGraphics",
    "Security",
    "SystemConfiguration",
    "CoreTelephony",
    "AdSupport",
    "CoreData",
    "StoreKit",
    "AVFoundation",
    "MediaPlayer",
    "CoreMedia",
    "WebKit",
    "Accelerate",
    "CoreLocation",
    "CoreMotion"
  ],
  "libraries": [
    "resolv.9",
    "c++",
    "z",
    "sqlite3",
    "bz2",
    "xml2",
    "c++abi",
    "sqlite3.0",
    "iconv"
  ],
  "pod_target_xcconfig": {
    "VALID_ARCHS": "x86_64 armv7 arm64",
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386,arm64"
  },
  "xcconfig": {
    "ENABLE_BITCODE": "NO",
    "OTHER_LDFLAGS": "-ObjC"
  },
  "vendored_frameworks": [
    "MedproFP/MedproFP/MedproFPSDK.framework",
    "MedproFP/MedproFP/MedproFPSDKCore.framework",
    "MedproFP/MedproFP/MedproFPDspModuleSDK.xcframework"
  ],
  "resources": "MedproFP/MedproFP/MedproFP_DSPBundle.bundle"
}

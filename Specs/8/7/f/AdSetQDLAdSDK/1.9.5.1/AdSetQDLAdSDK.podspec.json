{
  "name": "AdSetQDLAdSDK",
  "version": "1.9.5.1",
  "summary": "趣盟 L 渠道 iOS 广告 SDK 二进制包",
  "description": "趣盟 AdSetQDLAdSDK 1.9.5.1 的 XCFramework 分发包，包含 iOS 框架、随附广告资源及隐私清单。",
  "homepage": "https://github.com/OSETSDK/AdSetQDLAdSDK",
  "license": {

    "text": "MIT is the license type declared in the publisher-supplied podspec. See NOTICE for the publisher attribution and the delivery package license information."
  },
  "authors": {
    "chenxin02": "chenxin02@qutoutiao.net"
  },
  "source": {
    "git": "https://github.com/OSETSDK/AdSetQDLAdSDK.git",
    "tag": "1.9.5.1"
  },
  "platforms": {
    "ios": "11.0"
  },
  "swift_versions": "5.1",
  "vendored_frameworks": "AdSetQDLAdSDK.xcframework",
  "frameworks": [
    "UIKit",
    "CoreLocation",
    "SystemConfiguration",
    "CoreGraphics",
    "CoreMotion",
    "CoreTelephony",
    "AdSupport",
    "QuartzCore",
    "WebKit",
    "MessageUI",
    "SafariServices",
    "AVFoundation",
    "EventKit",
    "CoreMedia",
    "StoreKit",
    "Accelerate",
    "CFNetwork",
    "CoreFoundation",
    "Foundation",
    "ImageIO",
    "JavaScriptCore",
    "LocalAuthentication",
    "MobileCoreServices",
    "Security"
  ],
  "weak_frameworks": "DeviceCheck",
  "libraries": [
    "sqlite3",
    "z"
  ],
  "static_framework": true,
  "resources": [
    "AdSetQDLAdBundle.bundle",
    "AdSetQDLAdSDKPrivacy.bundle"
  ],
  "xcconfig": {
    "ENABLE_BITCODE": "NO",
    "OTHER_LDFLAGS": "-ObjC"
  },
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "swift_version": "5.1"

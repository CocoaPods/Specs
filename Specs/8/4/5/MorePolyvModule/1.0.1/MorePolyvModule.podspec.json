{
  "name": "MorePolyvModule",
  "version": "1.0.1",
  "summary": "Moreschool Polyv live-room integration module.",
  "description": "Encapsulates Polyv SDK configuration, viewer identity and live-room login for\nMoreschool applications. Product UI and application account logic stay outside\nthe module.",
  "homepage": "https://codeup.aliyun.com/5efd775a0e73ad738218aab0/MorePolyvModule",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Moreschool iOS Team": "yklsdq@163.com"
  },
  "source": {
    "git": "ssh://git@codeup.aliyun.com/5efd775a0e73ad738218aab0/MorePolyvModule.git",
    "tag": "1.0.1"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "requires_arc": true,
  "static_framework": true,
  "source_files": [
    "Sources/*.{h,m}",
    "Sources/Public/**/*.{h,m}",
    "Sources/Polyv/PLVLiveCommonModule/**/*.{h,m}",
    "Sources/Polyv/PLVLiveCloudClassScene/**/*.{h,m}",
    "Sources/Polyv/PLVLiveEcommerceScene/**/*.{h,m}"
  ],
  "exclude_files": [
    "Sources/Polyv/PLVLiveCommonModule/Modules/Streamer/**/*",
    "Sources/Polyv/PLVLiveCommonModule/GeneralUI/PLVVirtualBackgroundSheet/**/*",
    "Sources/Polyv/PLVLiveCommonModule/Modules/Interact/PLVStreamerInteractGenericView.{h,m}",
    "Sources/Polyv/PLVLiveCommonModule/Modules/LiveRoom/PLVStreamerPopoverView.{h,m}"
  ],
  "public_header_files": [
    "Sources/Public/**/*.h",
    "Sources/Polyv/PLVLiveCommonModule/**/*.h",
    "Sources/Polyv/PLVLiveCloudClassScene/**/*.h",
    "Sources/Polyv/PLVLiveEcommerceScene/**/*.h"
  ],
  "prefix_header_contents": "#import <MJRefresh/MJRefresh.h>",
  "resources": [
    "Sources/Polyv/PLVLiveCommonModule/**/*.bundle",
    "Sources/Polyv/PLVLiveCloudClassScene/**/*.bundle",
    "Sources/Polyv/PLVLiveEcommerceScene/**/*.bundle"
  ],
  "frameworks": [
    "Foundation",
    "UIKit",
    "AVFoundation",
    "AudioToolbox",
    "MediaPlayer",
    "Photos",
    "QuartzCore",
    "ReplayKit",
    "WebKit"
  ],
  "dependencies": {
    "PLVLiveScenesSDK/Core": [
      "1.36.0"
    ],
    "PLVLiveScenesSDK/BaseSDK": [
      "1.36.0"
    ],
    "PLVLiveScenesSDK/Player": [
      "1.36.0"
    ],
    "PLVBusinessSDK/Beauty": [
      "1.34.0"
    ],
    "PLVFoundationSDK/CryptoUtils": [
      "1.34.0"
    ],
    "AgoraRtcEngine_iOS": [
      "4.5.0"
    ],
    "PLVVolcEngineRTCExt": [
      "3.41.304"
    ],
    "TXLiteAVSDK_Professional": [
      "12.2.16945"
    ],
    "PLVSocketIOClientSwift": [
      "~> 0.2.1"
    ],
    "PLVAliHttpDNS": [
      "3.2.0"
    ],
    "AliyunOSSiOS": [
      "~> 2.10.8"
    ],
    "PLVModel": [
      "~> 1.0.4"
    ],
    "PLVFDB": [
      "~> 1.0.6"
    ],
    "PLVDLNA": [
      "0.2.0"
    ],
    "PLVBeautyEffect": [
      "1.4.0"
    ],
    "PLVImagePickerController": [
      "~> 3.8.9"
    ],
    "SVGAPlayer": [
      "~> 2.3"
    ],
    "Protobuf": [
      "3.22.4"
    ],
    "MJRefresh": [
      "~> 3.5.0"
    ],
    "SDWebImage": [
      "5.21.2"
    ]
  },
  "swift_version": "5.0"
}

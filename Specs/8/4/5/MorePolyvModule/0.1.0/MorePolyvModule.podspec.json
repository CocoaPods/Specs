{
  "name": "MorePolyvModule",
  "version": "0.1.0",
  "summary": "Moreschool Polyv live-room integration module.",
  "description": "Encapsulates Polyv SDK configuration, viewer identity and live-room login for\nMoreschool applications. Product UI and application account logic stay outside\nthe module.",
  "homepage": "https://codeup.aliyun.com/5efd775a0e73ad738218aab0/MorePolyvModule",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Moreschool iOS Team": "yklsdq@163.com"
  },
  "source": {
    "git": "ssh://git@codeup.aliyun.com/5efd775a0e73ad738218aab0/MorePolyvModule.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "requires_arc": true,
  "static_framework": true,
  "source_files": "Sources/**/*.{h,m}",
  "exclude_files": [
    "Sources/Polyv/PLVLiveCommonModule/GeneralUI/PLVImagePicker/**/*",
    "Sources/Polyv/PLVLiveCommonModule/GeneralUI/PLVReward/PLVRewardSvgaTask.{h,m}",
    "Sources/Polyv/PLVLiveCommonModule/GeneralUI/PLVReward/View/PLVRewardSvgaView.{h,m}"
  ],
  "public_header_files": [
    "Sources/Public/**/*.h",
    "Sources/Polyv/**/*.h"
  ],
  "prefix_header_contents": "#import <MJRefresh/MJRefresh.h>",
  "resources": "Sources/Polyv/**/*.bundle",
  "frameworks": [
    "Foundation",
    "UIKit",
    "AVFoundation",
    "AudioToolbox",
    "MediaPlayer",
    "Photos",
    "QuartzCore",
    "ReplayKit",
    "WebKit"
  ],
  "dependencies": {
    "PLVLiveScenesSDK/Core": [
      "~> 1.16.3"
    ],
    "PLVLiveScenesSDK/BaseSDK": [
      "~> 1.16.3"
    ],
    "PLVLiveScenesSDK/Player": [
      "~> 1.16.3"
    ],
    "PLVSocketIOClientSwift": [

    ],
    "PLVAliHttpDNS": [
      "1.11.0"
    ],
    "PLVModel": [

    ],
    "MJRefresh": [
      "~> 3.5.0"
    ],
    "SDWebImage": [
      "5.20.0"
    ]
  },
  "swift_version": "5.0"
}

{
  "name": "SwiftyUI",
  "version": "3.0.0",
  "summary": "High performance and lightweight UI.",
  "description": "High performance and lightweight (one class per UI component) UIView, UIImage, UIImageView, UILabel, UIButton and more.",
  "homepage": "https://github.com/haoking/SwiftyUI",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Haochen Wang": "haokinus@gmail.com"
  },
  "platforms": {
    "ios": "18.0"
  },
  "swift_versions": "6.0",
  "pod_target_xcconfig": {
    "SWIFT_UPCOMING_FEATURE_NONISOLATED_NONSENDING_BY_DEFAULT": "YES",
    "SWIFT_UPCOMING_FEATURE_INFER_ISOLATED_CONFORMANCES": "YES",
    "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
    "SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY": "YES",
    "SWIFT_UPCOMING_FEATURE_INTERNAL_IMPORTS_BY_DEFAULT": "YES"
  },
  "cocoapods_version": ">= 1.4.0",
  "source": {
    "git": "https://github.com/haoking/SwiftyUI.git",
    "tag": "3.0.0"
  },
  "source_files": "Sources/*.swift",
  "swift_version": "6.0"
}

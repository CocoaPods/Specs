{
  "name": "FitCloudKit",
  "version": "1.3.2",
  "summary": "和唐公司智能手表SDK",
  "description": "FitCloudPro智能手表iOS开发框架，提供与手表设备通信等功能的封装。\nThe iOS framework for FitCloudPro smartwatch, encapsulating features like device communication.",
  "homepage": "https://github.com/htangsmart/FitCloudPro-SDK-iOS/tree/1.3.2/FitCloudKit",
  "license": "MIT",
  "authors": {
    "pcjbird": "pcjbird@hotmail.com"
  },
  "source": {
    "git": "https://github.com/htangsmart/FitCloudPro-SDK-iOS.git",
    "tag": "1.3.2"
  },
  "social_media_url": "http://www.hetangsmart.com",
  "requires_arc": true,
  "documentation_url": "https://github.com/htangsmart/FitCloudPro-SDK-iOS/blob/master/FitCloudKit/README.md",
  "changelog": "https://github.com/htangsmart/FitCloudPro-SDK-iOS/blob/master/FitCloudKit/CHANGELOG.md",
  "screenshots": "https://github.com/htangsmart/FitCloudPro-SDK-iOS/blob/master/FitCloudKit/logo.png",
  "platforms": {
    "ios": "15.0"
  },
  "frameworks": [
    "Foundation",
    "CoreBluetooth",
    "CoreGraphics"
  ],
  "default_subspecs": "Core",
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "subspecs": [
    {
      "name": "Core",
      "vendored_frameworks": "FitCloudKit/FitCloudKit.xcframework",
      "resources": "FitCloudKit/FitCloudKit.bundle"
    },
    {
      "name": "OfflineMaps",
      "platforms": {
        "ios": "15.0"
      },
      "dependencies": {
        "FitCloudKit/Core": [

        ]
      },
      "vendored_frameworks": "FitCloudKit/FitCloudOfflineMaps.xcframework",
      "user_target_xcconfig": {
        "OTHER_LDFLAGS": "$(inherited) -ObjC"
      }
    },
    {
      "name": "WhatsApp",
      "platforms": {
        "ios": "15.0"
      },
      "dependencies": {
        "FitCloudKit/Core": [

        ]
      },
      "vendored_frameworks": [
        "FitCloudKit/FitCloudWhatsApp.xcframework",
        "FitCloudKit/Whatsappcore.xcframework"
      ],
      "user_target_xcconfig": {
        "OTHER_LDFLAGS": "$(inherited) -ObjC"
      }
    }
  ]
}

{
  "name": "SVOpenADSSDK",
  "version": "5.8.0",
  "summary": "SV Open Ads SDK binary distribution.",
  "description": "Precompiled SV Open Ads SDK. The implementation source is not distributed.",
  "homepage": "https://github.com/iOSorPython/SVOpenADSSDK",
  "license": {
    "type": "Proprietary",
    "text": "Copyright (c) SVOpenADSSDK."
  },
  "authors": {
    "iOSorPython": "forpenta@163.com"
  },
  "source": {
    "git": "https://github.com/iOSorPython/SVOpenADSSDK.git",
    "tag": "5.8.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "static_framework": true,
  "vendored_frameworks": "SVOpenADSSDK/Distribution/SVOpenADSSDK.xcframework",
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64 x86_64"
  },
  "user_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64 x86_64"
  },
  "frameworks": [
    "Foundation",
    "UIKit",
    "MobileCoreServices",
    "CoreGraphics",
    "Security",
    "SystemConfiguration",
    "CoreTelephony",
    "AdSupport",
    "StoreKit",
    "AVFoundation",
    "MediaPlayer",
    "WebKit",
    "CoreLocation"
  ],
  "libraries": [
    "z",
    "resolv.9",
    "sqlite3",
    "c++",
    "c++abi"
  ],
  "dependencies": {
    "ToBid-iOS-RC/GDTAdapter": [
      "5.8.0"
    ],
    "ToBid-iOS-RC/BaiduAdapter": [
      "5.8.0"
    ],
    "ToBid-iOS-RC/KSAdapter": [
      "5.8.0"
    ],
    "ToBid-iOS-RC/CSJAdapter": [
      "5.8.0"
    ],
    "ToBid-iOS-RC/GromoreAdapter": [
      "5.8.0"
    ]
  }
}

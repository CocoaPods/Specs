    "sunmomomo": "348384930@qq.com"
  },
  "source": {
    "git": "https://github.com/sunmomomo/BPush.git",
    "tag": "2.1.14"
  },
  "platforms": {
    "ios": "15.0"
  },
  "frameworks": [
    "Foundation",
    "CoreTelephony",
    "SystemConfiguration"
  ],
  "libraries": "z",
  "requires_arc": false,
  "default_subspecs": "normal",
  "pod_target_xcconfig": {
    "VALID_ARCHS": "arm64"
  },
  "subspecs": [
    {
      "name": "normal",
      "source_files": "File/normalversion/*.h",
      "public_header_files": "File/normalversion/*.h",
      "vendored_libraries": "File/normalversion/*.a"
    },
    {
      "name": "idfa",
      "source_files": "File/idfaversion/*.h",
      "public_header_files": "File/idfaversion/*.h",
      "vendored_libraries": "File/idfaversion/*.a"
    }
  ]
}

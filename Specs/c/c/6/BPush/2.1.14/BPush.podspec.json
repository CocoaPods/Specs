{
  "name": "BPush",
  "version": "2.1.14",
  "summary": "Baidu Push SDK for iOS.",
  "homepage": "https://github.com/sunmomomo/BPush",
  "license": {
    "type": "Copyright",
    "text": "LICENSE ©2015-2018 Baidu, Inc. All rights reserved"
  },

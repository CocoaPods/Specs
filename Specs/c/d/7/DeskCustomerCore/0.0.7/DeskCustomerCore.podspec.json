{
  "name": "DeskCustomerCore",
  "version": "0.0.7",
  "summary": "desk_customer · iOS Core SDK (V2TIM facade + KMP shared bridge)",
  "description": "智能客服坐席端 iOS Core SDK：包装 V2TIMManager 与 KMP 共享层，作为 UI/Bridge 的依赖底座。",
  "homepage": "https://github.com/desk-customer/desk_customer",
  "license": {
    "type": "Proprietary"
  },
  "authors": {
    "desk_customer": "desk@example.com"
  },
  "source": {
    "http": "https://customer.qcloudclass.com/workstation/ios/DeskCustomerCore/0.0.7/DeskCustomerCore-0.0.7.zip"
  },
  "platforms": {
    "ios": "14.0"
  },
  "swift_versions": "5.9",
  "requires_arc": true,
  "source_files": "Sources/DeskCustomerCore/**/*.{swift,h,m}",
  "exclude_files": "Sources/DeskCustomerCore/**/.gitkeep",
  "resource_bundles": {
    "DeskCustomerCore": [
      "Sources/DeskCustomerCore/Resources/**/*.lproj/*.strings"
    ]
  },
  "dependencies": {
    "TXIMSDK_Plus_iOS_XCFramework": [
      ">= 0.0.7"
    ],
    "WorkstationCccSdk": [
      ">= 0.0.7"
    ]
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14"
  },
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "-lc++"
  },
  "swift_version": "5.9"
}

{
  "name": "Flip-BLE",
  "version": "0.5.2",
  "summary": "An easy-to-use Bluetooth development framework for the iOS platform.",
  "description": "This framework is already in production. After several iterations,\nit has been relatively stable and reliable. This framework was developed\nto increase the ease of use and stability of using the iOS Bluetooth API.",
  "homepage": "https://github.com/bingerz/flip-ble-ios",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },

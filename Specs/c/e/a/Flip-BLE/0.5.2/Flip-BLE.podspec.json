    "tag": "0.5.2"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.5",
  "frameworks": "CoreBluetooth",
  "source_files": "Flip-BLE/Classes/**/*",
  "public_header_files": [

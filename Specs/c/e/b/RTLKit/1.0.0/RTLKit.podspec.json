{
  "name": "RTLKit",
  "version": "1.0.0",
  "summary": "RTL-safe text for Swift.",
  "description": "Keeps numbers, dates and other neutral text reading correctly inside\nright-to-left layout, and converts between Western, Arabic-Indic and\nPersian digits.",
  "homepage": "https://github.com/devMfawzy/RTLKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Mohamed Fawzy": "m.fawzy.a@icloud.com"
  },
  "source": {
    "git": "https://github.com/devMfawzy/RTLKit.git",
    "tag": "1.0.0"
  },
  "swift_versions": "5.9",
  "platforms": {
    "ios": "13.0",
    "osx": "10.15"
  },
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/RTLKit/**/*.swift"
    },
    {
      "name": "UI",
      "source_files": "Sources/RTLKitUI/**/*.swift",
      "dependencies": {
        "RTLKit/Core": [

        ]
      },
      "frameworks": "SwiftUI"
    }
  ],
  "swift_version": "5.9"
}

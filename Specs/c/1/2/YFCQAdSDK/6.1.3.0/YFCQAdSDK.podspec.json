{
  "name": "YFCQAdSDK",
  "version": "6.1.3.0",
  "summary": "CQAdSDK iOS advertising mediation SDK.",
  "description": "CQAdSDK provides iOS advertising mediation capabilities and wraps supported\nthird-party ad networks.",
  "homepage": "https://example.com",
  "license": {
    "type": "Proprietary",
    "text": "Copyright. All rights reserved."
  },
  "authors": {
    "Author": "example@example.com"
  },
  "source": {
    "git": "https://github.com/com-yifan/ios-yf-otheradns-adapter.git",
    "tag": "6.1.3.0"
  },
  "platforms": {
    "ios": "12.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "vendored_frameworks": [
    "IE/CQAdSDK.framework"
  ],
  "resources": [
    "IE/CQAdSDK.framework/cqadsdk.bundle",
    "IE/CQAdSDK.framework/Common_AdMoreSDK.bundle"
  ],
  "frameworks": [
    "AdSupport",
    "AppTrackingTransparency",
    "AudioToolbox",
    "AVFoundation",
    "CoreGraphics",
    "CoreLocation",
    "CoreMedia",
    "CoreMotion",
    "CoreTelephony",
    "Foundation",
    "ImageIO",
    "JavaScriptCore",
    "MobileCoreServices",
    "QuartzCore",
    "SafariServices",
    "Security",
    "StoreKit",
    "SystemConfiguration",
    "UIKit",
    "WebKit"
  ],
  "weak_frameworks": [
    "AdServices"
  ],
  "libraries": [
    "c++",
    "resolv",
    "sqlite3",
    "xml2",
    "z"
  ],
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  }
}

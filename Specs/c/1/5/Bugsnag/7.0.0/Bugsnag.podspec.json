{
  "name": "Bugsnag",
  "version": "7.0.0",
  "summary": "The Bugsnag crash reporting framework for Apple platforms.",
  "homepage": "https://bugsnag.com",
  "license": "MIT",
  "authors": {
    "Bugsnag": "notifiers@bugsnag.com"
  },
  "source": {
    "git": "https://github.com/bugsnag/bugsnag-cocoa.git",
    "tag": "v7.0.0"
  },
  "ios": {
    "frameworks": [
      "Foundation",
      "SystemConfiguration",
      "Security"
    ]
  },
  "osx": {
    "frameworks": [
      "Foundation",
      "SystemConfiguration",
      "Security"
    ]
  },
  "tvos": {
    "frameworks": [
      "Foundation",
      "SystemConfiguration",
      "Security"
    ]
  },
  "watchos": {
    "frameworks": [
      "Foundation",
      "Security"
    ]
  },
  "compiler_flags": [
    "-fvisibility=hidden"
  ],
  "libraries": [
    "c++",
    "z"
  ],
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0",
    "watchos": "9.0"
  },
  "source_files": [
    "Bugsnag/{**/,}*.{m,h,mm,c}"
  ],
  "resource_bundles": {
    "Bugsnag": [
      "Bugsnag/resources/PrivacyInfo.xcprivacy"
    ]
  },
  "requires_arc": true,
  "prefix_header_file": false,
  "public_header_files": [
    "Bugsnag/include/Bugsnag/*.h"
  ]
}

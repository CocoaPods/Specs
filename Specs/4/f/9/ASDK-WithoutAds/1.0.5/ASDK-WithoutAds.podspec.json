{
  "name": "ASDK-WithoutAds",
  "module_name": "asdk",
  "version": "1.0.5",
  "summary": "VGamePop iOS SDK (without ads)",
  "description": "No-ads variant of ASDK: initialization, login (incl. VK), payment,\nattribution, analytics, Facebook sharing, ATT and App Store review APIs.\nTopOn advertising code is compiled out, so hosts need none of the\nad-related Info.plist keys (GADApplicationIdentifier etc.) and pull no\nTPN pods. Version numbers stay locked with the ASDK pod.",
  "homepage": "https://github.com/mikezyc/asdk-ios-distribution",
  "license": {
    "type": "Commercial",
    "text": "Copyright VGamePop. All rights reserved."
  },
  "authors": "VGamePop",
  "source": {
    "http": "https://github.com/mikezyc/asdk-ios-distribution/releases/download/1.0.5/ASDK-WithoutAds-1.0.5.zip"
  },
  "platforms": {
    "ios": "14.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "static_framework": true,
  "vendored_frameworks": "without-ads/asdk.xcframework",
  "resource_bundles": {
    "ASDKResources": [
      "asdk/Resources/**/*",
      "asdk/Assets.xcassets"
    ]
  },
  "resources": "VKResources/*.bundle",
  "frameworks": [
    "AdSupport",
    "AppTrackingTransparency",
    "AuthenticationServices",
    "StoreKit",
    "WebKit"
  ],
  "libraries": [
    "c++",
    "resolv",
    "z"
  ],
  "dependencies": {
    "Adjust": [
      "5.8.0"
    ],
    "FirebaseAnalytics": [
      "11.15.0"
    ],
    "FirebaseCrashlytics": [
      "11.15.0"
    ],
    "GoogleSignIn": [
      "9.1.0"
    ],
    "FBSDKCoreKit": [
      "17.4.0"
    ],
    "FBSDKLoginKit": [
      "17.4.0"
    ],
    "FBSDKShareKit": [
      "17.4.0"
    ],
    "LineSDKSwift": [
      "5.16.1"
    ]
  },
  "swift_version": "5.0"
}

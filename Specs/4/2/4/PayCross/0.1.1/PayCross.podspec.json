{
  "name": "PayCross",
  "version": "0.1.1",
  "summary": "PayCross iOS payment SDK.",
  "description": "Drop-in card payment sheet: card entry, saved cards, 3D Secure v2 and status\npolling, presented from a view controller and resolving to a single result.",
  "homepage": "https://github.com/paycross/payment-ios-sdk",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": "PayCross",
  "source": {
    "git": "https://github.com/paycross/payment-ios-sdk.git",
    "tag": "v0.1.1"
  },
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": [
    "6.0"
  ],
  "pod_target_xcconfig": {
    "SWIFT_VERSION": "6.0",
    "OTHER_SWIFT_FLAGS": "-package-name PayCross"
  },
  "source_files": "Sources/PayCross/**/*.swift",
  "frameworks": [
    "UIKit",
    "SwiftUI",
    "WebKit"
  ],
  "resource_bundles": {
    "PayCrossPrivacy": [
      "Sources/PayCross/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "dependencies": {
    "PayCrossCore": [
      "0.1.1"
    ]
  },
  "swift_version": "6.0"
}

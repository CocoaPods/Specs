{
  "name": "VoxeraSDK",
  "version": "1.1.44",
  "summary": "Native iOS client for the Voxera realtime voice and video platform.",
  "description": "VoxeraSDK connects an iOS application to Voxera using Socket.IO,\nmediasoup, and a single shared WebRTC runtime.",
  "homepage": "https://github.com/voxera-voice/voxera-ios",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Voxera": "voicevoxera@gmail.com"
  },
  "source": {
    "git": "https://github.com/voxera-voice/voxera-ios.git",
    "tag": "1.1.44"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "static_framework": true,
  "module_name": "VoxeraSDK",
  "source_files": [
    "Sources/RocsSDK/**/*.swift",
    "Sources/VoxeraCocoaPods/**/*.swift",
    "mediasoup-client-swift/Sources/Mediasoup/**/*.swift"
  ],
  "dependencies": {
    "WebRTC-lib": [
      "= 149.0.0"
    ],
    "Socket.IO-Client-Swift": [
      "= 16.1.0"
    ],
    "Starscream": [
      "= 4.0.6"
    ]
  },
  "frameworks": [
    "AVFoundation",
    "AudioToolbox",
    "VideoToolbox"
  ],
  "pod_target_xcconfig": {
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES",
    "DEFINES_MODULE": "YES"
  },
  "swift_version": "5.9"
}

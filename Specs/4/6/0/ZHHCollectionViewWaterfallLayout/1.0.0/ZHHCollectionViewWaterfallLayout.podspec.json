{
  "name": "ZHHCollectionViewWaterfallLayout",
  "version": "1.0.0",
  "summary": "纯 Swift 瀑布流布局，基于 UICollectionViewLayout，支持多列与多分区。",
  "description": "ZHHCollectionViewWaterfallLayout 提供可配置的瀑布流布局：多列、多分区、Header / Footer、\n列间距与行间距、分区内边距，以及 shortestFirst / leftToRight / rightToLeft 填充方向。\n通过 ZHHCollectionViewDelegateWaterfallLayout 动态指定 item 尺寸与各分区列数。",
  "homepage": "https://github.com/yue5yueliang/ZHHCollectionViewWaterfallLayout",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "桃色三岁": "136769890@qq.com"
  },
  "source": {
    "git": "https://github.com/yue5yueliang/ZHHCollectionViewWaterfallLayout.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5.5"
  ],
  "frameworks": "UIKit",
  "resource_bundles": {
    "ZHHCollectionViewWaterfallLayout": [
      "ZHHCollectionViewWaterfallLayout/PrivacyInfo.xcprivacy"
    ]
  },
  "default_subspecs": "Source",
  "subspecs": [
    {
      "name": "Source",
      "source_files": "ZHHCollectionViewWaterfallLayout/Classes/**/*"
    }
  ],
  "swift_version": "5.5"
}

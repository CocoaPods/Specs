{
  "name": "ClomniMessenger",
  "version": "1.0.4",
  "summary": "Clomni Messenger for iOS apps: native chat, flow buttons and push replies.",
  "description": "Opens the Clomni Messenger inside your own iOS app. Your users write to your team in Clomni, the flows built for\nyour website chat run with native buttons, and operator replies arrive as push notifications.",
  "homepage": "https://clomni.ai",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": "Clomni",
  "source": {
    "git": "https://github.com/clomni/clomni-mobile-sdk.git",
    "tag": "1.0.4"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5.0"
  ],
  "cocoapods_version": ">= 1.12",
  "readme": "https://github.com/clomni/clomni-mobile-sdk/blob/1.0.4/README.md",
  "changelog": "https://github.com/clomni/clomni-mobile-sdk/blob/1.0.4/ios/CHANGELOG.md",
  "source_files": "ios/Sources/**/*.swift",
  "pod_target_xcconfig": {
    "OTHER_SWIFT_FLAGS": "$(inherited) -package-name ClomniMessenger",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-Osize"
  },
  "resource_bundles": {
    "ClomniMessenger_Privacy": [
      "ios/Sources/ClomniMessenger/PrivacyInfo.xcprivacy"
    ],
    "ClomniMessenger_Sounds": [
      "ios/Sources/ClomniMessenger/Sounds/*.mp3"
    ],
    "ClomniMessenger_Media": [
      "ios/Sources/ClomniMessenger/Media.xcassets"
    ]
  },
  "frameworks": [
    "Foundation",
    "Security",
    "UIKit",
    "SwiftUI",
    "PhotosUI",
    "UniformTypeIdentifiers",
    "UserNotifications",
    "AVFoundation",
    "Network"
  ],
  "swift_version": "5.0"
}

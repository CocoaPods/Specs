{
  "name": "LMUbiXAdapter",
  "version": "1.0.1",
  "summary": "LMUbiXAdapter - LitemobSDK 的 UbiX(UBidding) 适配器",
  "description": "LMUbiXAdapter 是 LitemobSDK 的第三方广告平台适配器，用于将 LitemobSDK 以自定义网络(UMTCustom* 协议)接入 UbiX(UBidding) 聚合 SDK，\n覆盖开屏 / 插屏 / 激励视频 / Banner / 原生(自渲染 + 模板)五类广告位。\n在 UbiX 后台自定义网络处配置的初始化类名：LMUbiXConfigAdapter。",
  "homepage": "https://hub.litemob.com/adsdk/ios-sdk",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Litemob": "sdk@litemob.com"
  },
  "source": {
    "git": "https://hub.litemob.com/adsdk/ios-sdk.git",
    "tag": "UbiXAdapter-v1.0.1"
  },
  "platforms": {
    "ios": "13.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "vendored_frameworks": "LMUbiXAdapter.xcframework",
  "preserve_paths": "LMUbiXAdapter.xcframework",
  "dependencies": {
    "LitemobAd": [
      "~> 1.4"
    ],
    "UBiddingAdSDK": [

    ],
    "UBiddingUBiXAdapter": [

    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit"
  ],
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  },
  "swift_versions": [
    "5"
  ],
  "swift_version": "5"
}

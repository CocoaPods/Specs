{
  "name": "Conferbot",
  "version": "2.0.0",
  "summary": "Native iOS SDK for Conferbot - AI-powered customer support chat",
  "description": "Conferbot iOS SDK enables seamless integration of AI-powered customer support chat\ninto your native iOS applications. Features include real-time messaging, live agent\nhandover, file uploads, push notifications, and full customization support.",
  "homepage": "https://conferbot.com",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": {
    "Conferbot": "support@conferbot.com"
  },
  "source": {
    "git": "https://github.com/Conferbot/conferbot-ios.git",
    "tag": "2.0.0"
  },
  "platforms": {
    "ios": "14.0"
  },
  "swift_versions": [
    "5.7",
    "5.8",
    "5.9"
  ],
  "source_files": "Sources/Conferbot/**/*.{swift,h,m}",
  "resource_bundles": {
    "Conferbot": [
      "Sources/Conferbot/Resources/i18n-strings.json"
    ]
  },
  "frameworks": [
    "UIKit",
    "Foundation",
    "Combine"
  ],
  "dependencies": {
    "Socket.IO-Client-Swift": [
      "~> 16.0"
    ]
  },
  "pod_target_xcconfig": {
    "SWIFT_VERSION": "5.7"
  },
  "swift_version": "5.9"
}

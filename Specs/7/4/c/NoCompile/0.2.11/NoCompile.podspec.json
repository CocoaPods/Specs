{
  "name": "NoCompile",
  "version": "0.2.11",
  "summary": "iOS / macOS 热重载客户端，支持 C、C++、Objective-C、Swift。",
  "description": "NoCompile 只重新编译改动的文件并注入运行中的 App。本 Pod 是 App 进程内的客户端，\n需配合 NoCompile.app（菜单栏 App）或 nocompile 命令行工具使用。",
  "homepage": "https://github.com/wangwanjie/NoCompile",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "wangwanjie": "https://github.com/wangwanjie"
  },
  "source": {
    "git": "https://github.com/wangwanjie/NoCompile.git",
    "tag": "v0.2.11"
  },
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0"
  },
  "source_files": "Sources/NoCompileClient/**/*.{h,m}",
  "public_header_files": "Sources/NoCompileClient/include/NoCompile.h",
  "requires_arc": true,
  "frameworks": "Foundation",
  "ios": {
    "frameworks": "UIKit"
  },
  "tvos": {
    "frameworks": "UIKit"
  },
  "osx": {
    "frameworks": "AppKit"
  },
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "$(inherited) \"${PODS_TARGET_SRCROOT}/Sources/NoCompileClient/include\""
  },
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -Xlinker -interposable"
  }
}

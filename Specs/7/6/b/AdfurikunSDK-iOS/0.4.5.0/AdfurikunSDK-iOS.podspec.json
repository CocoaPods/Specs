{
  "name": "AdfurikunSDK-iOS",
  "version": "0.4.5.0",
  "summary": "An iOS SDK for ADFURIKUN Movie Reward Ads",
  "homepage": "https://adfurikun.jp/adfurikun/",
  "license": {
    "type": "Copyright",
    "text": "Copyright GREE X, Inc. All rights reserved."
  },
  "authors": "GREE X, Inc.",
  "platforms": {
    "ios": "15.0"
  },
  "source": {
    "git": "https://github.com/glossom-dev/AdfurikunSDK-iOS",
    "tag": "0.4.5.0"
  },
  "resource_bundles": {
    "AdfurikunSDK-iOS_resources": [
      "PrivacyInfo.xcprivacy"
    ]
  },
  "default_subspecs": "All",
  "static_framework": true,
  "swift_versions": "5.0",
  "xcconfig": {
    "VALID_ARCHS": "armv7 armv7s x86_64 arm64"
  },
  "subspecs": [
    {
      "name": "Core",
      "vendored_frameworks": "**/ADFMovieReward.xcframework",
      "frameworks": [
        "AdSupport",
        "AVFoundation",
        "CoreGraphics",
        "CoreMedia",
        "CoreTelephony",
        "MediaPlayer",
        "StoreKit",
        "SystemConfiguration",
        "SafariServices",
        "UIKit",
        "WebKit"
      ],
      "libraries": "z",
      "pod_target_xcconfig": {
        "OTHER_LDFLAGS": [
          "-ObjC",
          "-fobjc-arc"
        ]
      }
    },
    {
      "name": "AdMob",
      "dependencies": {
        "AdfurikunSDK-iOS/Core": [

        ],
        "Google-Mobile-Ads-SDK": [
          ">=11.2.0"
        ]
      },
      "source_files": "**/adnetworks/AdMob/*.{h,m}",
      "resources": "**/adnetworks/AdMob/*.{txt,xib}"
    },
    {
      "name": "AdMobMediationAdapter",
      "dependencies": {
        "AdfurikunSDK-iOS/Core": [

        ],
        "Google-Mobile-Ads-SDK": [
          ">=11.2.0"
        ]
      },
      "source_files": "**/adnetworks/AdMobMediationAdapter/*.{h,m}"
    },
    {
      "name": "AdMobMediationAdapterUnity",
      "dependencies": {
        "AdfurikunSDK-iOS/Core": [

        ],
        "AdfurikunSDK-iOS/AdMobMediationAdapter": [

        ]
      },
      "source_files": "**/adnetworks/AdMobMediationAdapter/Unity/*.{h,m}"
    },
    {
      "name": "AdMobMediationAdapterFlutter",
      "dependencies": {
        "AdfurikunSDK-iOS/Core": [

        ],
        "AdfurikunSDK-iOS/AdMobMediationAdapter": [

        ]
      },
      "source_files": "**/adnetworks/AdMobMediationAdapter/Flutter/*.{h,m}"
    },
    {
      "name": "Afio",
      "dependencies": {
        "AdfurikunSDK-iOS/Core": [

        ],
        "AMoAd": [
          "<=6.3.0"
        ]
      },
      "source_files": "**/adnetworks/Afio/*.swift",
      "resources": "**/adnetworks/Afio/*.txt"
    },
    {

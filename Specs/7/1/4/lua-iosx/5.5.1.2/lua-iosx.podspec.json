{
  "name": "lua-iosx",
  "version": "5.5.1.2",
  "summary": "Lua XCFramework for macOS, iOS, watchOS, tvOS, and visionOS, including Mac Catalyst and simulators.",
  "homepage": "https://github.com/apotocki/lua-iosx",
  "license": "MIT",
  "authors": {
    "Alexander Pototskiy": "alex.a.potocki@gmail.com"
  },
  "social_media_url": "https://www.linkedin.com/in/alexander-pototskiy",
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0",
    "watchos": "11.0",
    "visionos": "1.0"
  },
  "ios": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "osx": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "tvos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "watchos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "visionos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "static_framework": true,
  "prepare_command": "sh scripts/build.sh",
  "source": {
    "git": "https://github.com/apotocki/lua-iosx.git",
    "tag": "5.5.1.2"
  },
  "header_mappings_dir": "frameworks/Headers",
  "public_header_files": "frameworks/Headers/**/*.{h,hpp}",
  "source_files": "frameworks/Headers/**/*.{h,hpp}",
  "vendored_frameworks": "frameworks/lua.xcframework"
}

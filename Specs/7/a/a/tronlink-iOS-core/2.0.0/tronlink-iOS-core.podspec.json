{
  "name": "tronlink-iOS-core",
  "version": "2.0.0",
  "summary": "tronlink-iOS-core is repo of TronLink",
  "module_name": "TLCore",
  "homepage": "https://github.com/TronLink/tronlink-iOS-core",
  "license": {
    "type": "Apache",
    "file": "LICENSE"
  },
  "authors": "tronlinkdev",
  "source": {
    "git": "https://github.com/TronLink/tronlink-iOS-core.git",
    "tag": "2.0.0"
  },
  "platforms": {
    "ios": "15.1"
  },
  "swift_versions": "4.2",
  "frameworks": "Security",
  "source_files": "tronlink-iOS-core/Classes/**/*.{h,m,c,swift}",
  "preserve_paths": [
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/*.table",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/LICENSE",
    "ThirdPartyLicenses/*"
  ],
  "module_map": "tronlink-iOS-core/TLCore.modulemap",
  "private_header_files": [
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/nem_serialize.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/bip39_english.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/blake2_common.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/check_mem.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/groestl_internal.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/aes/aesopt.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/aes/aestab.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/chacha20poly1305/ecrypt-machine.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/chacha20poly1305/ecrypt-portable.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/chacha20poly1305/poly1305-donna-32.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna/curve25519-donna-scalarmult-base.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna/ed25519-hash-custom.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna/ed25519-hash-custom-keccak.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna/ed25519-hash-custom-sha3.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna/ed25519-keccak.h",
    "tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna/ed25519-sha3.h"
  ],
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "$(inherited) \"$(PODS_TARGET_SRCROOT)/tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto\" \"$(PODS_TARGET_SRCROOT)/tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/aes\" \"$(PODS_TARGET_SRCROOT)/tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/chacha20poly1305\" \"$(PODS_TARGET_SRCROOT)/tronlink-iOS-core/Classes/ABI/TrezorCrypto/trezor-crypto/ed25519-donna\"",
    "OTHER_CFLAGS": "$(inherited) -O3",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Owholemodule"
  },
  "dependencies": {
    "gRPC": [
      "1.84.0"
    ],
    "Protobuf": [
      "5.36.2"
    ],
    "gRPC-Core": [
      "1.84.0"
    ],
    "gRPC-ProtoRPC": [
      "1.84.0"
    ],
    "gRPC-RxLibrary": [
      "1.84.0"
    ],
    "FMDB": [
      "2.7.12"
    ],
    "BigInt": [
      "5.2.0"
    ],
    "CryptoSwift": [
      "1.10.0"
    ]
  },
  "requires_arc": [
    "tronlink-iOS-core/Classes/gRPC/**/*.pbrpc.m",
    "tronlink-iOS-core/Classes/ABI/ObjectiveC/EthereumCrypto.m"
  ],
  "swift_version": "4.2"
}

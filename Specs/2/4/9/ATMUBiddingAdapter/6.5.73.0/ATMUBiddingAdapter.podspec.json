{
  "name": "ATMUBiddingAdapter",
  "version": "6.5.73.0",
  "summary": "AnyThinkiOS Custom ADN Adapter for UBiddingAdSDK",
  "homepage": "https://www.ubixai.com",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "zhugq": "guoqiang.zhu@ubixai.com"
  },
  "source": {
    "git": "https://gitee.com/ubixai/ubidding-ios-adapter-taku.git",
    "tag": "6.5.73.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "static_framework": true,
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  },
  "default_subspecs": [
    "Core",
    "Splash",
    "Interstitial",
    "RewardedVideo",
    "Banner",
    "Native"
  ],
  "subspecs": [
    {
      "name": "Core",
      "ios": {
        "source_files": "ATMUBiddingAdapter/Core/**/*.{h,m}",
        "public_header_files": "ATMUBiddingAdapter/Core/**/*.h"
      },
      "dependencies": {
        "AnyThinkiOS": [
          "6.5.73"
        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ],
        "UBiddingUBiXAdapter": [
          "2.12.0.0"
        ]
      },
      "pod_target_xcconfig": {
        "FRAMEWORK_SEARCH_PATHS": "$(inherited) $(PODS_ROOT)/UBiddingAdSDK/**",
        "HEADER_SEARCH_PATHS": "$(inherited) $(PODS_ROOT)/UBiddingAdSDK/**"
      }
    },
    {
      "name": "Splash",
      "ios": {
        "source_files": "ATMUBiddingAdapter/Splash/**/*.{h,m}",
        "public_header_files": "ATMUBiddingAdapter/Splash/**/*.h"
      },
      "dependencies": {
        "ATMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "Interstitial",
      "ios": {
        "source_files": "ATMUBiddingAdapter/Interstitial/**/*.{h,m}",
        "public_header_files": "ATMUBiddingAdapter/Interstitial/**/*.h"
      },
      "dependencies": {
        "ATMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "RewardedVideo",
      "ios": {
        "source_files": "ATMUBiddingAdapter/RewardedVideo/**/*.{h,m}",
        "public_header_files": "ATMUBiddingAdapter/RewardedVideo/**/*.h"
      },
      "dependencies": {
        "ATMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "Banner",
      "ios": {
        "source_files": "ATMUBiddingAdapter/Banner/**/*.{h,m}",
        "public_header_files": "ATMUBiddingAdapter/Banner/**/*.h"
      },
      "dependencies": {
        "ATMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    },
    {
      "name": "Native",
      "ios": {
        "source_files": "ATMUBiddingAdapter/Native/**/*.{h,m}",
        "public_header_files": "ATMUBiddingAdapter/Native/**/*.h"
      },
      "dependencies": {
        "ATMUBiddingAdapter/Core": [

        ],
        "UBiddingAdSDK": [
          "4.1.0"
        ]
      }
    }
  ]
}

{
  "name": "IFLYADLib",
  "version": "6.0.12",
  "summary": "IFLYADLib model A composable SDK distribution.",
  "homepage": "https://github.com/LJMcarryu/IFLYADLib_iOS",
  "authors": {
    "IFLY": "placeholder@example.com"
  },
  "source": {
    "http": "https://github.com/LJMcarryu/IFLYADLib_iOS/releases/download/6.0.12/IFLYADLib-modelA-6.0.12.zip"
  },
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "platforms": {
    "ios": "13.0"
  },
  "static_framework": true,
  "default_subspecs": "Full",
  "pod_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "subspecs": [
    {
      "name": "Core",
      "vendored_frameworks": "IFLYAdCore.xcframework",
      "resource_bundles": {
        "IFLYADLibCoreResources": [
          "resources/Core/**/*"
        ]
      }
    },
    {
      "name": "VideoUI",
      "dependencies": {
        "IFLYADLib/Core": [

        ]
      },
      "vendored_frameworks": "IFLYAdVideoUI.xcframework",
      "resource_bundles": {
        "IFLYADLibVideoUIResources": [
          "resources/VideoUI/**/*"
        ]
      }
    },
    {
      "name": "Banner",
      "dependencies": {
        "IFLYADLib/Core": [

        ]
      },
      "vendored_frameworks": "IFLYAdBanner.xcframework"
    },
    {
      "name": "NativeFeed",
      "dependencies": {
        "IFLYADLib/Core": [

        ]
      },
      "vendored_frameworks": "IFLYAdNativeFeed.xcframework"
    },
    {
      "name": "Splash",
      "dependencies": {
        "IFLYADLib/Core": [

        ],
        "IFLYADLib/VideoUI": [

        ]
      },
      "vendored_frameworks": "IFLYAdSplash.xcframework"
    },
    {
      "name": "Interstitial",
      "dependencies": {
        "IFLYADLib/Core": [

        ],
        "IFLYADLib/VideoUI": [

        ]
      },
      "vendored_frameworks": "IFLYAdInterstitial.xcframework"
    },
    {
      "name": "Reward",
      "dependencies": {
        "IFLYADLib/Core": [

        ],
        "IFLYADLib/VideoUI": [

        ]
      },
      "vendored_frameworks": "IFLYAdReward.xcframework",
      "resource_bundles": {
        "IFLYADLibRewardResources": [
          "resources/Reward/**/*"
        ]
      }
    },
    {
      "name": "Full",
      "dependencies": {
        "IFLYADLib/Banner": [

        ],
        "IFLYADLib/Splash": [

        ],
        "IFLYADLib/Interstitial": [

        ],
        "IFLYADLib/NativeFeed": [

        ],
        "IFLYADLib/Reward": [

        ]
      }
    }
  ]
}

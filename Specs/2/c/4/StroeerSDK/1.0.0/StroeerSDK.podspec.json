{
  "name": "StroeerSDK",
  "version": "1.0.0",
  "summary": "A lightweight SDK that helps publishers maximize ad revenue across mobile websites and apps.",
  "license": {
    "type": "Commercial",
    "file": "stroeer-sdk-1.0.0/StroeerSDK/LICENSE"
  },
  "description": "We provide publishers with a platform that maximizes ad monetization, ensuring every impression is optimized for top-tier revenue performance.",
  "homepage": "https://yieldlove.com/",
  "documentation_url": "https://stroeerdigitalgroup.atlassian.net/wiki/x/FgGyc",
  "authors": {
    "Stroeer Labs": "stroeerlabs@adscale.co.nz"
  },
  "source": {
    "http": "https://github.com/stroeersdk/iOS/releases/download/1.0.0/stroeer-sdk-1.0.0.zip"
  },
  "requires_arc": true,
  "platforms": {
    "ios": "15.0"
  },
  "static_framework": true,
  "swift_versions": "5.0",
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "vendored_frameworks": [
        "stroeer-sdk-1.0.0/StroeerSDK/Frameworks/StroeerSDK.xcframework"
      ],
      "resource_bundles": {
        "StroeerSDK": [
          "stroeer-sdk-1.0.0/StroeerSDK/Resources/Core/dashboard.html",
          "stroeer-sdk-1.0.0/StroeerSDK/Resources/Core/debuginfo.html",
          "stroeer-sdk-1.0.0/StroeerSDK/Resources/Core/PrivacyInfo.xcprivacy"
        ]
      },
      "dependencies": {
        "PrebidMobile": [
          "3.4.1"
        ],
        "Google-Mobile-Ads-SDK": [
          "13.7.0"
        ]
      }
    },
    {
      "name": "Consent",
      "vendored_frameworks": [
        "stroeer-sdk-1.0.0/StroeerSDK/Frameworks/StroeerSDK_Consent.xcframework"
      ],
      "resource_bundles": {
        "StroeerSDKConsent": [
          "stroeer-sdk-1.0.0/StroeerSDK/Resources/Consent/PrivacyInfo.xcprivacy"
        ]
      },
      "dependencies": {
        "StroeerSDK/Core": [

        ],
        "ConsentViewController": [
          "~>7.12"
        ]
      }
    }
  ],
  "swift_version": "5.0"
}

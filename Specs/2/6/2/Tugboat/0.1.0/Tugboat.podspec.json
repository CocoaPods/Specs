  "homepage": "https://github.com/blendto/tugboat-mobile-sdk",
  "license": {
    "type": "AGPL-3.0-only",
    "file": "LICENSE"
  },
  "authors": {
    "Tugboat": "dev@bijatech.com"
  },
  "source": {

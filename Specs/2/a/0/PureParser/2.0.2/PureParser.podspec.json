{
  "name": "PureParser",
  "version": "2.0.2",
  "summary": "PureParser is a localization tool with condition-based markup language written in C++ with C and Swift wrappers.",
  "description": "PureParser is a tool that was designed to simplify adopting localizable strings when many conditions can change how those strings should read.",
  "authors": {
    "bronenos": "stan@potemkin.me"
  },
  "homepage": "https://github.com/bronenos/pure-parser",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "source": {
    "git": "https://github.com/bronenos/pure-parser.git",
    "tag": "v2.0.2"
  },
  "source_files": [
    "cpp_src/*.hpp",
    "cpp_src/PureScanner.cpp",
    "cpp_src/PureParser.cpp",
    "c_wrapper/*.{hpp,h}",
    "c_wrapper/pure_parser.cpp",
    "swift_wrapper/PureParser.swift"
  ],
  "public_header_files": "c_wrapper/pure_parser.h",
  "private_header_files": "cpp_src/*.hpp",
  "libraries": "c++",
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
    "GCC_WARN_INHIBIT_ALL_WARNINGS": "YES"
  },
  "swift_versions": [
    "5"
  ],
  "platforms": {
    "ios": "12.0",
    "osx": "10.13",
    "watchos": "5.0",
    "tvos": "12.0"
  },
  "swift_version": "5"
}

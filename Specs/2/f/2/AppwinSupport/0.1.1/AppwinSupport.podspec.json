{
  "name": "AppwinSupport",
  "version": "0.1.1",
  "summary": "Appwin Support SDK - native iOS messenger, FAQ and conversations.",
  "description": "Support module of the Appwin SDK. Native SwiftUI screens, stores,\nrepositories and the `/sdk/support/v1/**` backend integration. Depends on\nAppwinCore for device identity and networking.",
  "homepage": "https://appwin.io",
  "license": {
    "type": "Proprietary",
    "text": "Copyright Appwin Studio"
  },
  "authors": {
    "Appwin": "lesignobles.studio@gmail.com"
  },
  "source": {
    "git": "https://github.com/appwin-dev/appwin-ios.git",
    "tag": "0.1.1"
  },
  "source_files": "Sources/AppwinSupport/**/*.swift",
  "resource_bundles": {
    "AppwinSupport": [
      "Sources/AppwinSupport/Resources/**/*"
    ]
  },
  "platforms": {
    "ios": "16.0"
  },
  "swift_versions": "6.0",
  "frameworks": [
    "Foundation",
    "UIKit",
    "SwiftUI"
  ],
  "dependencies": {
    "AppwinCore": [
      "0.1.1"
    ]
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "swift_version": "6.0"
}

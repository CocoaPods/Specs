  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "source": {
    "git": "https://github.com/media-net/bytes-packages.git",
    "tag": "v1.0.2"
  },
  "source_files": "Sources/BytesAdSourceMediaNet/*.swift",

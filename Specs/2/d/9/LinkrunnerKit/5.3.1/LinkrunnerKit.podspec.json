  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Linkrunner": "darshil@linkrunner.io"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "5.9",
  "source": {
    "git": "https://github.com/linkrunner-labs/linkrunner-ios.git",
    "tag": "5.3.1"
  },
  "source_files": "Sources/Linkrunner/**/*.swift",
  "resource_bundles": {
    "LinkrunnerKit_Privacy": [
      "Sources/Linkrunner/PrivacyInfo.xcprivacy"
    ]

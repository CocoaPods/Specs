    "paween": "paween@google.com",
    "aalexli": "aalexli@google.com",
    "Kris Kline": "kris.kline@oracle.com"
  },
  "source": {
    "git": "https://github.com/iziz/libPhoneNumber-iOS.git",
    "tag": "2.0.1"
  },
  "libraries": "sqlite3",
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "watchos": "9.0",
    "tvos": "15.0"
  },
  "requires_arc": true,

{
  "name": "TiRTC",
  "version": "2.4.1",
  "summary": "Real-time audio and video SDK for TiRTC Darwin clients",
  "description": "TiRTC SDK for real-time audio and video applications on iOS and macOS.",
  "homepage": "https://tange.ai/",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "allenfeng": "fengjun.dev@gmail.com"
  },
  "readme": "README.md",
  "source": {
    "http": "https://icam-media-cloud-user-public.oss-cn-shenzhen.aliyuncs.com/RAPID_RELEASE/TiRTC_Darwin/v2.4.1/TiRTC.pod.zip"
  },
  "swift_versions": "6.0",
  "platforms": {
    "ios": "13.0",
    "osx": "11.5"
  },
  "vendored_frameworks": [
    "TiRTC.xcframework",
    "WebRTC.xcframework"
  ],
  "preserve_paths": "metadata/*",
  "pod_target_xcconfig": {
    "LD_RUNPATH_SEARCH_PATHS": "$(inherited) @executable_path/Frameworks @loader_path/Frameworks"
  },
  "libraries": [
    "c++",
    "z"
  ],
  "frameworks": [
    "AVFoundation",
    "AudioToolbox",
    "CoreAudio",
    "CoreGraphics",
    "CoreMedia",
    "CoreVideo",
    "Foundation",
    "Photos",
    "QuartzCore",
    "Security",
    "SystemConfiguration",
    "VideoToolbox"
  ],
  "ios": {
    "frameworks": [
      "CFNetwork",
      "UIKit",
      "Metal",
      "MetalKit",
      "OpenGLES"
    ]
  },
  "osx": {
    "frameworks": [
      "AppKit"
    ]
  },
  "swift_version": "6.0"
}

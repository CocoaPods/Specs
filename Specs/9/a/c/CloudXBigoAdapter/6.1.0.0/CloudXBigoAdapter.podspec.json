{
  "name": "CloudXBigoAdapter",
  "version": "6.1.0.0",
  "summary": "CloudX BIGO Ads Adapter - Static Framework",
  "description": "BIGO Ads server-bidding adapter for CloudX iOS SDK - binary distribution. Supports Banner, MREC, Interstitial, and Rewarded ad formats.",
  "homepage": "https://github.com/cloudx-io/cloudx-ios",
  "license": {
    "type": "Business Source License 1.1"
  },
  "authors": {
    "CloudX": "support@cloudx.io"
  },
  "source": {
    "git": "https://github.com/cloudx-io/cloudx-ios.git",
    "tag": "adapter-bigo/6.1.0.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "vendored_frameworks": "adapter-bigo/CloudXBigoAdapter.xcframework",
  "dependencies": {
    "CloudXCore": [
      ">= 3.9.0"
    ],
    "BigoADS": [
      "= 6.1.0"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit"
  ],
  "requires_arc": true,
  "static_framework": true,
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "CLANG_ENABLE_MODULES": "YES"
  },
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "swift_versions": [
    "5.0",
    "5.1",
    "5.2",
    "5.3",
    "5.4",
    "5.5",
    "5.6",
    "5.7",
    "5.8",
    "5.9",
    "6.0",
    "6.1",
    "6.2"
  ],
  "swift_version": "6.2"
}

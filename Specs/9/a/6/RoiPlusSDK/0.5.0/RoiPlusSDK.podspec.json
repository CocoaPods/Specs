{
  "name": "RoiPlusSDK",
  "version": "0.5.0",
  "summary": "RoiPlusSDK iOS advertising SDK.",
  "description": "RoiPlusSDK is an Objective-C advertising SDK supporting multiple ad formats.",
  "homepage": "https://roiplus.ixiaochuan.cn",
  "license": {
    "type": "Copyright",
    "text": "Copyright © 2026 北京云出岫文化有限公司. All Rights Reserved."
  },
  "authors": {
    "xujiangtao": "xujiangtao2014@xiaochuankeji.cn",
    "liujiayin": "liujiayin2014@xiaochuankeji.cn"
  },
  "source": {
    "http": "https://roiplus.ixiaochuan.cn/RoiPlusSDK/iOS/0.5.0/RoiPlusSDK.xcframework.zip",
    "sha256": "f47303aaab9571e49daddeb234e4c2402a198db04a20c59c753e50689ec486ce"
  },
  "platforms": {
    "ios": "13.0"
  },
  "requires_arc": true,
  "module_name": "RoiPlusSDK",
  "static_framework": true,
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "$(inherited) -ObjC"
  },
  "vendored_frameworks": [
    "RoiPlusSDK.xcframework",
    "RoiPlusSDK/Classes/AdLoader/Adapter/FL/Framework/ROIPFLAdSaas.xcframework",
    "RoiPlusSDK/Classes/AdLoader/Adapter/FL/Framework/ROIPFLSDK.xcframework"
  ],
  "resource_bundles": {
    "RoiPlusSDKResources": [
      "RoiPlusSDK/Resources/ROIPAssets.xcassets"
    ]
  },
  "frameworks": [
    "Accelerate",
    "AVFoundation",
    "CoreGraphics",
    "CoreLocation",
    "CoreMedia",
    "CoreMotion",
    "CoreText",
    "ImageIO",
    "SafariServices",
    "StoreKit",
    "SystemConfiguration",
    "AdSupport",
    "CoreTelephony",
    "QuartzCore",
    "WebKit"
  ],
  "weak_frameworks": "AppTrackingTransparency",
  "libraries": [
    "sqlite3",
    "z"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) ROIP_ENABLE_ADAPTER_CSJ=0 ROIP_ENABLE_ADAPTER_FL=1"
  }
}

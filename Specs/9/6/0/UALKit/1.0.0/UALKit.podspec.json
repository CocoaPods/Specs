{
  "name": "UALKit",
  "version": "1.0.0",
  "summary": "Basic library for using Admob ads Copyright by AdForUs",
  "description": "It's iOS Public Framework",
  "homepage": "https://github.com/rnd-adforus",
  "license": "© Copyright AdForUs co.,LTD All Rights Reserved.",
  "authors": "rnd-adforus",
  "source": {
    "http": "https://nexus.adforus.com/repository/cubid_iOS/UAL/1.0.0/UALKit.xcframework.zip"
  },
  "platforms": {
    "ios": "14.0"
  },
  "swift_versions": "6.0",
  "static_framework": true,
  "default_subspecs": "Core",
  "resources": [
    "Frameworks/UALKit.xcframework/*/*.framework/*.bundle"

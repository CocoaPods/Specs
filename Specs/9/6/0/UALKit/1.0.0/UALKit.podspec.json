      "subspecs": [
        {
          "name": "Admob",
          "dependencies": {
            "UALKit/Core": [

            ],
            "GoogleMobileAdsMediationAppLovin": [
              ">=13.1.0",
              "<13.5.4.0"
            ]
          }
        }
      ]
    }
  ],
  "swift_version": "6.0"
}

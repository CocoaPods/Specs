{
  "name": "ZHHChatKeyboard",
  "version": "1.0.0",
  "summary": "纯 Swift 聊天输入栏：键盘 / 表情 / 扩展面板平滑切换。",
  "description": "ZHHChatKeyboard 提供与业务解耦的聊天底部输入能力：常驻 / 弹出输入条、\n标准与胶囊布局、表情图文互转、扩展面板，以及键盘 / 面板状态机防抖动。\n输入框为轻量 ChatInputTextView（占位、字数、表情插删）；面板与资源可配。",
  "homepage": "https://github.com/yue5yueliang/ZHHChatKeyboard",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "桃色三岁": "136769890@qq.com"
  },
  "source": {
    "git": "https://github.com/yue5yueliang/ZHHChatKeyboard.git",
    "tag": "1.0.0"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": [
    "5.5"
  ],
  "frameworks": [
    "UIKit",
    "Foundation"
  ],
  "resource_bundles": {
    "ZHHChatKeyboard": [
      "ZHHChatKeyboard/Assets/**/*",
      "ZHHChatKeyboard/PrivacyInfo.xcprivacy"
    ]
  },
  "default_subspecs": "Source",
  "subspecs": [
    {
      "name": "Source",
      "source_files": "ZHHChatKeyboard/Classes/**/*"
    }
  ],
  "swift_version": "5.5"
}

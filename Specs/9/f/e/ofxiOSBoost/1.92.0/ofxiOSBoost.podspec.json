  "homepage": "https://github.com/danoli3/ofxiOSBoost",
  "documentation_url": "https://github.com/danoli3/ofxiOSBoost/releases/tag/1.92.0",
  "license": {
    "type": "BSL-1.0",
    "file": "LICENSE_1_0.txt"
  },
  "authors": {
    "Danoli3": "danoli3@gmail.com"
  },
  "platforms": {
    "ios": "12.0"
  },
  "cocoapods_version": ">= 1.9",
  "requires_arc": false,
  "source": {
    "http": "https://github.com/danoli3/ofxiOSBoost/releases/download/1.92.0/ofxiOSBoost-1.92.0.tar.gz",
    "sha256": "c6d64b2c6651a20a55039468f02f041a43a0b8f388fee4387589b9be2c3e1712"

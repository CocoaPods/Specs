    "file": "LICENSE_1_0.txt"
  },
  "authors": {
    "Danoli3": "danoli3@gmail.com"
  },
  "platforms": {
    "ios": "12.0"
  },
  "cocoapods_version": ">= 1.9",
  "requires_arc": false,
  "source": {
    "http": "https://github.com/danoli3/ofxiOSBoost/releases/download/1.76.0/ofxiOSBoost-1.76.0.tar.gz",
    "sha256": "08818d47c17c54650c30fec9849c80e97734f23b6b57650bb44dc11426138ace"

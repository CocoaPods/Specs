{
  "name": "CXLogKit",
  "version": "0.0.2",
  "summary": "An iOS logging toolkit built on Tencent Mars Xlog.",
  "description": "CXLogKit wraps Tencent Mars Xlog for iOS and provides level control,\nfile retention, size limits, and gesture-triggered system log sharing.",
  "homepage": "https://github.com/lixq677/CXLogKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "lixq10": "lixq677@gmail.com"
  },
  "platforms": {
    "ios": "13.0"
  },
  "source": {
    "git": "https://github.com/lixq677/CXLogKit.git",
    "tag": "0.0.2"
  },
  "source_files": [
    "CXLogKit/*.{h,m,mm}",
    "CXLogKit/**/*.{h,m,mm}"
  ],
  "frameworks": [
    "SystemConfiguration",
    "CoreTelephony"
  ],
  "libraries": [
    "z",
    "resolv.9",
    "c++"
  ],
  "vendored_frameworks": "Vendor/mars.xcframework",
  "preserve_paths": "Vendor/Mars-LICENSE"
}

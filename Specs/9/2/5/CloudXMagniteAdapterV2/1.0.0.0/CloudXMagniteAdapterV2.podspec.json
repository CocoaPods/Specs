{
  "name": "CloudXMagniteAdapterV2",
  "version": "1.0.0.0",
  "summary": "CloudX Magnite Adapter (independent versioning) - Static Framework",
  "description": "Magnite adapter for CloudX iOS SDK - binary distribution. Supports Banner, MREC, Interstitial, and Rewarded formats via MagniteSDK. Independent-versioned successor to CloudXMagniteAdapter, which remains on the legacy unified version line.",
  "homepage": "https://github.com/cloudx-io/cloudx-ios",
  "license": {
    "type": "Business Source License 1.1"
  },
  "authors": {
    "CloudX": "support@cloudx.io"
  },
  "source": {
    "git": "https://github.com/cloudx-io/cloudx-ios.git",
    "tag": "adapter-magnite/1.0.0.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "vendored_frameworks": "adapter-magnite/CloudXMagniteAdapterV2.xcframework",
  "dependencies": {
    "CloudXCore": [
      ">= 3.5.0"
    ],
    "MagniteSDK": [
      "= 1.0.0"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit",
    "WebKit",
    "AVFoundation",
    "CoreMedia",
    "CoreGraphics",
    "CoreTelephony",
    "SystemConfiguration",
    "StoreKit",
    "AdSupport",
    "JavaScriptCore",
    "QuartzCore",
    "CoreFoundation",
    "CoreAudio"
  ],
  "weak_frameworks": [
    "AppTrackingTransparency"
  ],
  "requires_arc": true,
  "static_framework": true,
  "pod_target_xcconfig": {
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "swift_versions": "6.0",
  "swift_version": "6.0"
}

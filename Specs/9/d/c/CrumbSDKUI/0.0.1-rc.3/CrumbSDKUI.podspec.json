{
  "name": "CrumbSDKUI",
  "version": "0.0.1-rc.3",
  "summary": "The native, on-demand issue reporter interface for Crumb",
  "description": "Crumb's UIKit reporter, foreground shake lifecycle, screenshot masking, and\nreport-time diagnostics. It stays idle until the reporter is invoked.",
  "homepage": "https://github.com/alexander126/crumb",
  "license": {
    "type": "Apache-2.0",
    "file": "LICENSE"
  },
  "authors": "Crumb contributors",
  "source": {
    "git": "https://github.com/alexander126/crumb.git",
    "tag": "0.0.1-rc.3"
  },
  "platforms": {
    "ios": "15.0"
  },
  "swift_versions": "6.0",
  "module_name": "CrumbUI",
  "source_files": "packages/ios/Sources/CrumbUI/**/*.swift",
  "resource_bundles": {
    "CrumbUI": "packages/ios/Sources/CrumbUI/Resources/**/*"
  },
  "dependencies": {
    "CrumbSDKCore": [
      "0.0.1-rc.3"
    ]
  },
  "frameworks": [
    "CoreMotion",
    "CoreTelephony",
    "CryptoKit",
    "Network",
    "OSLog",
    "UIKit"
  ],
  "pod_target_xcconfig": {
    "OTHER_SWIFT_FLAGS": "$(inherited) -package-name Crumb"
  },
  "swift_version": "6.0"
}

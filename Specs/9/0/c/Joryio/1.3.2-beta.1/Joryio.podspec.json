{
  "name": "Joryio",
  "version": "1.3.2-beta.1",
  "summary": "Joryio iOS SDK - identify, track, push, and in-app messaging.",
  "description": "Official Joryio SDK for iOS: user identification, event tracking with\noffline batching, push notifications (APNS), in-app messaging, and\ne-commerce tracking helpers.",
  "homepage": "https://joryio.com",
  "license": {
    "type": "Commercial",
    "file": "LICENSE"
  },
  "authors": {
    "Joryio": "support@joryio.com"
  },
  "source": {
    "git": "https://github.com/joryio/joryio-ios-sdk.git",
    "tag": "1.3.2-beta.1"
  },
  "platforms": {
    "ios": "14.0"
  },
  "swift_versions": "5.9",
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/Joryio/**/*.swift",
      "resource_bundles": {
        "Joryio_Privacy": [
          "Sources/Joryio/PrivacyInfo.xcprivacy"
        ]
      },
      "dependencies": {
        "SQLite.swift": [
          "~> 0.15"
        ]
      }
    },
    {
      "name": "UI",
      "source_files": "Sources/JoryioUI/**/*.swift",
      "dependencies": {
        "Joryio/Core": [

        ]
      }
    },
    {
      "name": "NotificationServiceExtension",
      "source_files": "Sources/JoryioNotificationServiceExtension/**/*.swift"
    }
  ],
  "swift_version": "5.9"
}

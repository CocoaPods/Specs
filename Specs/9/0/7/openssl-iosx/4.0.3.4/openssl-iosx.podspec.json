{
  "name": "openssl-iosx",
  "version": "4.0.3.4",
  "summary": "OpenSSL XCFrameworks for macOS, iOS, watchOS, tvOS, and visionOS, including Mac Catalyst and simulators.",
  "description": "OpenSSL XCFrameworks for macOS, iOS, watchOS, tvOS, and visionOS, including Mac Catalyst and simulators. New versions are published to the apotocki/cocoapods-specs spec repo (https://github.com/apotocki/cocoapods-specs), because CocoaPods Trunk becomes read-only on December 2, 2026: add :source => 'https://github.com/apotocki/cocoapods-specs.git' to the pod in your Podfile.",
  "homepage": "https://github.com/apotocki/openssl-iosx",
  "license": "Apache",
  "authors": {
    "Alexander Pototskiy": "alex.a.potocki@gmail.com"
  },
  "social_media_url": "https://www.linkedin.com/in/alexander-pototskiy",
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0",
    "watchos": "11.0",
    "visionos": "1.0"
  },
  "ios": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "osx": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "tvos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "watchos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "visionos": {
    "pod_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    },
    "user_target_xcconfig": {
      "ONLY_ACTIVE_ARCH": "YES"
    }
  },
  "static_framework": true,
  "prepare_command": "sh scripts/build.sh",
  "source": {
    "git": "https://github.com/apotocki/openssl-iosx.git",
    "tag": "4.0.3.4"
  },
  "header_mappings_dir": "frameworks/Headers",
  "public_header_files": "frameworks/Headers/**/*.{h,H,c}",
  "source_files": "frameworks/Headers/**/*.{h,H,c}",
  "vendored_frameworks": [
    "frameworks/ssl.xcframework",
    "frameworks/crypto.xcframework",
    "frameworks/apps.xcframework"
  ]
}

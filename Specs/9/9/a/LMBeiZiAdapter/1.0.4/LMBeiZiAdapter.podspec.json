{
  "name": "LMBeiZiAdapter",
  "version": "1.0.4",
  "summary": "LMBeiZiAdapter - LitemobSDK 的 BeiZi 适配器",
  "description": "LMBeiZiAdapter 是 LitemobSDK 的第三方广告平台适配器，用于将 LitemobSDK 接入到 BeiZi SDK。",
  "homepage": "https://hub.litemob.com/adsdk/ios-sdk",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "Litemob": "sdk@litemob.com"
  },
  "source": {
    "git": "https://hub.litemob.com/adsdk/ios-sdk.git",
    "tag": "BeiZiAdapter-v1.0.4"
  },
  "platforms": {
    "ios": "12.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "source_files": "LMBeiZiAdapter/**/*.{h,m}",
  "public_header_files": "LMBeiZiAdapter/**/*.h",
  "dependencies": {
    "LitemobAd": [
      "1.4.6"
    ],
    "AMPSAdSDK": [
      "~> 5.1.2.0"
    ]
  },
  "frameworks": [
    "Foundation",
    "UIKit"
  ],
  "pod_target_xcconfig": {
    "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
  }
}

{
  "name": "KpqC",
  "version": "0.1.0",
  "summary": "Swift APIs for AIMer, HAETAE, NTRU+, and SMAUG-T.",
  "description": "Synchronous Swift bindings for the bundled AIMer and HAETAE signature\nschemes and NTRU+ and SMAUG-T key-encapsulation mechanisms.",
  "homepage": "https://github.com/osuolfou/kpqc-swift",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "osuolfou": "osuolfou@naver.com"
  },
  "source": {
    "git": "https://github.com/osuolfou/kpqc-swift.git",
    "tag": "v0.1.0"
  },
  "module_name": "KpqC",
  "swift_versions": [
    "5.8"
  ],
  "platforms": {
    "ios": "15.0",
    "osx": "12.0",
    "tvos": "15.0",
    "watchos": "9.0"
  },
  "source_files": [
    "Sources/KpqC/**/*.swift",
    "Sources/KpqCCore/Generated/**/*.c",
    "native/csrc/secure_zero.c",
    "Sources/KpqCCore/include/KpqCCore.h"
  ],
  "public_header_files": "Sources/KpqCCore/include/KpqCCore.h",
  "preserve_paths": [
    "Sources/KpqCCore/Generated/**/*.h",
    "native/csrc/*",
    "THIRD_PARTY_NOTICES.md",
    "scripts/generate_native_sources.rb",
    "vendor/**/*"
  ],
  "compiler_flags": "-O2 -fvisibility=hidden -fno-strict-aliasing -w",
  "pod_target_xcconfig": {
    "CLANG_C_LANGUAGE_STANDARD": "c11",
    "HEADER_SEARCH_PATHS": "$(inherited) \"$(PODS_TARGET_SRCROOT)\""
  },
  "testspecs": [
    {
      "name": "Tests",
      "test_type": "unit",
      "platforms": {
        "ios": "15.0",
        "osx": "12.0",
        "tvos": "15.0"
      },
      "source_files": "Tests/KpqCTests/*.swift"
    }
  ],
  "swift_version": "5.8"
}

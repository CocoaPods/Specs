  "homepage": "https://www.advlion.com",
  "license": {
    "type": "MIT",
    "text": "Copyright (c) Menta. All rights reserved."
  },
  "authors": {
    "Menta": "mentasdk.vip@gmail.com"
  },
  "platforms": {
    "ios": "12.0"
  },
  "requires_arc": true,
  "static_framework": true,
  "source": {
    "git": "https://github.com/mentasdk/googleads-mobile-ios-mediation.git",
    "tag": "1.0.34"
  },
  "source_files": [
    "AdMobMentaAdapter/*.{h,m}",
    "adapters/Menta/AdMobMentaAdapter/*.{h,m}"

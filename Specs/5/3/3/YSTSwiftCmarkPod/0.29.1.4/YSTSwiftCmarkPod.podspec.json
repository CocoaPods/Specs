{
  "name": "YSTSwiftCmarkPod",
  "version": "0.29.1.4",
  "summary": "A CocoaPods wrapper for the cmark-gfm library.",
  "description": "This pod provides the cmark-gfm library, including both the core parser and GFM extensions, for use in iOS, macOS, and other Apple platforms.",
  "homepage": "https://github.com/taojeff/YSTSwiftCmarkPod",
  "license": {
    "type": "BSD-2-Clause",
    "file": "COPYING"
  },
  "authors": {
    "taojeff": "https://github.com/taojeff"
  },
  "source": {
    "git": "https://github.com/taojeff/YSTSwiftCmarkPod.git",
    "tag": "0.29.1.4"
  },
  "platforms": {
    "ios": "12.0"
  },
  "module_name": "swift_cmark_pod",
  "default_subspecs": [
    "cmark_gfm",
    "cmark_gfm_extensions"
  ],
  "subspecs": [
    {
      "name": "cmark_gfm",
      "source_files": "src/**/*.{h,c}",
      "preserve_paths": "src/**/*",
      "public_header_files": "src/include/*.h",
      "pod_target_xcconfig": {
        "DEFINES_MODULE": "YES",
        "CLANG_ENABLE_MODULES": "YES",
        "USE_HEADERMAP": "NO",
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)/src/include\" \"$(PODS_TARGET_SRCROOT)/src\" \"$(PODS_TARGET_SRCROOT)/extensions/include\" \"$(PODS_TARGET_SRCROOT)/extensions\"",
        "USER_HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)/src/include\" \"$(PODS_TARGET_SRCROOT)/src\" \"$(PODS_TARGET_SRCROOT)/extensions/include\" \"$(PODS_TARGET_SRCROOT)/extensions\"",
        "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) CMARK_GFM=1 CMARK_GFM_STATIC_DEFINE=1",
        "OTHER_CFLAGS": "$(inherited) -include $(PODS_TARGET_SRCROOT)/src/include/cmark-gfm.h",
        "MODULEMAP_FILE": "$(PODS_TARGET_SRCROOT)/src/include/module.modulemap"
      }
    },
    {
      "name": "cmark_gfm_extensions",
      "dependencies": {
        "YSTSwiftCmarkPod/cmark_gfm": [

        ]
      },
      "source_files": "extensions/**/*.{h,c}",
      "preserve_paths": "extensions/**/*",
      "public_header_files": [
        "extensions/include/cmark-gfm-core-extensions.h",
        "extensions/include/emoji.h",
        "extensions/include/math_mark.h"
      ],
      "pod_target_xcconfig": {
        "DEFINES_MODULE": "YES",
        "CLANG_ENABLE_MODULES": "YES",
        "USE_HEADERMAP": "NO",
        "ALWAYS_SEARCH_USER_PATHS": "NO",
        "HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)/src/include\" \"$(PODS_TARGET_SRCROOT)/src\" \"$(PODS_TARGET_SRCROOT)/extensions/include\" \"$(PODS_TARGET_SRCROOT)/extensions\"",
        "USER_HEADER_SEARCH_PATHS": "\"$(PODS_TARGET_SRCROOT)/src/include\" \"$(PODS_TARGET_SRCROOT)/src\" \"$(PODS_TARGET_SRCROOT)/extensions/include\" \"$(PODS_TARGET_SRCROOT)/extensions\"",
        "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) CMARK_GFM=1 CMARK_GFM_STATIC_DEFINE=1",
        "OTHER_CFLAGS": "$(inherited) -include $(PODS_TARGET_SRCROOT)/src/include/cmark-gfm.h"
      }
    }
  ]
}

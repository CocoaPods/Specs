{
  "name": "TradPlusMediationAdMaster",
  "version": "2.1.0.0",
  "summary": "TradPlus Mediation Adapter for AdMaster SDK",
  "description": "TradPlus Mediation Adapter for AdMaster SDK. Enables AdMaster ads through TradPlus custom SDK networks\n(Splash, Banner, Interstitial, Rewarded Video, Native Self-Render) with both Waterfall and C2S Header Bidding support.",
  "homepage": "https://github.com/AdMasterDev/AdMasterSDK-iOS",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "AdMasterDev": "dev0.admaster@gmail.com"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": "5.0",
  "source": {
    "git": "https://github.com/AdMasterDev/AdMasterSDK-iOS.git",
    "tag": "2.1.0.0"
  },
  "source_files": "Mediation/TradPlus/**/*.{h,m}",
  "public_header_files": "Mediation/TradPlus/*.h",
  "static_framework": true,
  "dependencies": {
    "TradPlusAdSDK": [
      ">= 15.7.0"
    ],
    "AdMasterSDK": [
      ">= 2.1.0"
    ]
  },
  "frameworks": [
    "AdSupport",
    "AppTrackingTransparency",
    "AVFoundation",
    "CoreGraphics",
    "CoreLocation",
    "CoreMotion",
    "CoreTelephony",
    "QuartzCore",
    "SystemConfiguration",
    "SafariServices",
    "StoreKit",
    "WebKit"
  ],
  "libraries": "c++",
  "user_target_xcconfig": {
    "OTHER_LDFLAGS": "-ObjC"
  },
  "swift_version": "5.0"
}

{
  "name": "YWFLanuchAdvert",
  "version": "0.1.0",
  "summary": "启屏广告 SDK，固定 JSON 布局，素材 zip 支持断点续传。",
  "description": "YWFLanuchAdvert 是 iOS 启屏广告 SDK。宿主配置域名后即可拉取广告。\n布局使用固定 JSON，支持坐标、线性、停靠三种方式，以及图片、按钮和 HTML。\n素材 zip 通过 HTTP Range 断点续传，下载完成且处于投放时段才展示。\n展示时长为整数，只有剩余时间等于 0 时才询问 delegate 是否跳转。",
  "homepage": "https://github.com/codergame/YWFLanuchAdvert",
  "license": {
    "type": "MIT",
    "file": "ios/LICENSE"
  },
  "authors": {
    "YWF": "dev@ywf.local"
  },
  "source": {
    "git": "https://github.com/codergame/YWFLanuchAdvert.git",
    "tag": "0.1.0"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.0",
  "source_files": "ios/YWFLanuchAdvert/**/*.{swift,c,h}",
  "public_header_files": "ios/YWFLanuchAdvert/Support/ywf_inflate.h",
  "libraries": "z",
  "frameworks": [
    "UIKit",
    "WebKit"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "swift_version": "5.0"
}

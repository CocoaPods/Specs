{
  "name": "Wisp",
  "version": "0.1.1",
  "summary": "A lightweight, commercial-grade Toast / HUD library for iOS.",
  "description": "Wisp shows text toasts, icon toasts (success/error/warning/info), loading HUDs,\nprogress indicators, snackbars with actions, and fully custom views — with\nqueueing, theming, accessibility, and an async/await API.",
  "homepage": "https://github.com/LUCK-YXH/Wisp",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "LUCK-YXH": "yuxuhui@heyhru.com"
  },
  "source": {
    "git": "https://github.com/LUCK-YXH/Wisp.git",
    "tag": "0.1.1"
  },
  "platforms": {
    "ios": "13.0"
  },
  "swift_versions": "5.5",
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": "Sources/Wisp/**/*.swift",
      "exclude_files": "Sources/Wisp/Loading/**/*.swift",
      "dependencies": {
        "SnapKit": [

        ]
      },
      "testspecs": [
        {
          "name": "Tests",
          "test_type": "unit",
          "source_files": "Tests/WispTests/**/*.swift"
        }
      ]
    },
    {
      "name": "Loading",
      "source_files": "Sources/Wisp/Loading/**/*.swift",
      "dependencies": {
        "Wisp/Core": [

        ],
        "lottie-ios": [

        ]
      },
      "testspecs": [
        {
          "name": "Tests",
          "test_type": "unit",
          "source_files": "Tests/WispLoadingTests/**/*.swift"
        }
      ]
    }
  ],
  "swift_version": "5.5"
}

{
  "name": "HyperProxyCore",
  "version": "0.3.0",
  "summary": "Provider-neutral secure AI API transport for Swift.",
  "homepage": "https://github.com/Tsvihun/HyperProxySwift",
  "license": {
    "type": "MIT"
  },
  "authors": {
    "HyperProxy": "contact@hyperproxyai.com"
  },
  "source": {
    "git": "https://github.com/Tsvihun/HyperProxySwift.git",
    "tag": "0.3.0"
  },
  "swift_versions": "6.0",
  "cocoapods_version": ">= 1.16.0",
  "platforms": {
    "ios": "15.0",
    "osx": "13.0"
  },
  "source_files": "Sources/HyperProxyCore/**/*.swift",
  "resource_bundles": {
    "HyperProxyCore_Privacy": [
      "Sources/HyperProxyCore/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "OTHER_SWIFT_FLAGS": "$(inherited) -enable-upcoming-feature NonisolatedNonsendingByDefault"
  },
  "swift_version": "6.0"
}
